; Read one colour choice
;
; HL = colour variable. 0-7 set it, 8 leaves it, D restores the defaults, any
; other key ends the command.
@label=GetColourKey
c$6B97 PUSH HL       ;
*$6B98 CALL $675A    ;
 $6B9B CP $44        ;
 $6B9D JR NZ,$6BA7   ;
 $6B9F CALL $6BBA    ;
 $6BA2 CALL $70DF    ;
 $6BA5 JR $6B98      ;
*$6BA7 SUB $10       ;
 $6BA9 JP M,$60B7    ;
 $6BAC CP $09        ;
 $6BAE JP P,$60B7    ;
 $6BB1 POP HL        ;
 $6BB2 CP $08        ;
 $6BB4 RET Z         ;
 $6BB5 LD (HL),A     ;
 $6BB6 CALL $70DF    ;
 $6BB9 RET           ;

; Default colour scheme
;
; Black pieces ink 0, white pieces ink 7, black squares paper 4, white squares
; paper 6.
@label=DefaultColours
c$6BBA LD A,$00      ;
 $6BBC LD ($BCD7),A  ;
 $6BBF LD A,$07      ;
 $6BC1 LD ($BCD8),A  ;
 $6BC4 LD A,$04      ;
 $6BC6 LD ($BCD9),A  ;
 $6BC9 LD A,$06      ;
 $6BCB LD ($BCDA),A  ;
 $6BCE RET           ;

; T: save or load the game record
;
; Save: writes $C000 to the end of the record ($FF) as a headerless block
; ($C000 is set to $FF as a marker). Load: reads up to $1F00 bytes to $E000,
; checks the markers and copies them to $C000, then replays the game.
@label=KeyTape
c$6BCF CALL $704D                                                        ;
 $6BD2 CALL $740E                                                        ;
 $6BD5 DEFM "COMMAND"                                                    ;
 $6BDC DEFB $BF                                                          ; Last
                                                                         ; character
                                                                         ; (bit 7
                                                                         ; set)
 $6BDD CALL $7405                                                        ;
 $6BE0 DEFM "Save-record         Load-record     -any other key to exit" ;
 $6C1A DEFB $AD                                                          ; Last
                                                                         ; character
                                                                         ; (bit 7
                                                                         ; set)
 $6C1B CALL $6FEF                                                        ;
 $6C1E CALL $675A                                                        ;
 $6C21 CP $53                                                            ;
 $6C23 JR NZ,$6C8D                                                       ;
 $6C25 LD A,($C058)                                                      ;
 $6C28 INC A                                                             ;
 $6C29 JP Z,$60B7                                                        ;
 $6C2C CALL $740E                                                        ;
 $6C2F DEFM "START TAP"                                                  ;
 $6C38 DEFB $C5                                                          ; Last
                                                                         ; character
                                                                         ; (bit 7
                                                                         ; set)
 $6C39 CALL $7405                                                        ;
 $6C3C DEFM "--Hit any key to initiate save-"                            ;
 $6C5B DEFB $AD                                                          ; Last
                                                                         ; character
                                                                         ; (bit 7
                                                                         ; set)
 $6C5C CALL $6FEF                                                        ;
 $6C5F CALL $675A                                                        ;
 $6C62 CALL $740E                                                        ;
 $6C65 DEFM "SAVING..."                                                  ;
 $6C6E DEFB $A0                                                          ; Last
                                                                         ; character
                                                                         ; (bit 7
                                                                         ; set)
 $6C6F CALL $73D4                                                        ;
 $6C72 LD DE,$0058                                                       ;
 $6C75 LD HL,$C058                                                       ;
*$6C78 INC DE                                                            ;
 $6C79 LD A,(HL)                                                         ;
 $6C7A INC HL                                                            ;
 $6C7B INC A                                                             ;
 $6C7C JR NZ,$6C78                                                       ;
 $6C7E LD IX,$C000                                                       ;
 $6C82 LD A,$FF                                                          ;
 $6C84 LD ($C000),A                                                      ;
 $6C87 CALL $6D0F                                                        ;
 $6C8A JP $60B7                                                          ;
*$6C8D CP $4C                                                            ;
 $6C8F JP NZ,$60B7                                                       ;
 $6C92 CALL $740E                                                        ;
 $6C95 DEFM "LOADING.."                                                  ;
 $6C9E DEFB $AE                                                          ; Last
                                                                         ; character
                                                                         ; (bit 7
                                                                         ; set)
 $6C9F CALL $73D4                                                        ;
 $6CA2 LD DE,$1F00                                                       ;
 $6CA5 SCF                                                               ;
 $6CA6 LD IX,$E000                                                       ;
 $6CAA LD A,$FF                                                          ;
 $6CAC CALL $6D16                                                        ;
 $6CAF JR NC,$6D0C                                                       ;
 $6CB1 LD HL,$E058                                                       ;
 $6CB4 OR A                                                              ;
 $6CB5 PUSH IX                                                           ;
 $6CB7 POP BC                                                            ;
 $6CB8 SBC HL,BC                                                         ;
 $6CBA LD A,H                                                            ;
 $6CBB OR A                                                              ;
 $6CBC JP P,$6CF4                                                        ;
 $6CBF LD A,(IX-$02)                                                     ;
 $6CC2 INC A                                                             ;
 $6CC3 JR NZ,$6CF4                                                       ;
 $6CC5 LD A,($E000)                                                      ;
 $6CC8 INC A                                                             ;
 $6CC9 JR NZ,$6CF4                                                       ;
 $6CCB LD HL,$C000                                                       ;
 $6CCE LD DE,$E000                                                       ;
 $6CD1 LD BC,$1F00                                                       ;
*$6CD4 LD A,(DE)                                                         ;
 $6CD5 LD (HL),A                                                         ;
 $6CD6 INC DE                                                            ;
 $6CD7 INC HL                                                            ;
 $6CD8 DEC BC                                                            ;
 $6CD9 LD A,B                                                            ;
 $6CDA OR C                                                              ;
 $6CDB JR NZ,$6CD4                                                       ;
