; Output a move
;
; From-square, '-' or 'x' (capture flag, bit 3 of IX+3), to-square, '/' and the
; promotion piece if $BCDE is set, '+' if bit 7 of IX+3 (check) is set.
@label=FormatMove
c$749F LD A,(IX+$01)  ;
 $74A2 CALL $74FB     ;
