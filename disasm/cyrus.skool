; Piece graphics
;
; 22 characters ($90-$A5) of 8 bytes: pawn $90-$93, knight $94-$97, bishop
; $98-$9B, rook $9C-$9F, queen $A0-$A3, king top $A4-$A5 (it shares the queen's
; bottom half).
@label=PieceGraphics
b$75CC DEFB $00,$00,$00,$00,$01,$03,$03,$01
 $75D4 DEFB $00,$00,$00,$00,$80,$C0,$C0,$80
 $75DC DEFB $03,$01,$01,$01,$03,$07,$00,$00
 $75E4 DEFB $C0,$80,$80,$80,$C0,$E0,$00,$00
 $75EC DEFB $00,$00,$01,$03,$06,$0F,$1F,$1E
 $75F4 DEFB $00,$00,$40,$E0,$F0,$F0,$F0,$F0
 $75FC DEFB $0D,$01,$03,$03,$07,$07,$00,$00
 $7604 DEFB $F0,$F8,$F8,$F8,$F8,$F8,$00,$00
 $760C DEFB $00,$00,$01,$03,$06,$0E,$18,$18
 $7614 DEFB $00,$00,$80,$C0,$60,$70,$18,$18
 $761C DEFB $0E,$06,$03,$01,$1D,$37,$00,$00
 $7624 DEFB $70,$60,$C0,$80,$B8,$EC,$00,$00
 $762C DEFB $00,$00,$00,$00,$0A,$0F,$07,$03
 $7634 DEFB $00,$00,$00,$00,$50,$F0,$E0,$C0
 $763C DEFB $03,$03,$03,$07,$0F,$1F,$00,$00
 $7644 DEFB $C0,$C0,$C0,$E0,$F0,$F8,$00,$00
 $764C DEFB $00,$00,$04,$0E,$24,$74,$24,$3F
 $7654 DEFB $00,$00,$20,$70,$24,$2E,$24,$FC
 $765C DEFB $3F,$3F,$10,$1F,$08,$0F,$00,$00
 $7664 DEFB $FC,$FC,$08,$F8,$10,$F0,$00,$00
 $766C DEFB $00,$00,$01,$01,$07,$37,$31,$3D
 $7674 DEFB $00,$00,$80,$80,$E0,$EC,$8C,$BC

; Unused
s$767C DEFS $0184

; Knight move offsets
;
; 0x88 offsets used by the move generator: +14, +18, +31, +33, -14, -18, -31,
; -33.
@label=KnightOffsets
b$7800 DEFB $0E,$12,$1F,$21,$F2,$EE,$E1,$DF

; Diagonal and orthogonal direction offsets
;
; $7808: diagonals +15, +17, -17, -15; $780C: orthogonals +1, -1, +16, -16.
; King and queen use all eight from $7808; bishops $7808-$780B; rooks
; $780C-$780F.
@label=DiagonalOffsets
b$7808 DEFB $0F,$11,$EF,$F1
@label=OrthogonalOffsets
 $780C DEFB $01,$FF,$10,$F0

; Pre-search set-up: evaluation, material balance and game-phase flags
;
; Called once before each computer search (from #R$7BE1 and #R$6D4D). Evaluates
; the current position with the side-to-move bit temporarily flipped, then
; derives $BD1E (score bias), $BD4A (accumulator), $BD2E (material difference
; x8, clamped) and the game-phase bits 1-4 of $BD2D. Bit 0 of $BD2D is left as
; it was on entry.
;
; O:A Result of the evaluation call at $781C (flags set by OR A)
@label=PRESEARCH
c$7810 LD IX,$BD58   ; IX = root move record at $BD58 (the last move played in
                     ; the game)
 $7814 LD A,($BD2D)  ; {Flip bit 0 of $BD2D (side to move) for the evaluation
 $7817 XOR $01       ; call
 $7819 LD ($BD2D),A  ; }
 $781C CALL $8400    ; Evaluate (returns score in A and a second value in B)
 $781F PUSH AF       ; Keep the evaluation result for the return value
 $7820 LD A,($BCA0)  ; {E = ($BCA0) + $80 (signed: previous root score
 $7823 ADD A,$80     ; re-biased)
 $7825 LD E,A        ; }
 $7826 LD A,($BCBE)  ; {If $BCBE is non-zero, negate B and E
 $7829 OR A          ;
 $782A JR Z,$7832    ; }
 $782C XOR A         ; {B = -B
 $782D SUB B         ;
 $782E LD B,A        ; }
 $782F XOR A         ; {E = -E
 $7830 SUB E         ;
 $7831 LD E,A        ; }
*$7832 LD A,($BD2E)  ; A = old $BD2E (material difference x8 from the previous
                     ; call)
 $7835 SRA A         ; A = A SRA 1
 $7837 SRA E         ; E = E SRA 1
 $7839 ADD A,E       ; A = A + E
 $783A SRA A         ; {A = A SRA 2
 $783C SRA A         ; }
 $783E JR Z,$7841    ; {If the result is non-zero, add 1 (rounds towards
 $7840 INC A         ; +infinity)}
*$7841 LD ($BD1E),A  ; Store in $BD1E
 $7844 LD A,($BD4A)  ; {$BD4A = $BD4A + B (8-bit, wraps)
 $7847 ADD A,B       ;
 $7848 LD ($BD4A),A  ; }
 $784B LD HL,$BE08   ; HL = White piece records from the queen ($BE08); 15
                     ; records follow
 $784E XOR A         ; {Clear the pawns-present flag $BD6D
 $784F LD ($BD6D),A  ; }
 $7852 CALL $789D    ; C = White material (sum of value nibbles)
 $7855 LD E,C        ; E = White material
 $7856 LD L,$88      ; HL = Black piece records from the queen ($BE88)
 $7858 CALL $789D    ; C = Black material
 $785B LD A,C        ; {A = Black - White material (8-bit)
 $785C SUB E         ; }
 $785D CP $0E        ; {0..13: keep
 $785F JR C,$786C    ; }
 $7861 CP $F2        ; {-14..-1: keep
 $7863 JR NC,$786C   ; }
 $7865 RLA           ; {Otherwise clamp: +14 if positive, -14 if negative
 $7866 LD A,$0E      ;
 $7868 JR NC,$786C   ;
 $786A LD A,$F2      ; }
*$786C ADD A,A       ; {Multiply by 8 (range -112..+112)
 $786D ADD A,A       ;
 $786E ADD A,A       ; }
 $786F LD ($BD2E),A  ; Store the material difference term in $BD2E
 $7872 LD A,($BD49)  ; A = move number ($BD49)
 $7875 LD B,$00      ; B = phase bits = 0
 $7877 CP $08        ; {Before move 8: phase bits stay 0 (opening)
 $7879 JR C,$7891    ; }
 $787B LD A,C        ; {A = total material of both sides (Black + White)
 $787C ADD A,E       ; }
 $787D SET 1,B       ; Phase bit 1: move number >= 8
 $787F CP $34        ; {Total >= 52: done (bits = %00010)
 $7881 JR NC,$7891   ; }
 $7883 SET 2,B       ; Phase bit 2: total < 52
 $7885 CP $28        ; {Total >= 40: done (%00110)
 $7887 JR NC,$7891   ; }
 $7889 SET 3,B       ; Phase bit 3: total < 40
 $788B CP $19        ; {Total >= 25: done (%01110)
 $788D JR NC,$7891   ; }
 $788F SET 4,B       ; Phase bit 4: total < 25 (%11110)
*$7891 LD HL,$BD2D   ; {$BD2D = (restored side bit) + phase bits
 $7894 LD A,(HL)     ; }
 $7895 INC A         ; {Flip bit 0 back to its value on entry
 $7896 AND $01       ; }
 $7898 ADD A,B       ; {Add the phase bits (bits 1-4)
 $7899 LD (HL),A     ; }
 $789A POP AF        ; {Return the evaluation result
 $789B OR A          ;
 $789C RET           ; }

; Sum material of one side's non-king pieces
;
; Adds the value nibble (+1 AND $0F) of 15 piece records starting at HL (stride
; 8), skipping records whose square byte has bit 7 set (captured). Sets $BD6D
; to 1 if any record has value 1 (a pawn).
;
;   HL Address of the first record to count ($BE08 or $BE88)
; O:C Total material (8-bit)
@label=MATERIAL
c$789D LD C,$00      ; C = running total
 $789F LD B,$0F      ; B = 15 records (Q, R, R, B, B, N, N, P x 8)
*$78A1 BIT 7,(HL)    ; {Skip if captured (square byte bit 7 set)
 $78A3 JR NZ,$78B3   ; }
 $78A5 INC L         ; {A = value nibble of the type byte
 $78A6 LD A,(HL)     ;
 $78A7 AND $0F       ; }
 $78A9 CP $01        ; {A pawn?
 $78AB JR NZ,$78B0   ; }
 $78AD LD ($BD6D),A  ; Yes: $BD6D = 1 (pawns present)
*$78B0 ADD A,C       ; {C = C + value
 $78B1 LD C,A        ; }
 $78B2 DEC L         ; Back to the square byte
*$78B3 LD A,$08      ; {Next record (+8)
 $78B5 ADD A,L       ;
 $78B6 LD L,A        ;
 $78B7 DJNZ $78A1    ;
 $78B9 RET           ; }

; Poll the keyboard, then generate moves
;
; Called by the search (#R$7D43) at every node where moves are generated. If no
; abort is pending, any key held down sets the abort flag ($BD4C bit 7) and
; updates the display via #R$7562. Then falls through to #R$78CE.
@label=POLLGEN
c$78BA LD HL,$BD4C   ; {Abort already pending ($BD4C bit 7)?
 $78BD BIT 7,(HL)    ; }
 $78BF JR NZ,$78CE   ; Yes: just generate
 $78C1 CALL $6734    ; Any key pressed? (prints *INTERRUPTED* if so)
 $78C4 JR Z,$78CE    ; No: generate
 $78C6 LD HL,$BD4C   ; {Set the abort flag
 $78C9 SET 7,(HL)    ; }
 $78CB CALL $7562    ; Update the display for the interrupt

; Generate pseudo-legal moves for the side in $BD2D bit 0
;
; Writes the move list for ply ($BCA9) starting at the address in the ply table
; ($BCA9+2*ply): a 4-byte header followed by one 4-byte entry per move (score
; $FF, from, to, flags) and an $FF terminator. Stores the end address in the
; next ply-table slot and returns the count in E.
; .
; Generation order: castling (kingside, queenside), king steps, queen, rook
; ($BE10), rook ($BE18), bishop ($BE20), bishop ($BE28), knight ($BE30), knight
; ($BE38), then the 8 pawn slots ($BE40-$BE78) in order. A promoted piece in a
; pawn slot moves according to its type byte.
; .
; Register usage: main set B = from-square, H = $BD (board page), L = target
; square, C = $88 off-board mask (overwritten by direction in the slide loop),
; DE = list write pointer. Alternate set: B = loop counter, C = side-to-move
; (bit 7: 1 = Black), DE = direction-table pointer, HL = pawn-record pointer.
; A' = $BC (list-full check in #R$7A9D).
;
;   IX Parent move record (flags bit 7 = in check suppresses castling; bit 5 +
; .    to-square drive en passant)
; O:E Move count (only correct for fewer than 127 moves; see docs)
; O:HL Address of header byte +3
@label=GENMOVES
c$78CE LD HL,$BCA9    ; {HL = $BCA9 + 2 * ply: ply-table slot for this ply
 $78D1 LD A,(HL)      ;
 $78D2 ADD A,A        ;
 $78D3 ADD A,L        ;
 $78D4 LD L,A         ; }
 $78D5 LD E,(HL)      ; {DE = start of this ply's list (header address)
 $78D6 INC L          ;
 $78D7 LD D,(HL)      ; }
 $78D8 INC L          ; HL = next ply-table slot (will receive the end address)
 $78D9 PUSH DE        ; Save the list start
 $78DA INC E          ; {DE = start + 4 (first move entry)
 $78DB INC E          ;
 $78DC INC E          ;
 $78DD INC DE         ; }
 $78DE PUSH HL        ; Save the next ply-table slot address
 $78DF EX AF,AF'      ; {A' = $BC: page at which the list is close to full
 $78E0 LD A,$BC       ;
 $78E2 EX AF,AF'      ; }
 $78E3 LD H,$BD       ; H = board page
 $78E5 LD IY,$BE00    ; IY = White piece records
 $78E9 LD A,($BD2D)   ; {C' = $BD2D rotated right: bit 7 = side to move (1 =
 $78EC EXX            ; Black)
 $78ED RRCA           ;
 $78EE LD C,A         ;
 $78EF EXX            ; }
 $78F0 JR NC,$78F6    ; {Black to move: IY = Black piece records
 $78F2 LD IY,$BE80    ; }
*$78F6 LD B,(IY+$00)  ; B = king square
 $78F9 BIT 4,(IY+$01) ; {King not yet moved: try castling
 $78FD CALL Z,$7A61   ; }
 $7900 LD C,$88       ; {C = $88 off-board mask
 $7902 EXX            ; }
 $7903 LD DE,$7808    ; {King steps: 8 directions from $7808 (diagonals, then
 $7906 CALL $7A18     ; orthogonals)}
 $7909 LD A,(IY+$08)  ; {Queen (IY+$08) present: slide in 8 directions
 $790C OR A           ;
 $790D CALL P,$7A57   ; }
 $7910 LD A,(IY+$10)  ; {Rook (IY+$10) present: slide in 4 directions
 $7913 OR A           ;
 $7914 CALL P,$7A2E   ; }
 $7917 LD A,(IY+$18)  ; {Rook (IY+$18) present
 $791A OR A           ;
 $791B CALL P,$7A2E   ; }
 $791E LD A,(IY+$20)  ; {Bishop (IY+$20) present: slide in 4 diagonals
 $7921 OR A           ;
 $7922 CALL P,$7A4F   ; }
 $7925 LD A,(IY+$28)  ; {Bishop (IY+$28) present
 $7928 OR A           ;
 $7929 CALL P,$7A4F   ; }
 $792C LD A,(IY+$30)  ; Knight (IY+$30) present: 8 jumps from $7800
 $792F LD C,$88       ; {Restore C = $88 (the slide loops use C for the
 $7931 OR A           ; direction)
 $7932 CALL P,$7A13   ; }
 $7935 LD A,(IY+$38)  ; {Knight (IY+$38) present
 $7938 OR A           ;
 $7939 CALL P,$7A13   ; }
 $793C LD C,$11       ; {C = pawn capture offset: +$11 (White, up-right)...
 $793E EXX            ; }
 $793F LD HL,$BE40    ; HL' = White pawn records ($BE40)
 $7942 BIT 7,C        ; {Black to move?
 $7944 JR Z,$794C     ; }
 $7946 LD L,$C0       ; {HL' = Black pawn records ($BEC0)
 $7948 EXX            ; }
 $7949 LD C,$F1       ; {...or $F1 (Black, -15 = down-right)
 $794B EXX            ; }
; Pawn-slot loop (alternate set).
*$794C LD A,(HL)      ; {Captured (square bit 7 set)?
 $794D RLA            ; }
 $794E JR C,$799C     ; Yes: next slot
 $7950 INC L          ; {A = type byte
 $7951 LD A,(HL)      ;
 $7952 DEC L          ; }
 $7953 AND $0E        ; Bits 1-3 non-zero: a promoted piece (Q 9, R 5, B $83, N
                      ; 3)
 $7955 LD A,(HL)      ; {A = square
 $7956 EXX            ; }
 $7957 LD B,A         ; B = from-square
 $7958 JR NZ,$79C8    ; Promoted piece: generate as that piece
 $795A ADD A,C        ; {L = from + C (diagonal capture to the right; NOT
 $795B LD L,A         ; checked for off-board)}
 $795C XOR A          ; {Occupied?
 $795D OR (HL)        ; }
 $795E CALL NZ,$7A97  ; Yes: add a capture if it is an enemy piece
 $7961 DEC L          ; {L = from + C - 2 (diagonal capture to the left; not
 $7962 DEC L          ; checked for off-board)}
 $7963 XOR A          ; {Occupied?
 $7964 OR (HL)        ; }
 $7965 CALL NZ,$7A97  ; Yes: add a capture if it is an enemy piece
 $7968 INC L          ; L = forward square
 $7969 XOR A          ; {Forward square occupied?
 $796A OR (HL)        ; }
 $796B JR NZ,$7994    ; Yes: only en passant can follow
 $796D CALL $7A9D     ; Add the single push (flags 0); promotion is detected
                      ; later by make
 $7970 LD A,B         ; {From-square on the home rank (rank 2 White / rank 7
 $7971 ADD A,$20      ; Black)?
 $7973 BIT 6,A        ; }
 $7975 JR NZ,$7994    ; No: try en passant
 $7977 LD A,C         ; {L = forward + C - 1 (two squares ahead); skip if past
 $7978 DEC A          ; rank 8 (sign)
 $7979 ADD A,L        ;
 $797A JP M,$799B     ;
 $797D LD L,A         ; }
 $797E XOR A          ; {Two squares ahead occupied?
 $797F OR (HL)        ; }
 $7980 JR NZ,$799B    ; Yes: next slot
 $7982 CALL $7A9D     ; Add the double push (flags 0)
 $7985 DEC L          ; {Square left of the landing square holds an enemy pawn?
 $7986 OR (HL)        ; }
 $7987 CALL NZ,$79FC  ; Yes: flag the double push $20 (en passant possible)
 $798A INC L          ; {Square right of the landing square
 $798B INC L          ;
 $798C LD A,(HL)      ;
 $798D OR A           ; }
 $798E CALL NZ,$79FC  ; Enemy pawn there: flag $20
 $7991 JP $799B       ; Next slot (no en passant from the home rank)
*$7994 BIT 5,(IX+$03) ; Previous move a double push next to a pawn (flags bit
                      ; 5)?
 $7998 CALL NZ,$79E4  ; {Yes: try the en passant capture
*$799B EXX            ; }
; This entry point is used by the routine at #R$79E0.
*$799C LD A,$08       ; {Next pawn slot (+8)
 $799E ADD A,L        ;
 $799F LD L,A         ; }
 $79A0 BIT 6,A        ; {Loop while L bit 6 is set ($40-$78 or $C0-$F8)
 $79A2 JP NZ,$794C    ; }
; All pieces done: terminate the list and write its header.
 $79A5 EXX            ; Back to the main set
 $79A6 LD A,$FF       ; {Terminator: $FF at +0 of the entry after the last move
 $79A8 LD (DE),A      ; }
 $79A9 POP HL         ; HL = next ply-table slot
 $79AA LD (HL),E      ; {Store the end address (= this terminator) there
 $79AB INC L          ;
 $79AC LD (HL),D      ; }
 $79AD POP HL         ; HL = list start
 $79AE EX DE,HL       ; HL = end, DE = start
 $79AF OR A           ; {HL = end - start = 4 * (n + 1)
 $79B0 SBC HL,DE      ; }
 $79B2 RR H           ; {L = (H bit 0, L) >> 2: this drops H bit 1, so it is
 $79B4 RR L           ; only right for n < 127
 $79B6 RR L           ; }
 $79B8 DEC L          ; L = n (number of moves)
 $79B9 EX DE,HL       ; E = n, HL = list start (header)
 $79BA LD (HL),A      ; Header +0 = $FF
 $79BB INC L          ; {Header +1 = n
 $79BC LD (HL),E      ; }
 $79BD INC L          ; {Header +2 = 0
 $79BE LD (HL),$00    ; }
 $79C0 INC L          ; {Header +3 = parent flags AND $81 (bit 7 in check, bit
 $79C1 LD A,(IX+$03)  ; 0 pawn to 6th/7th)
 $79C4 AND $81        ;
 $79C6 LD (HL),A      ;
 $79C7 RET            ; }
; A promoted piece in a pawn slot. The return address is set to #R$79E0 so that
; the piece routine returns into the pawn loop.
@label=GEN_PROMOTED
*$79C8 PUSH BC        ; Save B (from-square) and C (pawn capture offset)
 $79C9 LD C,$88       ; {C = $88 off-board mask (for knight steps)
 $79CB EXX            ; }
 $79CC INC L          ; {A = type byte
 $79CD LD A,(HL)      ;
 $79CE DEC L          ; }
 $79CF LD DE,$79E0    ; {Return to $79E0 when done
 $79D2 PUSH DE        ; }
 $79D3 OR A           ; {Bit 7 set: bishop
 $79D4 JP M,$7A51     ; }
 $79D7 RRA            ; {Bit 1 set: knight
 $79D8 RRA            ;
 $79D9 JR C,$7A15     ; }
 $79DB RRA            ; {Bit 2 set: rook
 $79DC JR C,$7A30     ; }
 $79DE JR $7A59       ; Otherwise: queen

; Return point after generating a promoted piece's moves
;
; Reached by RET from a piece routine (address pushed at $79CF). Restores B and
; C, then continues the pawn-slot loop at #R$799C in the alternate register
; set.
@label=GEN_PROMOTED_RET
c$79E0 POP BC        ; {Restore B (from) and C (pawn capture offset)
 $79E1 EXX           ; }
 $79E2 JR $799C      ; Continue the pawn-slot loop at $799C

; Generate an en passant capture
;
; Called for a pawn when the parent move's flags have bit 5 set. If that move
; was not itself a capture (bit 3 clear) and landed directly beside this pawn,
; adds the en passant capture to the square behind the enemy pawn, with flags
; $28.
;
; B From-square of the capturing pawn
; L Forward square of the capturing pawn
@label=GEN_EP
c$79E4 BIT 3,(IX+$03) ; {Parent move was a capture ($28): not a double push
 $79E8 RET NZ         ; }
 $79E9 LD A,(IX+$02)  ; {Enemy pawn landed on from + 1?
 $79EC INC A          ;
 $79ED CP B           ; }
 $79EE JR Z,$79F6     ; Yes: capture towards forward - 1
 $79F0 DEC A          ; {Enemy pawn landed on from - 1?
 $79F1 DEC A          ;
 $79F2 CP B           ; }
 $79F3 RET NZ         ; No: return
 $79F4 INC L          ; {Target = forward + 1
 $79F5 INC L          ; }
*$79F6 DEC L          ; Target = forward - 1 (or +1 after the two INCs)
 $79F7 LD A,$28       ; Flags $28: capture + en passant
 $79F9 JP $7A9D       ; Add the move

; Flag a double push next to an enemy pawn
;
; Called after a double push with A = piece code beside the landing square. If
; it is an enemy pawn (value 1, any advancement), sets the flags byte of the
; move just added to $20.
;
; A Piece code beside the landing square
; HL Address of that square
@label=GEN_EPFLAG
c$79FC EXX           ; {Same colour as the mover?
 $79FD XOR C         ;
 $79FE EXX           ; }
 $79FF RET P         ; Yes: nothing to do
 $7A00 LD A,(HL)     ; {A = piece code
 $7A01 EXX           ; }
 $7A02 LD B,L        ; Save L'
 $7A03 SUB $03       ; {L' = code - 3 = record offset + 1 (type byte); H' = $BE
 $7A05 LD L,A        ; }
 $7A06 LD A,(HL)     ; A = type byte
 $7A07 LD L,B        ; {Restore L'
 $7A08 EXX           ; }
 $7A09 AND $0F       ; {Value 1 (pawn)?
 $7A0B DEC A         ; }
 $7A0C RET NZ        ; No: return
 $7A0D LD A,$20      ; {Yes: flags of the last move entry = $20
 $7A0F DEC DE        ;
 $7A10 LD (DE),A     ;
 $7A11 INC DE        ;
 $7A12 RET           ; }

; Generate knight moves
;
; Used by the routine at #R$78CE.
;
; A From-square
@label=GEN_KNIGHT
c$7A13 LD B,A        ; {B = from-square
 $7A14 EXX           ; }
; This entry point is used by the routine at #R$78CE.
@label=GEN_KNIGHT_X
*$7A15 LD DE,$7800   ; DE' = knight offsets at $7800

; Generate single-step moves in 8 directions (king, knight)
;
; For each of 8 offsets at DE': target = from + offset. Skips off-board squares
; (C = $88), adds a quiet move to an empty square, and adds a capture of an
; enemy piece.
;
; DE' Direction table
; B From-square
; C $88
@label=GEN_STEPS
c$7A18 LD B,$08      ; 8 directions
*$7A1A LD A,(DE)     ; {A = offset
 $7A1B INC E         ;
 $7A1C EXX           ; }
 $7A1D ADD A,B       ; {L = from + offset
 $7A1E LD L,A        ; }
 $7A1F AND C         ; {Off the board?
 $7A20 JR NZ,$7A29   ; }
 $7A22 OR (HL)       ; {Empty: add a quiet move (returns Z)
 $7A23 CALL Z,$7A9D  ; }
 $7A26 CALL NZ,$7A97 ; {Occupied: add a capture if it is an enemy piece
*$7A29 EXX           ;
 $7A2A DJNZ $7A1A    ;
 $7A2C EXX           ;
 $7A2D RET           ; }

; Generate rook moves
;
; Used by the routine at #R$78CE.
;
; A From-square
@label=GEN_ROOK
c$7A2E LD B,A        ; {B = from-square
 $7A2F EXX           ; }
; This entry point is used by the routine at #R$78CE.
@label=GEN_ROOK_X
*$7A30 LD DE,$780C   ; DE' = orthogonal offsets at $780C (+1, -1, +16, -16)
; This entry point is used by the routine at #R$7A4F.
@label=GEN_SLIDE4
*$7A33 LD B,$04      ; 4 directions
; Slide loop: for each direction, step until off the board or blocked.
@label=GEN_SLIDE
*$7A35 LD A,(DE)     ; {A = direction
 $7A36 INC E         ;
 $7A37 EXX           ; }
 $7A38 LD C,A        ; C = direction (overwrites the $88 mask)
 $7A39 LD L,B        ; L = from-square
*$7A3A LD A,L        ; {L = L + direction
 $7A3B ADD A,C       ;
 $7A3C LD L,A        ; }
 $7A3D AND $88       ; {Off the board: next direction
 $7A3F JR NZ,$7A4A   ; }
 $7A41 OR (HL)       ; {Empty: add a quiet move and keep sliding
 $7A42 CALL Z,$7A9D  ;
 $7A45 JR Z,$7A3A    ; }
 $7A47 CALL $7A97    ; {Occupied: add a capture if it is an enemy piece, then
*$7A4A EXX           ; stop
 $7A4B DJNZ $7A35    ;
 $7A4D EXX           ;
 $7A4E RET           ; }

; Generate bishop moves
;
; Used by the routine at #R$78CE.
;
; A From-square
@label=GEN_BISHOP
c$7A4F LD B,A        ; {B = from-square
 $7A50 EXX           ; }
; This entry point is used by the routine at #R$78CE.
@label=GEN_BISHOP_X
*$7A51 LD DE,$7808   ; {DE' = diagonal offsets at $7808 (+15, +17, -17, -15), 4
 $7A54 JP $7A33      ; directions}

; Generate queen moves
;
; Used by the routine at #R$78CE.
;
; A From-square
@label=GEN_QUEEN
c$7A57 LD B,A        ; {B = from-square
 $7A58 EXX           ; }
; This entry point is used by the routine at #R$78CE.
@label=GEN_QUEEN_X
*$7A59 LD DE,$7808   ; DE' = $7808: 4 diagonals, then 4 orthogonals
 $7A5C LD B,$08      ; {8 directions
 $7A5E JP $7A35      ; }

; Generate castling moves
;
; Called only if the king's type byte has bit 4 (moved) clear. Kingside first:
; the rook in record +$18 must be present and unmoved, and the two squares to
; the king's right must be empty. Queenside: the rook in record +$10 must be
; present and unmoved, and the three squares to the king's left must be empty.
; No square is tested for attack here, and the rook's actual square is not
; checked. Castling moves get flags $10.
;
; B King square
; IX Parent move (flags bit 7 set = side to move is in check: no castling)
@label=GEN_CASTLE
c$7A61 BIT 7,(IX+$03) ; {In check: no castling
 $7A65 RET NZ         ; }
 $7A66 BIT 4,(IY+$19) ; {Kingside rook moved?
 $7A6A JR NZ,$7A7D    ; }
 $7A6C BIT 7,(IY+$18) ; {Kingside rook captured?
 $7A70 JR NZ,$7A7D    ; }
 $7A72 XOR A          ; {King + 1 empty?
 $7A73 LD L,B         ;
 $7A74 INC L          ;
 $7A75 OR (HL)        ;
 $7A76 JR NZ,$7A7D    ; }
 $7A78 INC L          ; {King + 2 empty: add O-O
 $7A79 OR (HL)        ;
 $7A7A CALL Z,$7A93   ; }
*$7A7D BIT 4,(IY+$11) ; {Queenside rook moved?
 $7A81 RET NZ         ; }
 $7A82 BIT 7,(IY+$10) ; {Queenside rook captured?
 $7A86 RET NZ         ; }
 $7A87 LD L,B         ; {King - 1 empty?
 $7A88 XOR A          ;
 $7A89 DEC L          ;
 $7A8A OR (HL)        ;
 $7A8B RET NZ         ; }
 $7A8C DEC L          ; {King - 2 empty?
 $7A8D OR (HL)        ;
 $7A8E RET NZ         ; }
 $7A8F DEC L          ; {King - 3 empty?
 $7A90 OR (HL)        ;
 $7A91 RET NZ         ; }
 $7A92 INC L          ; Target = king - 2: add O-O-O

; Add a castling move (flags $10)
;
; Used by the routine at #R$7A61.
@label=ADD_CASTLE
c$7A93 LD A,$10      ; {A = $10 (castling) and add the move
 $7A95 JR $7A9D      ; }

; Add a capture if the target holds an enemy piece
;
; Used by the routines at #R$78CE, #R$7A18 and #R$7A2E.
;
; A Piece code on the target square
@label=ADD_CAPTURE
c$7A97 EXX           ; {Same colour as the side to move?
 $7A98 XOR C         ;
 $7A99 EXX           ; }
 $7A9A RET P         ; Yes: no move
 $7A9B LD A,$08      ; Flags $08: capture

; Append a move to the list
;
; Writes score $FF, from (B), to (L) and flags (A) at DE and advances DE by 4.
; When DE reaches $BC81 or beyond, the move is not written; instead the search
; abort flag ($BD4C bit 7) is set. The list area is therefore $B400-$BC83.
;
;   A Flags
;   B From-square
;   L To-square
;   DE List write pointer
; O:A Flags (Z set if the flags are 0)
@label=ADD_MOVE
c$7A9D EX AF,AF'     ; A = $BC (from A'); A' = flags
 $7A9E CP D          ; {Pointer in page $BC?
 $7A9F JR Z,$7AAF    ; }
@label=ADD_MOVE_WRITE
*$7AA1 EX AF,AF'     ; A = flags
 $7AA2 EX DE,HL      ; HL = list pointer
 $7AA3 LD (HL),$FF   ; +0 score = $FF (not yet scored)
 $7AA5 INC L         ; {+1 from-square
 $7AA6 LD (HL),B     ; }
 $7AA7 INC L         ; {+2 to-square
 $7AA8 LD (HL),E     ; }
 $7AA9 INC L         ; {+3 flags
 $7AAA LD (HL),A     ; }
 $7AAB INC HL        ; {Next entry (16-bit increment)
 $7AAC EX DE,HL      ; }
 $7AAD OR A          ; {Z if the flags are 0
 $7AAE RET           ; }
@label=ADD_MOVE_FULL
*$7AAF LD A,$80      ; {Still room while the low byte <= $80
 $7AB1 CP E          ;
 $7AB2 LD A,$BC      ;
 $7AB4 JR NC,$7AA1   ; }
 $7AB6 PUSH HL       ; {List full: set the abort flag $BD4C bit 7
 $7AB7 LD HL,$BD4C   ;
 $7ABA SET 7,(HL)    ;
 $7ABC POP HL        ; }
 $7ABD EX AF,AF'     ; {A = flags
 $7ABE OR A          ;
 $7ABF RET           ; }
; Used by the book probe (#R$7AC7): mark the game as out of book.
@label=BOOK_OFF
*$7AC0 LD A,$FF      ; {$BCDF = $FF: out of book
 $7AC2 LD ($BCDF),A  ; }
 $7AC5 OR A          ; {Return NZ
 $7AC6 RET           ; }

; Opening book: probe for a book move
;
; Called from the search driver ($7C1E) after the root move list for the
; current position has been generated at $B404 (and scored by $7B96), unless
; the problem/next-best flag $BCDD is set. Walks the book tree ($9000, see
; #R$9000) from the root along the moves of the game so far (indices in the
; game record at $C058), then picks one of the stored replies at random.
; .
; The book is used only when $BCDF=0 (book not yet abandoned) and $C006=1 (the
; game started from the standard initial position; a set-up position stores its
; move number there). Book moves are taken straight from the pseudo-legal root
; list without any legality check (see docs/arch/25-book.md: the stored reply
; 6...Be7 after 1.e4 e5 2.Nf3 Nf6 3.Nxe5 d6 4.Nf3 Nxe4 5.d4 d5 6.Bb5+ is
; illegal and is played).
;
; O:F Z set: book move found; NZ: no book move
; O:($BD29) Address of the chosen move in the root list ($B404+4*index), when Z
@label=BOOK_PROBE
c$7AC7 LD A,($BCDF)  ; Book already abandoned in this game (BCDF non-zero)?
 $7ACA OR A          ;
 $7ACB RET NZ        ; Return NZ if so
 $7ACC LD A,($C006)  ; Did the game start from the standard initial position
                     ; ($C006=1)?
 $7ACF DEC A         ;
 $7AD0 RET NZ        ; Return NZ if not
 $7AD1 CALL $7B89    ; B=random byte (also updates $BCCE); B is not used before
                     ; the next call
 $7AD4 LD HL,$FFFF   ; HL=-1: entry number, pre-incremented below
; Follow one game move down the tree. HL points (after the increment) at the
; first entry of the sibling list for the position reached so far; on entry to
; the loop, $BCDF counts the plies already matched.
@label=BOOKP_PLY
*$7AD7 INC HL        ; Next entry (first child of the matched move; the root
                     ; list on the first pass)
 $7AD8 LD A,($C001)  ; C=number of plies played in the game (low byte of $C001
                     ; only)
 $7ADB LD C,A        ;
 $7ADC LD A,($BCDF)  ; Increment the ply counter $BCDF...
 $7ADF INC A         ;
 $7AE0 LD ($BCDF),A  ;
 $7AE3 DEC A         ; ...and get its old value i
 $7AE4 CP C          ; Have all i game plies been matched?
 $7AE5 JR Z,$7B05    ; If so, choose a reply from this sibling list
 $7AE7 LD BC,$C058   ; BC=$C058+i: game record byte for ply i
 $7AEA ADD A,C       ;
 $7AEB LD C,A        ;
 $7AEC JR NC,$7AEF   ;
 $7AEE INC B         ;
*$7AEF LD A,(BC)     ; A=record byte (list index; bit 7 = move gave check)
 $7AF0 AND $7F       ; Discard the check bit
 $7AF2 LD C,A        ; C=index of the game move played at ply i
 $7AF3 CALL $7B57    ; A=book entry HL (bit 7=leaf, bit 6=more siblings, bits
                     ; 0-5=list index)
@label=BOOKP_CMP
*$7AF6 LD B,A        ; B=entry
 $7AF7 RES 6,A       ; Clear the 'more siblings' bit; the leaf bit stays, so a
                     ; leaf entry never matches
 $7AF9 CP C          ; Does the entry name the game move (and have a
                     ; continuation)?
 $7AFA JR Z,$7AD7    ; If so, descend to its children and follow the next ply
 $7AFC BIT 6,B       ; Any more siblings to try?
 $7AFE JR Z,$7AC0    ; If not, the game has left the book: set $BCDF=$FF and
                     ; return NZ (#R$7AC0)
 $7B00 CALL $7B4C    ; Skip this entry's subtree; HL=next sibling, A=its entry
 $7B03 JR $7AF6      ; Compare again
; All game plies matched: choose one of the moves in the sibling list at HL.
@label=BOOKP_CHOOSE
*$7B05 CALL $7B89    ; B=fresh random byte (bit 7 always 0)
 $7B08 CALL $7B57    ; A=first entry of the list, CF=its leading (9th) bit 'M'
 $7B0B LD C,A        ; C=entry (candidate move)
 $7B0C BIT 6,A       ; Is it the only move in the list?
 $7B0E JR Z,$7B30    ; If so, take it
 $7B10 LD A,$01      ; A=2 (or 3 if M is set)
 $7B12 RLA           ;
 $7B13 AND B         ; Take the first move if random bit 1 is set, or (when M
                     ; is set) bit 0: probability 1/2, or 3/4 when M is set
 $7B14 JR NZ,$7B30   ;
@label=BOOKP_SIB
*$7B16 PUSH HL       ; Save the address of the current candidate
 $7B17 CALL $7B89    ; B=fresh random byte
 $7B1A CALL $7B4C    ; Skip the candidate's subtree: HL=next sibling, A=its
                     ; entry, CF=its M bit
 $7B1D JR C,$7B2B    ; If the next sibling has M set, stop here and take the
                     ; previous candidate
 $7B1F POP DE        ; Discard the saved address
 $7B20 LD C,A        ; C=entry of the new candidate
 $7B21 BIT 6,A       ; Is it the last sibling?
 $7B23 JR Z,$7B30    ; If so, take it
 $7B25 RR B          ; Random bit 0 into the carry flag
 $7B27 JR C,$7B16    ; If set, move on to the next sibling
 $7B29 JR $7B30      ; Otherwise take this one
@label=BOOKP_PREV
*$7B2B POP HL        ; Restore the previous candidate's address
 $7B2C CALL $7B57    ; Re-read its entry
 $7B2F LD C,A        ; C=entry
@label=BOOKP_TAKE
*$7B30 LD A,C        ; A=list index of the chosen move (bits 0-5)
 $7B31 AND $3F       ;
 $7B33 RLA           ; x4 (carry is clear after AND)
 $7B34 RLA           ;
 $7B35 LD E,A        ; DE=4*index
 $7B36 LD D,$00      ;
 $7B38 LD IX,$B404   ; IX=$B404+4*index: the chosen entry in the root move list
 $7B3C ADD IX,DE     ;
 $7B3E LD ($BD29),IX ; Store it for the caller
 $7B42 XOR A         ; A=0
 $7B43 BIT 7,C       ; Is the chosen move a leaf (no stored continuation)?
 $7B45 JR NZ,$7B4A   ; If so, leave $BCDF non-zero (= plies matched + 1): the
                     ; book is not consulted again this game
 $7B47 LD ($BCDF),A  ; Otherwise reset $BCDF to 0 so the book is probed again
                     ; next move
@label=BOOKP_DONE
*$7B4A XOR A         ; Return Z: book move found
 $7B4B RET           ;

; Opening book: skip a subtree
;
; Skips book entry HL and all its descendants, returning the entry of its next
; sibling. Only called for an entry whose 'more siblings' bit (6) is set. Uses
; DE as a signed counter: DE=-1, then for each entry read in pre-order DE is
; decremented if bit 7 (leaf) is set and incremented if bit 6 (more siblings)
; is set; the walk stops after the first entry that leaves DE negative.
;
; I:HL Entry number of the subtree root
; O:HL Entry number of the next sibling
; O:A That sibling's entry (from #R$7B57); CF=its leading bit M; Z if it has no
; .   further siblings
@label=BOOK_SKIP
c$7B4C LD DE,$FFFF   ; DE=-1
@label=BOOKS_LOOP
*$7B4F CALL $7B57    ; Read entry HL and adjust DE
 $7B52 INC HL        ; Next entry
 $7B53 BIT 7,D       ; Continue while DE is not negative
 $7B55 JR Z,$7B4F    ;

; Opening book: read an entry and update the subtree counter
;
; Reads book entry HL via #R$7B64 and adjusts the subtree counter DE used by
; #R$7B4C.
;
; I:HL Entry number
; I:DE Subtree counter
; O:A Entry bits 0-7: bit 7=leaf (no children), bit 6=more siblings follow,
; .   bits 0-5=index in the generated move list
; O:F CF=entry bit 8 (the leading bit, 'M'); Z if bit 6 is clear
; O:DE DE-1 if bit 7 is set, then DE+1 if bit 6 is set
;
; Falls through into #R$7B57 to read the sibling's entry.
@label=BOOK_READ
c$7B57 CALL $7B64    ; A=entry bits 0-7, CF=bit 8
 $7B5A BIT 7,A       ; Leaf?
 $7B5C JR Z,$7B5F    ;
 $7B5E DEC DE        ; If so, DE=DE-1
*$7B5F BIT 6,A       ; More siblings?
 $7B61 RET Z         ; Return Z if not
 $7B62 INC DE        ; If so, DE=DE+1
 $7B63 RET           ; Return NZ (carry unchanged)

; Opening book: fetch the 9-bit entry HL
;
; The book at $9000 is a bit stream of 9-bit entries, most significant bit
; first: entry n occupies stream bits 9n to 9n+8, which start at bit (n AND 7)
; of byte n+INT(n/8). The routine reads the two bytes from that address into A
; and C and shifts the pair left (n AND 7)+1 times, so that A holds entry bits
; 0-7 and the carry flag holds bit 8.
;
; I:HL Entry number n
; O:A Entry bits 0-7
; O:F CF=entry bit 8
@label=BOOK_BITS
c$7B64 PUSH BC       ; Preserve BC and HL
 $7B65 PUSH HL       ;
 $7B66 LD A,L        ; BC=n/8 (shift HL right three times)
 $7B67 SRL H         ;
 $7B69 RRA           ;
 $7B6A SRL H         ;
 $7B6C RRA           ;
 $7B6D SRL H         ;
 $7B6F RRA           ;
 $7B70 LD B,H        ;
 $7B71 LD C,A        ;
 $7B72 POP HL        ; Restore HL=n (and keep it on the stack)
 $7B73 PUSH HL       ;
 $7B74 LD A,$07      ; A=n AND 7 (clears the carry flag)
 $7B76 AND L         ;
 $7B77 ADD HL,BC     ; HL=n+n/8 (=byte offset of the entry)
 $7B78 LD BC,$9000   ; HL=$9000+n+n/8
 $7B7B ADD HL,BC     ;
 $7B7C LD B,A        ; B=(n AND 7)+1: number of shifts
 $7B7D INC B         ;
 $7B7E LD A,(HL)     ; A=first byte
 $7B7F INC HL        ; C=second byte
 $7B80 LD C,(HL)     ;
@label=BOOKB_SHIFT
*$7B81 RL C          ; Shift C into A, one bit at a time; the last bit shifted
                     ; out of A (entry bit 8) is left in the carry flag
 $7B83 RLA           ;
 $7B84 DJNZ $7B81    ;
 $7B86 POP HL        ; Restore HL and BC
 $7B87 POP BC        ;
 $7B88 RET           ;

; Opening book: generate a random byte
;
; Mixes the Z80 refresh register R into the random accumulator at $BCCE and
; halves it: $BCCE = (R XOR $BCCE) >> 1. The result (0-127; bit 7 is always 0)
; is returned in B. $BCCE is also incremented while the program waits for a key
; (#R$675A), mixed with R in the main loop ($60EB) and incremented by every
; evaluation ($8807).
;
; O:B Random byte (0-127)
; O:A Same as B
@label=BOOK_RANDOM
c$7B89 LD A,R        ; B=R
 $7B8B LD B,A        ;
 $7B8C LD A,($BCCE)  ; A=($BCCE) XOR R (clears the carry flag)
 $7B8F XOR B         ;
 $7B90 RRA           ; Shift right; bit 7 becomes 0
 $7B91 LD ($BCCE),A  ; Store the new value of the accumulator
 $7B94 LD B,A        ; B=random byte
 $7B95 RET           ;

; Score every unscored move in a list by make/evaluate/unmake
;
; Each entry whose score byte is $FF is made, evaluated with #R$8400 and
; unmade; the evaluation (0 = illegal) becomes its score. The best score is
; kept in $BD19 and its entry in $BD1A; ties go to the later entry (>=
; comparison).
;
;   HL List header+3
;   E Number of moves in the list
; O:$BD19 Best score (0 if no legal move)
; O:$BD1A Address of the best entry
@label=S_SCOREMOVES
c$7B96 INC HL        ; Point HL at the first move entry
 $7B97 PUSH HL       ; {IX=first move entry
 $7B98 POP IX        ; }
 $7B9A XOR A         ; {Best score so far = 0
 $7B9B LD ($BD19),A  ; }
 $7B9E INC E         ; {Loop counter = count+1 (pre-decremented below)
 $7B9F LD A,E        ;
 $7BA0 LD ($BD0E),A  ; }
@label=S_SCORE_LOOP
*$7BA3 LD HL,$BD0E   ; {Count down the moves
 $7BA6 DEC (HL)      ; }
 $7BA7 RET Z         ; Return when all moves have been visited
 $7BA8 LD B,(IX+$00) ; Score byte of this move
 $7BAB INC B         ; Is it $FF (unscored)?
 $7BAC JR NZ,$7BC5   ; Skip moves already scored, searched or pruned
 $7BAE CALL $810F    ; Make the move
 $7BB1 CALL $8400    ; Evaluate the resulting position (0 = illegal)
 $7BB4 LD (IX+$00),A ; Store the evaluation as the move's score
 $7BB7 LD HL,$BD19   ; {Compare with the best score so far
 $7BBA CP (HL)       ; }
 $7BBB JR C,$7BC2    ; Lower: keep the old best
 $7BBD LD (HL),A     ; New best (or equal): record score
 $7BBE LD ($BD1A),IX ; ...and the entry address
@label=S_SCORE_UNMAKE
*$7BC2 CALL $821C    ; Unmake the move
@label=S_SCORE_NEXT
*$7BC5 LD BC,$0004   ; {Advance IX to the next entry
 $7BC8 ADD IX,BC     ; }
 $7BCA JP $7BA3      ; Loop

; Find a move in a list by its squares
;
; Scans B entries starting with the entry after the one HL points into. A is
; compared with the to-square (+2) and A' with the from-square (+1).
;
;   HL Address of byte +2 of the entry before the first to test
;   B Number of entries to test
;   A To-square
;   A' From-square
; O:F Carry clear and Z set if found; carry set if not found
; O:HL Found: byte +1 of the matching entry. Not found: byte +2 of the last
; .    entry tested
@label=S_FINDMOVE
c$7BCD LD DE,$0004   ; Entry stride
@label=S_FIND_LOOP
*$7BD0 ADD HL,DE     ; Next entry's to-square
 $7BD1 CP (HL)       ; Does the to-square match?
 $7BD2 JR Z,$7BD8    ; Yes: check the from-square
@label=S_FIND_NEXT
*$7BD4 DJNZ $7BD0    ; Loop over B entries
 $7BD6 SCF           ; Not found
 $7BD7 RET           ; Return with carry set
@label=S_FIND_CHKFROM
*$7BD8 EX AF,AF'     ; A=from-square
 $7BD9 DEC L         ; Point at byte +1
 $7BDA CP (HL)       ; Does the from-square match?
 $7BDB RET Z         ; Yes: return with HL at byte +1
 $7BDC INC L         ; Restore HL to byte +2
 $7BDD EX AF,AF'     ; A=to-square again
 $7BDE JP $7BD4      ; Continue the scan

; Think: compute the computer's move
;
; Calls the pre-search set-up #R$7810, then one search pass (#R$7BF1). Levels
; whose search parameter $BCBD is 5-7 set $BD6E during the first pass, which
; makes a second pass run here.
;
; O:$BD29 Address of the chosen root move entry
; O:F Carry set if there is no legal move (via #R$7BEE)
@label=S_THINK
c$7BE1 CALL $7810    ; Pre-search set-up (phase flags, material balance, etc.)
@label=S_THINK_PASS
*$7BE4 CALL $7BF1    ; Run one search pass
 $7BE7 LD A,($BD6E)  ; {Is a second pass pending?
 $7BEA OR A          ; }
 $7BEB JR NZ,$7BE4   ; Yes: run it
 $7BED RET           ; Done
; This entry point is used by the routine at #R$7BF1.
@label=S_THINK_NOMOVE
*$7BEE POP HL        ; No legal move: discard the return address into
                     ; #R$7BE1...
 $7BEF SCF           ; ...and return to its caller with carry set
 $7BF0 RET           ; Return

; One search pass from the root
;
; Initialises the per-search tables, generates and statically scores the root
; moves, probes the opening book, sets the depth and pruning parameters from
; the level, applies next-best exclusions and the repetition rule, then enters
; the search loop at the best statically-scored root move. The search loop
; exits by returning to #R$7BE4.
;
; O:$BD29 Address of the chosen root move entry
@label=S_PASS
c$7BF1 LD IX,$BD58           ; IX=root "move" record (last game move)
 $7BF5 LD HL,$BC91           ; Killer table $BC91-$BC9D
 $7BF8 LD A,$FF              ; Fill with $FF (no killer)
 $7BFA LD ($BD0C),A          ; Shortest mate ply found so far = $FF
 $7BFD LD B,$0D              ; 13 bytes
@label=S_PASS_FILLFF
*$7BFF LD (HL),A             ; Fill the killer table
 $7C00 INC L                 ; Next byte
 $7C01 DJNZ $7BFF            ; Loop
 $7C03 INC A                 ; A=0
 $7C04 LD ($BD0D),A          ; Incremental material balance = 0
 $7C07 LD HL,$BC9F           ; Value table V(0)..V(8) at $BC9F-$BCA7
 $7C0A LD B,$09              ; 9 bytes
@label=S_PASS_FILL0
*$7C0C LD (HL),A             ; Zero the value table (V(1)=0 is -infinity)
 $7C0D INC L                 ; Next byte
 $7C0E DJNZ $7C0C            ; Loop
 $7C10 CALL $78CE            ; Generate the root moves (ply 1, list at $B400)
 $7C13 SET 5,(HL)            ; Mark the root list as scored
 $7C15 CALL $7B96            ; Score every root move statically
 $7C18 LD A,($BCDD)          ; Next-best mode?
 $7C1B OR A                  ; {Yes: skip the opening book
 $7C1C JR NZ,$7C2A           ; }
 $7C1E CALL $7AC7            ; Probe the opening book
 $7C21 JR NZ,$7C2A           ; NZ: no book move, so search
 $7C23 CALL $6734            ; Book move found: check the keyboard
 $7C26 RET Z                 ; No key: return with the book move in $BD29
 $7C27 JP $7562              ; Key pressed: leave demo mode (#R$7562) and
                             ; return with the book move
@label=S_PASS_SEARCH
*$7C2A LD A,($BD19)          ; Best static root score
 $7C2D OR A                  ; Zero means no legal move
 $7C2E JP Z,$7BEE            ; No legal root move: return carry set
 $7C31 LD D,A                ; D=best static root score
 $7C32 LD A,($BD6E)          ; Second pass of a two-pass level?
 $7C35 OR A                  ; {No: first pass
 $7C36 JR Z,$7C49            ; }
 $7C38 LD HL,($BD29)         ; Second pass: HL=first pass's chosen move
 $7C3B LD (HL),$FD           ; Give it score $FD so it is searched first
 $7C3D LD ($BD1A),HL         ; It is also the static best
 $7C40 XOR A                 ; {Clear the second-pass flag
 $7C41 LD ($BD6E),A          ; }
 $7C44 LD A,($BCBD)          ; A=search parameter of the level
 $7C47 JR $7C5B              ; Set the parameters
@label=S_PASS_FIRST
*$7C49 LD HL,($BD1A)         ; First pass: the static best move...
 $7C4C LD ($BD29),HL         ; ...is the move to play until the search finds
                             ; better
 $7C4F LD A,($BCBD)          ; A=search parameter of the level (0-7)
 $7C52 CP $05                ; Parameters 5-7 (Levels 6-8, P3)?
 $7C54 JR C,$7C5B            ; No: one pass with this parameter
 $7C56 LD A,$01              ; Yes: first pass uses parameter 1 (as Level 2)...
 $7C58 LD ($BD6E),A          ; ...and flag that a second pass will follow
@label=S_PASS_PARAMS
*$7C5B LD HL,$BDF6           ; Threat-extension switch $BDF6...
 $7C5E LD (HL),$00           ; ...defaults to 0 (off)
 $7C60 LD ($BD09),A          ; Pruning margin byte = parameter for now
 $7C63 BIT 1,A               ; Parameter bit 1 set (2, 3, 6, 7)?
 $7C65 JR Z,$7C71            ; No: extensions stay off
 $7C67 LD (HL),A             ; Yes: enable threat extensions ($BDF6=parameter)
 $7C68 BIT 0,A               ; Parameter bit 0 set too (3, 7)?
 $7C6A JR Z,$7C71            ; No: keep forward pruning
 $7C6C LD HL,$BD09           ; Yes: set bit 7 of $BD09...
 $7C6F SET 7,(HL)            ; ...which disables all forward pruning
@label=S_PASS_DEPTH
*$7C71 LD HL,$BCAA           ; Full-width depth D...
 $7C74 LD (HL),$01           ; ...is 1 for parameter 0
 $7C76 OR A                  ; Parameter 0?
 $7C77 JR Z,$7C83            ; Yes: D=1
 $7C79 INC (HL)              ; D=2
 $7C7A CP $04                ; Parameters 1-3?
 $7C7C JR C,$7C83            ; Yes: D=2
 $7C7E LD (HL),$03           ; D=3...
 $7C80 JR Z,$7C83            ; ...for parameter 4
 $7C82 INC (HL)              ; D=4 for parameters 5-7
@label=S_PASS_MARGIN
*$7C83 LD B,$07              ; Default margin base 7 (used when in check)
 $7C85 LD A,($BD09)          ; Forward pruning disabled?
 $7C88 RLA                   ; Bit 7 into carry
 $7C89 JR C,$7CBA            ; Yes: leave $BD09 as is
 $7C8B LD A,D                ; A=best static root score
 $7C8C LD HL,$B403           ; Root list header flags
 $7C8F BIT 7,(HL)            ; Side to move in check?
 $7C91 JR NZ,$7CB4           ; Yes: margin = 7+2
 $7C93 CALL $805F            ; Prune weak root moves; D=2*count minus moves
                             ; below best-9
 $7C96 SRL D                 ; D=D/4...
 $7C98 SRL D                 ; ...
 $7C9A DEC D                 ; ...-1...
 $7C9B SRL D                 ; .../2 (all unsigned)
 $7C9D LD B,$0B              ; Base 11...
 $7C9F LD A,($BD2D)          ; ...for deep endgame ($BD2D bit 4)
 $7CA2 BIT 4,A               ; Bit 4 set?
 $7CA4 JR NZ,$7CAE           ; Yes: base 11
 $7CA6 DEC B                 ; Base 10
 $7CA7 SRA A                 ; Phase bits >> 1
 $7CA9 DEC A                 ; Exactly bit 1 (past move 8, no endgame bit)?
 $7CAA JR NZ,$7CAE           ; No: base 10
 $7CAC DEC B                 ; Middlegame: base 8
 $7CAD DEC B                 ; ...
@label=S_MARGIN_LOOP
*$7CAE DEC D                 ; Count D down...
 $7CAF JP M,$7CB4            ; ...until it goes negative...
 $7CB2 DJNZ $7CAE            ; ...decrementing the base each time (stops at 0)
@label=S_MARGIN_SET
*$7CB4 LD A,$02              ; Margin = base + 2
 $7CB6 ADD A,B               ; ...
 $7CB7 LD ($BD09),A          ; Store the pruning margin
@label=S_PASS_EXCLUDE
*$7CBA LD HL,$BF00           ; Next-best exclusion list (from,to pairs,
                             ; $FF-terminated)
@label=S_EXCL_LOOP
*$7CBD LD A,(HL)             ; From-square of the next pair
 $7CBE CP $FF                ; End of list?
 $7CC0 JR Z,$7CD5            ; Yes: done
 $7CC2 INC HL                ; Point at the to-square
 $7CC3 EX AF,AF'             ; A'=from-square
 $7CC4 LD A,(HL)             ; A=to-square
 $7CC5 INC HL                ; Next pair
 $7CC6 PUSH HL               ; Save the list pointer
 $7CC7 LD HL,$B401           ; Root list header+1
 $7CCA LD B,(HL)             ; B=number of root moves
 $7CCB INC L                 ; HL=header+2
 $7CCC CALL $7BCD            ; Find the move (assumed present: see
                             ; 30-search.md)
 $7CCF DEC L                 ; Point at its score byte
 $7CD0 LD (HL),$00           ; Exclude it (score 0)
 $7CD2 POP HL                ; Restore the list pointer
 $7CD3 JR $7CBD              ; Next pair
@label=S_PASS_FIRSTMOVE
*$7CD5 LD HL,$B403           ; Root list header+3
 $7CD8 CALL $8015            ; Pick the best-scored remaining root move
 $7CDB BIT 0,E               ; Odd E: none left (every move excluded)
 $7CDD JR Z,$7D00            ; Found one: continue
 $7CDF CALL $740E            ; Print the message
 $7CE2 DEFM "*NO MORE MOVES" ; "*NO MORE MOVES"
 $7CF0 DEFB $AA              ; Last character (bit 7 set)
 $7CF1 CALL $6FB0            ; Beep
 $7CF4 DEFB $FF,$40          ; Inline arguments: duration, pitch
 $7CF6 CALL $6FAA            ; Clear the exclusion list
 $7CF9 CALL $704D            ; Clear the message line
 $7CFC POP HL                ; Discard the return address into #R$7BE1
 $7CFD JP $7BE1              ; Think again from scratch without exclusions
@label=S_PASS_REPCHK
*$7D00 LD ($BD1A),DE         ; $BD1A=first root move to search
 $7D04 LD A,($BD5E)          ; Consecutive reversing-move counter
 $7D07 LD C,A                ; C=counter
 $7D08 CP $02                ; Fewer than 2?
 $7D0A JP C,$7DCF            ; Yes: start searching the first root move
 $7D0D LD HL,($BD5C)         ; L=to, H=from of the move that undoes our last
                             ; move
 $7D10 LD A,H                ; A'=from-square
 $7D11 EX AF,AF'             ; ...
 $7D12 LD A,L                ; A=to-square
 $7D13 LD HL,$B401           ; Root list header+1
 $7D16 LD B,(HL)             ; B=number of root moves
 $7D17 INC L                 ; HL=header+2
 $7D18 CALL $7BCD            ; Find the repeating move
 $7D1B DEC L                 ; Point at its score byte
 $7D1C LD A,(HL)             ; Already excluded?
 $7D1D OR A                  ; ...
 $7D1E JP Z,$7DCF            ; Yes: search normally
 $7D21 LD (HL),$00           ; Take it out of the move ordering
 $7D23 LD A,($BD2D)          ; Draw value: material term $BD2E, sign by side to
                             ; move
 $7D26 RRA                   ; Bit 0 into carry
 $7D27 LD A,($BD2E)          ; A=$BD2E
 $7D2A JR NC,$7D2E           ; Side bit clear: keep the sign
 $7D2C NEG                   ; Negate
@label=S_REP_DRAWVAL
*$7D2E ADD A,$7E             ; Draw value = +-$BD2E + $7E
 $7D30 BIT 2,C               ; Counter is 4 or 5?
 $7D32 JR Z,$7D36            ; No
 $7D34 SUB $08               ; Yes: draw is 8 points less attractive
@label=S_REP_SET
*$7D36 LD ($BCA0),A          ; Root alpha V(1)=draw value
 $7D39 LD ($BD2B),HL         ; The repeating move is the current best root move
 $7D3C JP $7E9B              ; Record it in $BD29 and start the search loop

; Unused
;
; Not referenced from anywhere.
@label=S_UNUSED_7D3F
c$7D3F LD ($BCA0),A  ; Store A in V(1)
 $7D42 RET           ; Return

; Enter a new node: generate its moves and try the killer move
;
; Reached by jumping from #R$7E0A after a move has been made and the ply
; incremented. #R$78BA polls the keyboard (unless the abort flag is already
; set) and falls into the move generator #R$78CE. If the move leading here has
; flag bit 2 set, the recapture on its to-square is tried first (#R$802B);
; otherwise, unless the side to move is in check, the killer move for this ply
; is tried first.
;
; IX Entry of the move that led to this node
@label=S_NODE
c$7D43 CALL $78BA     ; Poll keyboard; generate the moves for ply p
 $7D46 LD A,E         ; E=number of moves
 $7D47 OR A           ; Any?
 $7D48 JR Z,$7DA8     ; No: go straight to the move loop
 $7D4A LD A,($BCA9)   ; A=p
 $7D4D LD B,E         ; B=number of moves
 $7D4E BIT 2,(IX+$03) ; Did the last move threaten a recapture (flag bit 2)?
 $7D52 JP NZ,$802B    ; Yes: try the recapture first
 $7D55 BIT 7,(HL)     ; Side to move in check?
 $7D57 JR NZ,$7DA8    ; Yes: no killer
 $7D59 DEC A          ; A=p-1
 $7D5A LD DE,$BC91    ; Killer table
 $7D5D ADD A,A        ; A=2(p-1)
 $7D5E ADD A,E        ; ...
 $7D5F LD E,A         ; DE=killer(p)
 $7D60 LD A,(DE)      ; From-square of the killer
 $7D61 OR A           ; Bit 7 set means no killer
 $7D62 JP M,$7DA8     ; No killer: go to the move loop
 $7D65 INC E          ; Point at its to-square
 $7D66 EX AF,AF'      ; A'=from-square
 $7D67 LD A,(DE)      ; A=to-square
 $7D68 DEC L          ; HL=header+2
 $7D69 CALL $7BCD     ; Is the killer in this list?
 $7D6C JR C,$7DA8     ; No: go to the move loop
 $7D6E DEC L          ; Point at its score byte
 $7D6F LD (HL),$00    ; Mark it searched
 $7D71 PUSH HL        ; IX=killer entry
 $7D72 POP IX         ; ...
 $7D74 CALL $810F     ; Make the killer move
; This entry point is used by the routine at #R$802B.
@label=S_NODE_EVAL
*$7D77 CALL $8400     ; Evaluate the position after the move
 $7D7A OR A           ; Illegal?
 $7D7B JR Z,$7DA5     ; Yes: unmake and go to the move loop
 $7D7D LD C,A         ; C=evaluation
 $7D7E EX AF,AF'      ; A'=evaluation
 $7D7F LD HL,$BCAA    ; A=D
 $7D82 LD A,(HL)      ; ...
 $7D83 DEC L          ; ...
 $7D84 LD B,(HL)      ; B=p
 $7D85 CP B           ; Beyond the full-width depth?
 $7D86 JP C,$7F20     ; Yes: treat as a selective node
 $7D89 CALL Z,$80C4   ; At the depth (D=p): futility test, may fail high
 $7D8C CALL $8003     ; HL=header+3 of this ply's list
 $7D8F SET 6,(HL)     ; Mark the killer as searched
 $7D91 EX AF,AF'      ; A=evaluation
 $7D92 DEC L          ; HL=header+2
 $7D93 LD (HL),A      ; Record the killer's evaluation in the header
 $7D94 BIT 1,(IX+$03) ; Move flag bit 1 (threat)?
 $7D98 JP Z,$7DEE     ; No: search the killer now
 $7D9B BIT 3,(IX+$03) ; Capture?
 $7D9F JP NZ,$7DEE    ; Yes: search the killer now
 $7DA2 LD (IX+$00),A  ; Quiet threat: give it its evaluation as score; it is
                      ; ordered later
@label=S_NODE_UNDO
*$7DA5 CALL $821C     ; Unmake it

; Choose the next move at the current node
;
; At plies up to the full-width depth: the first visit scores every move
; statically (#R$7B96), detects mate/stalemate, applies forward pruning
; (#R$805F) and searches the static best; later visits take the highest-scored
; remaining move (#R$8015). Beyond the depth, control passes to the selective
; move loop at #R$7EE4.
@label=S_NEXTMOVE
c$7DA8 LD HL,$BCAA     ; A=D
 $7DAB LD A,(HL)       ; ...
 $7DAC DEC L           ; HL=$BCA9
 $7DAD CP (HL)         ; Compare D with p
 $7DAE JP C,$7EE4      ; p>D: selective node
 $7DB1 CALL $8006      ; B=p, HL=header+3, E=count, C=header+2
 $7DB4 BIT 5,(HL)      ; Moves already scored?
 $7DB6 JP NZ,$7DDA     ; Yes: take the next best
 $7DB9 SET 5,(HL)      ; Mark the list scored
 $7DBB PUSH HL         ; Save HL
 $7DBC CALL $7B96      ; Score every unscored move
 $7DBF POP HL          ; Restore HL
 $7DC0 LD A,($BD19)    ; Best static score
 $7DC3 OR A            ; Zero: no legal move (except perhaps the killer)
 $7DC4 JP Z,$7FEA      ; Handle mate/stalemate
 $7DC7 BIT 7,(HL)      ; In check?
 $7DC9 JP NZ,$80E2     ; Yes: no pruning, search the static best
 $7DCC CALL $805F      ; Forward-prune weak moves (A=best static score)
; This entry point is used by the routine at #R$7BF1.
@label=S_PLAYBEST
*$7DCF LD IX,($BD1A)   ; IX=static best entry
 $7DD3 LD (IX+$00),$00 ; Mark it searched
 $7DD7 JP $7DEB        ; Make it and descend
@label=S_NEXT_SCORED
*$7DDA BIT 7,(HL)      ; In check?
 $7DDC JP NZ,$80ED     ; Yes: next move without recording it
 $7DDF CALL $8015      ; Pick the highest-scored remaining move
 $7DE2 BIT 0,E         ; Odd E: none left
 $7DE4 JR NZ,$7E25     ; Return to the parent
 $7DE6 PUSH DE         ; IX=chosen entry
 $7DE7 POP IX          ; ...
 $7DE9 XOR A           ; Mark it searched
 $7DEA LD (DE),A       ; ...
@label=S_DESCEND
*$7DEB CALL $810F      ; Make the move
; This entry point is used by the routines at #R$7D43, #R$7EDE and #R$7F43.
@label=S_DESCEND_MADE
*$7DEE LD A,($BCA9)    ; A=p
 $7DF1 DEC A           ; p-1
 $7DF2 JR Z,$7E06      ; Root: record the root move instead
 $7DF4 ADD A,A         ; 2(p-1)
 $7DF5 LD HL,$BC83     ; Current-move table
 $7DF8 ADD A,L         ; ...
 $7DF9 LD L,A          ; HL=curmove(p)
 $7DFA LD A,(IX+$01)   ; Record the from-square...
 $7DFD LD (HL),A       ; ...
 $7DFE INC L           ; ...
 $7DFF LD A,(IX+$02)   ; ...and the to-square
 $7E02 LD (HL),A       ; ...
 $7E03 JP $7E0A        ; Descend
; This entry point is used by the routine at #R$80C4.
@label=S_DESCEND_ROOT
*$7E06 LD ($BD2B),IX   ; $BD2B=root move being searched
; This entry point is used by the routine at #R$80C4.
@label=S_DESCEND_PLY
*$7E0A LD A,($BD2D)    ; Flip the side to move
 $7E0D XOR $01         ; ...
 $7E0F LD ($BD2D),A    ; ...
 $7E12 LD HL,$BCA9     ; Ply counter
 $7E15 LD A,(HL)       ; A=p
 $7E16 INC (HL)        ; p=p+1
 $7E17 DEC A           ; A=p-2
 $7E18 DEC A           ; ...
 $7E19 LD HL,$BCA0     ; Value table
 $7E1C ADD A,L         ; ...
 $7E1D LD L,A          ; HL=$BCA0+p-2 = V(p-1)
 $7E1E LD A,(HL)       ; A=V(p-1)
 $7E1F INC L           ; ...
 $7E20 INC L           ; HL=$BCA0+p = V(p+1)
 $7E21 LD (HL),A       ; The child starts with V(p+1)=V(p-1) (its alpha)
 $7E22 JP $7D43        ; Enter the new node

; Return from a node to its parent and back up the value
;
; Decrements the ply and unmakes the move that led to the finished node. If the
; abort flag ($BD4C bit 7) is set, keeps unwinding to the root without
; comparing values. Leaving ply 1 exits the search pass (RET to #R$7BE4).
; Otherwise the child's value is negated and compared: if it reaches the
; parent's beta it is a fail-high (#R$7E79); if it improves alpha, alpha is
; updated and the move becomes the killer for its ply (or the best root move at
; ply 1).
@label=S_RETURN
c$7E25 LD A,($BCA9)  ; A=p-1
 $7E28 DEC A         ; ...
 $7E29 RET Z         ; Leaving the root: the search pass is over
 $7E2A LD ($BCA9),A  ; Ply p-1
 $7E2D CALL $821C    ; Unmake the move that led to the finished node
 $7E30 LD A,($BD2D)  ; Flip the side to move
 $7E33 XOR $01       ; ...
 $7E35 LD ($BD2D),A  ; ...
 $7E38 LD A,($BD4C)  ; Abort flag (key pressed or move list full)?
 $7E3B RLA           ; Bit 7 into carry
 $7E3C JR C,$7E25    ; Set: keep unwinding
 $7E3E LD A,($BCA9)  ; A=p (the parent)
 $7E41 LD HL,$BCA0   ; Value table
 $7E44 ADD A,L       ; ...
 $7E45 LD L,A        ; HL=$BCA0+p = V(p+1), the child's value
 $7E46 LD A,(HL)     ; A=V(p+1)
 $7E47 NEG           ; Negate: value for the side to move at p
; This entry point is used by the routine at #R$7FD2.
@label=S_BACKUP
*$7E49 DEC L         ; HL=V(p-1) (minus beta of ply p)
 $7E4A DEC L         ; ...
 $7E4B CPL           ; ~A = value-1 in the parent's sign
 $7E4C CP (HL)       ; value >= beta?
 $7E4D JR C,$7E79    ; Yes: fail high at ply p
 $7E4F CPL           ; A=value again
 $7E50 INC L         ; HL=V(p), alpha
 $7E51 CP (HL)       ; Compare with alpha
 $7E52 JP C,$7DA8    ; Lower: no improvement
 $7E55 JP Z,$7DA8    ; Equal: no improvement
 $7E58 LD (HL),A     ; New alpha
 $7E59 LD A,($BCA9)  ; A=p-1
 $7E5C DEC A         ; ...
 $7E5D JR Z,$7E95    ; Root: new best root move
@label=S_KILLER
*$7E5F ADD A,A       ; A=2(p-1)
 $7E60 LD B,A        ; B=2(p-1)
 $7E61 LD HL,$BC91   ; Killer table
 $7E64 ADD A,L       ; ...
 $7E65 LD L,A        ; HL=killer(p)
 $7E66 LD DE,$BC83   ; Current-move table
 $7E69 LD A,B        ; ...
 $7E6A ADD A,E       ; ...
 $7E6B LD E,A        ; DE=curmove(p)
 $7E6C LD A,(DE)     ; From-square
 $7E6D OR A          ; Bit 7 set (not recorded, e.g. in-check node)?
 $7E6E JP M,$7DA8    ; Yes: no killer update
 $7E71 LD (HL),A     ; Killer from-square
 $7E72 INC E         ; ...
 $7E73 INC L         ; ...
 $7E74 LD A,(DE)     ; Killer to-square
 $7E75 LD (HL),A     ; ...
 $7E76 JP $7DA8      ; Continue with the next move at this ply
; This entry point is used by the routine at #R$80C4.
@label=S_FAILHIGH
*$7E79 CALL $821C    ; Fail high: unmake the move that led to this node
 $7E7C LD HL,$BCA9   ; ...
 $7E7F DEC (HL)      ; Back to the parent's ply
 $7E80 LD A,($BD2D)  ; Flip the side to move
 $7E83 XOR $01       ; ...
 $7E85 LD ($BD2D),A  ; ...
 $7E88 LD A,(HL)     ; A=new ply
 $7E89 JP $7E5F      ; The refutation becomes the killer of the node that
                     ; failed high

; Record the best root move
;
; Copies the root move being searched ($BD2B) to $BD29, the move to play. Also
; used as an exit: reached by JR from #R$7EA1 when a mate in one is found, its
; RET ends the search pass.
@label=S_SETBEST
c$7E8C LD IX,($BD2B) ; IX=root move being searched
 $7E90 LD ($BD29),IX ; It becomes the move to play
 $7E94 RET           ; Return
; This entry point is used by the routine at #R$7E25.
@label=S_ROOTBEST
*$7E95 LD A,($BCA0)  ; New root alpha V(1)
 $7E98 INC A         ; $FF means forced mate
 $7E99 JR Z,$7EA1    ; Mate: check its length
; This entry point is used by the routine at #R$7BF1.
@label=S_ROOTBEST_SET
*$7E9B CALL $7E8C    ; Record the best root move
 $7E9E JP $7DA8      ; Continue with the next root move
@label=S_ROOTMATE
*$7EA1 LD HL,$BD0B   ; Ply at which the mate was detected
 $7EA4 LD A,$FE      ; Lower root alpha to $FE so later mates can still be
                     ; compared
 $7EA6 LD ($BCA0),A  ; ...
 $7EA9 LD A,(HL)     ; A=mate ply
 $7EAA CP $02        ; Mate at ply 2 (mate in one)?
 $7EAC JR Z,$7E8C    ; Yes: record the move and end the search pass
 $7EAE INC L         ; $BD0C=shortest mate ply so far
 $7EAF CP (HL)       ; Not shorter?
 $7EB0 JP NC,$7DA8   ; Then keep the earlier move
 $7EB3 LD (HL),A     ; Shorter: remember the ply
 $7EB4 JR $7E9B      ; Record this root move

; Selective extension checks for small move lists
;
; Reached from #R$7F20 when the list of ply 4 starts in page $B4 (few moves
; generated along the current line). With D>=3, allows one extra ply (two if
; the ply-6 list also starts in page $B4), without the threat test of #R$7F27.
; The list addresses read here may be stale (left from earlier lines or
; searches).
@label=S_EXT_LISTS
c$7EB6 LD A,($BCB6)  ; High byte of slot(6)
 $7EB9 CP $B4        ; Ply-6 list in page $B4?
 $7EBB LD A,($BCAA)  ; A=D
 $7EBE JR Z,$7ED3    ; Yes: two-ply extension test
 $7EC0 CP $03        ; D<3?
 $7EC2 JR C,$7F27    ; Yes: normal test
 $7EC4 LD L,A        ; L=D
 $7EC5 LD A,($BCB3)  ; Low byte of slot(5)
 $7EC8 CP $58        ; Ply-5 list starts below $B458?
 $7ECA JR NC,$7F27   ; No: normal test
 $7ECC LD A,L        ; A=D
 $7ECD LD HL,$BCA9   ; HL=$BCA9
 $7ED0 JP $7F3E      ; Extend if p<=D+1
@label=S_EXT_DEEP
*$7ED3 CP $03        ; D<3?
 $7ED5 JR C,$7F27    ; Yes: normal test
 $7ED7 INC A         ; A=D+1
 $7ED8 LD HL,$BCA9   ; HL=$BCA9
 $7EDB JP $7F3E      ; Extend if p<=D+2

; Selective node: try the next move in generation order
;
; Used at plies beyond the full-width depth. Moves are taken in generation
; order, each made and evaluated statically; a value that fails high cuts off
; (#R$7F81), a better value raises alpha and becomes the killer. Selected moves
; descend further (#R$7F27, #R$7FAD). When the list is exhausted the node
; returns (#R$7E25).
@label=S_QUNDO
c$7EDE CALL $821C    ; Unmake the previous move
@label=S_QNEXT
*$7EE1 LD HL,$BCA9   ; Ply counter
; This entry point is used by the routine at #R$7DA8.
@label=S_QNEXT_HL
*$7EE4 LD A,(HL)     ; A=p
 $7EE5 ADD A,A       ; 2p
 $7EE6 ADD A,L       ; ...
 $7EE7 LD L,A        ; L=$A9+2p: slot(p)
 $7EE8 LD ($BD4E),A  ; $BD4E=slot offset (non-zero: "selective node")
 $7EEB LD E,(HL)     ; DE=header of this ply's list
 $7EEC INC L         ; ...
 $7EED LD D,(HL)     ; ...
 $7EEE EX DE,HL      ; HL=header
 $7EEF INC L         ; A=count
 $7EF0 LD A,(HL)     ; ...
 $7EF1 INC L         ; C=moves taken so far
 $7EF2 LD C,(HL)     ; ...
 $7EF3 SUB C         ; All taken?
 $7EF4 JP Z,$7E25    ; Yes: return to the parent
 $7EF7 INC (HL)      ; One more taken
 $7EF8 INC L         ; Header flags...
 $7EF9 LD A,(HL)     ; ...
 $7EFA LD ($BD4B),A  ; ...saved in $BD4B (bit 7: in check)
 $7EFD INC HL        ; HL=first entry
 $7EFE LD B,$00      ; BC=2*taken
 $7F00 SLA C         ; ...
 $7F02 RL B          ; ...
 $7F04 ADD HL,BC     ; HL=entry number 'taken'
 $7F05 ADD HL,BC     ; ...
 $7F06 INC (HL)      ; Score byte +1: $FF becomes 0 (marks it taken)
 $7F07 JR NZ,$7EE1   ; Already scored/searched: skip it
 $7F09 PUSH HL       ; IX=entry
 $7F0A POP IX        ; ...
 $7F0C CALL $810F    ; Make the move
 $7F0F CALL $8400    ; Evaluate
 $7F12 LD C,A        ; C=evaluation
 $7F13 OR A          ; Legal?
 $7F14 JR NZ,$7F20   ; Yes
 $7F16 LD A,($BD4B)  ; Illegal: header flags
 $7F19 INC C         ; C=1
 $7F1A RLA           ; In check?
 $7F1B JR C,$7F43    ; Yes: counts as value 2 (just above being mated)
 $7F1D JP $7EDE      ; No: ignore the move
; This entry point is used by the routine at #R$7D43.
@label=S_QEVAL
*$7F20 LD A,($BCB2)  ; High byte of slot(4)
 $7F23 CP $B4        ; Ply-4 list in page $B4?
 $7F25 JR Z,$7EB6    ; Yes: small-list extension tests
; This entry point is used by the routine at #R$7EB6.
@label=S_QEXTCHK
*$7F27 LD A,($BD4E)  ; $BD4E (set by the evaluation)
 $7F2A OR A          ; Zero?
 $7F2B JR Z,$7F39    ; Yes: extension test
 $7F2D LD A,(IX+$03) ; Move flags
 $7F30 OR A          ; Bit 7 clear?
 $7F31 JP P,$7F43    ; Yes: leaf
 $7F34 BIT 2,A       ; Bit 2 set?
 $7F36 JP NZ,$7F43   ; Yes: leaf
@label=S_QEXT1
*$7F39 LD HL,$BCAA   ; A=D
 $7F3C LD A,(HL)     ; ...
 $7F3D DEC L         ; HL=$BCA9
; This entry point is used by the routine at #R$7EB6.
@label=S_QEXT_CMP
*$7F3E INC A         ; Limit+1
 $7F3F CP (HL)       ; Compare with p
 $7F40 JP NC,$7DEE   ; p<=limit+1: search this move one ply deeper

; Selective node: back up a static value
;
; C holds the evaluation of the move just made (from the mover's point of view,
; offset by 1). Fail high if it reaches beta; otherwise raise alpha.
; Threatening moves (flags $42) may instead be searched deeper when $BDF6 is
; set.
;
; C Evaluation of the position after the move
; IX Entry of the move
@label=S_QLEAF
c$7F43 LD A,($BCA9)  ; A=p
 $7F46 LD HL,$BCA0   ; Value table
 $7F49 ADD A,L       ; ...
 $7F4A LD L,A        ; HL=$BCA0+p
 $7F4B INC C         ; value = evaluation+1
 $7F4C LD A,C        ; ...
 $7F4D DEC L         ; HL=V(p-1) (minus beta)
 $7F4E DEC L         ; ...
 $7F4F CPL           ; ~value
 $7F50 CP (HL)       ; value >= beta?
 $7F51 JR C,$7F81    ; Yes: fail high
 $7F53 INC L         ; HL=V(p) (alpha)
 $7F54 LD A,(IX+$03) ; Move flags
 $7F57 AND $42       ; Threat bits 1 or 6?
 $7F59 JR NZ,$7FAD   ; Yes: may extend
@label=S_QBEST
*$7F5B LD A,C        ; A=value
 $7F5C CP (HL)       ; Compare with alpha
 $7F5D JP C,$7EDE    ; Lower: next move
 $7F60 JP Z,$7EDE    ; Equal: next move
 $7F63 LD (HL),A     ; New alpha
 $7F64 LD A,($BD4B)  ; In-check node?
 $7F67 RLA           ; Bit 7 into carry
 $7F68 JP C,$7EDE    ; Yes: no killer update
 $7F6B LD A,($BCA9)  ; A=p
 $7F6E LD HL,$BC91   ; Killer table
 $7F71 DEC A         ; p-1
 $7F72 ADD A,A       ; ...
 $7F73 ADD A,L       ; ...
 $7F74 LD L,A        ; HL=killer(p)
 $7F75 LD A,(IX+$01) ; Killer from-square
 $7F78 LD (HL),A     ; ...
 $7F79 INC L         ; ...
 $7F7A LD A,(IX+$02) ; Killer to-square
 $7F7D LD (HL),A     ; ...
 $7F7E JP $7EDE      ; Next move
@label=S_QFAILHIGH
*$7F81 CALL $821C    ; Fail high: unmake the move just made...
 $7F84 CALL $821C    ; ...and the move that led to this node
 $7F87 LD A,($BD2D)  ; Flip the side to move
 $7F8A XOR $01       ; ...
 $7F8C LD ($BD2D),A  ; ...
 $7F8F LD HL,$BCA9   ; Ply counter
 $7F92 DEC (HL)      ; Back to the parent
 $7F93 LD A,($BD4B)  ; In-check node?
 $7F96 RLA           ; Bit 7 into carry
 $7F97 JP C,$7DA8    ; Yes: no killer update
 $7F9A LD A,(HL)     ; A=new ply q
 $7F9B LD HL,$BC91   ; Killer table
 $7F9E ADD A,A       ; 2q
 $7F9F ADD A,L       ; ...
 $7FA0 LD L,A        ; HL=killer(q+1)
 $7FA1 LD A,(IX+$01) ; The refutation's from-square
 $7FA4 LD (HL),A     ; ...
 $7FA5 INC L         ; ...
 $7FA6 LD A,(IX+$02) ; ...and to-square
 $7FA9 LD (HL),A     ; ...
 $7FAA JP $7DA8      ; Next move at the parent
@label=S_QTHREAT
*$7FAD LD A,($BCA9)  ; A=p
 $7FB0 LD B,A        ; B=p
 $7FB1 LD A,($BCAA)  ; A=D
 $7FB4 INC A         ; D+2
 $7FB5 INC A         ; ...
 $7FB6 CP B          ; p>D+2?
 $7FB7 JR C,$7F5B    ; Yes: plain leaf
 $7FB9 LD A,C        ; A=value
 $7FBA JR Z,$7FC0    ; p=D+2: use value as is
 $7FBC ADD A,$01     ; p<D+2: value+1
 $7FBE JR C,$7F5B    ; Overflow: plain leaf
@label=S_QTHREAT_CMP
*$7FC0 CP (HL)       ; Below alpha?
 $7FC1 JP C,$7EDE    ; Yes: next move
 $7FC4 LD A,($BDF6)  ; Threat extensions enabled?
 $7FC7 OR A          ; ...
 $7FC8 JR Z,$7F5B    ; No: plain leaf
 $7FCA LD A,C        ; A=value
 $7FCB CP $02        ; Value 2 (illegal move while in check)?
 $7FCD JR Z,$7F5B    ; Yes: plain leaf
 $7FCF JP $7DEE      ; Search this move one ply deeper

; No legal moves: stalemate or checkmate
;
; #R$7FEA is reached from #R$7DA8 when no move at a full-width node is legal.
; If the killer was legal the node simply returns. Not in check: the node's
; value is the stalemate draw value. In check: the value is 1 (mated) and the
; ply is recorded in $BD0B.
@label=S_STALEMATE
c$7FD2 LD A,($BCA9)  ; A=p
 $7FD5 LD HL,$BCA0   ; Value table
 $7FD8 ADD A,L       ; ...
 $7FD9 LD L,A        ; HL=$BCA0+p
 $7FDA LD A,($BD2D)  ; Side to move
 $7FDD RRA           ; Bit 0 into carry
 $7FDE LD A,($BD2E)  ; A=$BD2E (material term)
 $7FE1 JR NC,$7FE5   ; Side bit clear: keep the sign
 $7FE3 NEG           ; Negate
@label=S_STALEMATE_VAL
*$7FE5 ADD A,$78     ; Stalemate value = +-$BD2E + $78
 $7FE7 JP $7E49      ; Back it up as this node's value
; This entry point is used by the routine at #R$7DA8.
@label=S_NOMOVES
*$7FEA BIT 6,(HL)    ; Was the killer searched (so there was a legal move)?
 $7FEC JP NZ,$7E25   ; Yes: just return
 $7FEF BIT 7,(HL)    ; In check?
 $7FF1 JR Z,$7FD2    ; No: stalemate
 $7FF3 LD A,($BCA9)  ; A=p
 $7FF6 LD ($BD0B),A  ; Record the ply of the mate
 $7FF9 LD HL,$BCA0   ; Value table
 $7FFC ADD A,L       ; ...
 $7FFD LD L,A        ; HL=$BCA0+p
 $7FFE LD A,$01      ; Value 1: mated
 $8000 JP $7E49      ; Back it up as this node's value

; Get the current ply's list
;
; #R$8006 does the same for the ply counter at (HL).
;
; O:B Ply p
; O:HL Header+3 of ply p's list
; O:E Number of moves
; O:C Header byte +2
@label=S_PLYINFO
c$8003 LD HL,$BCA9   ; Ply counter

; Get the list of the ply at (HL)
;
; Used by the routine at #R$7DA8.
;
; HL $BCA9
@label=S_PLYINFO_HL
c$8006 LD A,(HL)     ; A=p
 $8007 LD B,A        ; B=p
 $8008 ADD A,A       ; 2p
 $8009 ADD A,L       ; ...
 $800A LD L,A        ; L=$A9+2p: slot(p)
 $800B LD E,(HL)     ; DE=header address
 $800C INC L         ; ...
 $800D LD D,(HL)     ; ...
 $800E EX DE,HL      ; HL=header
 $800F INC L         ; E=count
 $8010 LD E,(HL)     ; ...
 $8011 INC L         ; C=byte +2
 $8012 LD C,(HL)     ; ...
 $8013 INC L         ; HL=header+3
 $8014 RET           ; Return

; Pick the highest-scored remaining move
;
; Scans the list until the first entry with score $FF (the next list's header),
; keeping the first entry with the strictly highest score. Scores of 0
; (searched, pruned or illegal) are never picked.
;
;   HL Header+3
; O:DE Chosen entry
; O:E Bit 0 set if no move has a non-zero score
@label=S_PICKBEST
c$8015 XOR A         ; Best score so far = 0
 $8016 LD BC,$0004   ; Entry stride
 $8019 DEC L         ; HL=header+1
 $801A DEC L         ; ...
 $801B LD E,L        ; E odd: "nothing found"
 $801C DEC L         ; HL=header
@label=S_PICK_LOOP
*$801D ADD HL,BC     ; Next entry's score
 $801E CP (HL)       ; Not higher than the best?
 $801F JP NC,$801D   ; Skip it
 $8022 LD A,(HL)     ; New best score
 $8023 CP $FF        ; $FF: end of the list
 $8025 RET Z         ; Return
 $8026 LD D,H        ; DE=best entry
 $8027 LD E,L        ; ...
 $8028 JP $801D      ; Continue

; Try the recapture first
;
; Reached from #R$7D43 when the move leading to this node has flag bit 2 set.
; Searches the new list backwards for a move to the same square; if found it is
; searched first like a killer, but never recorded as one ($BD4B=$80).
;
; A Ply p
; B Number of moves
; IX Entry of the move leading here
@label=S_RECAPTURE
c$802B LD HL,$BCA9    ; Ply counter
 $802E INC A          ; p+1
 $802F ADD A,A        ; ...
 $8030 ADD A,L        ; ...
 $8031 LD L,A         ; L=slot(p+1): end of this list
 $8032 LD E,(HL)      ; HL=end of the list
 $8033 INC L          ; ...
 $8034 LD D,(HL)      ; ...
 $8035 EX DE,HL       ; ...
 $8036 INC L          ; HL=end+2
 $8037 INC L          ; ...
 $8038 LD DE,$FFFC    ; Stride -4
 $803B LD A,(IX+$02)  ; A=square the opponent moved to
@label=S_RECAP_LOOP
*$803E ADD HL,DE      ; Previous entry's to-square
 $803F CP (HL)        ; Same square?
 $8040 JR Z,$8047     ; Yes
 $8042 DJNZ $803E     ; Scan backwards
 $8044 JP $7DA8       ; No recapture: normal move loop
@label=S_RECAP_FOUND
*$8047 LD D,$01       ; (unused)
 $8049 DEC L          ; HL=score byte of the recapture
 $804A DEC L          ; ...
 $804B PUSH HL        ; IX=entry
 $804C POP IX         ; ...
 $804E LD (HL),$00    ; Mark it searched
 $8050 CALL $810F     ; Make the recapture
 $8053 SET 7,(IX+$01) ; Set bit 7 of its from-square (never matches as a
                      ; killer)
 $8057 LD A,$80       ; $BD4B bit 7: do not record as killer
 $8059 LD ($BD4B),A   ; ...
 $805C JP $7D77       ; Evaluate and handle like a killer

; Forward pruning of weak moves
;
; Called after static scoring at a full-width node, and at the root to compute
; the pruning margin. Threshold C = max(best static score, killer evaluation) -
; 9; moves scoring below it may get score 0 (never searched) through #R$80A2,
; #R$80BB or #R$80A7, unless their flags include any of bits 7, 6, 3 or 0
; ($C9). Disabled when $BD09 bit 7 is set.
;
;   A Best static score of the node
; O:D Plies 1-2 only: 2*count minus the number of moves below the threshold
@label=S_PRUNE
c$805F LD HL,$BD09   ; Pruning disabled?
 $8062 BIT 7,(HL)    ; ...
 $8064 RET NZ        ; Yes
 $8065 LD IY,$80A2   ; Default test routine
 $8069 EX AF,AF'     ; A'=best score
 $806A CALL $8003    ; B=p, HL=header+3, E=count, C=header+2
 $806D LD A,B        ; A=p
 $806E CP $03        ; Ply 3 or deeper?
 $8070 LD A,($BD2D)  ; A=phase flags
 $8073 JR NC,$807A   ; Yes: test depends on the phase
 $8075 LD A,E        ; Plies 1-2: D=2*count
 $8076 ADD A,A       ; ...
 $8077 LD D,A        ; ...
 $8078 LD A,$10      ; ...and the lenient test
@label=S_PRUNE_SEL
*$807A LD B,E        ; B=count
 $807B BIT 4,A       ; Deep endgame (or plies 1-2)?
 $807D JR Z,$8083    ; No
 $807F LD IY,$80BB   ; Lenient test
@label=S_PRUNE_SEL2
*$8083 BIT 3,A       ; Endgame bit 3?
 $8085 JR Z,$808B    ; No
 $8087 LD IY,$80A7   ; Strict test
@label=S_PRUNE_THR
*$808B EX AF,AF'     ; A=best score
 $808C CP C          ; Killer evaluation higher?
 $808D JR NC,$8090   ; No
 $808F LD A,C        ; Use it
@label=S_PRUNE_C
*$8090 SUB $09       ; Threshold = best-9
 $8092 RET C         ; Below 9: no pruning
 $8093 LD C,A        ; C=threshold
 $8094 INC HL        ; HL=first entry
@label=S_PRUNE_LOOP
*$8095 LD A,(HL)     ; A=score
 $8096 INC L         ; HL=flags byte
 $8097 INC L         ; ...
 $8098 INC L         ; ...
 $8099 SUB C         ; Below the threshold?
 $809A JR C,$80A0    ; Yes: apply the test
; This entry point is used by the routine at #R$80A7.
@label=S_PRUNE_NEXT
*$809C INC HL        ; Next entry
 $809D DJNZ $8095    ; Loop over the moves
 $809F RET           ; Return
@label=S_PRUNE_TEST
*$80A0 JP (IY)       ; Jump to the selected test (A=score-threshold)

; Forward pruning test: default
;
; Within 16 of the threshold: prune only if flag bit 2 is set (#R$80A7).
; Further below: prune (#R$80AB). In both cases moves with any of flags $C9 are
; kept. The comparison is done modulo 256.
;
; A Score minus threshold
; HL Flags byte of the entry
@label=S_PRUNE_NEAR
c$80A2 ADD A,$10     ; A+16
 $80A4 JP M,$80AB    ; Negative: more than 16 below, prune

; Move-list pruning: test a low-scored move (jump target of #R$805F)
;
; Part of the pruning loop in #R$805F, which reaches this code by JP (IY) when
; a move's score byte is below the threshold C, with A = score - C (negative)
; and HL pointing at the move's flags byte (+3). A pruned move gets score 0
; (treated as already searched) unless its flags AND $C9 is non-zero (check,
; bit 6, capture or pawn-to-6th/7th). The loop continues at #R$809C.
; .
; There are three variants, selected by IY in #R$805F. $80A2 (default; in the
; search file) prunes if score < C - 16, or if score < C and flags bit 2 is
; set. $80A7 (game-phase bit 3 of $BD2D set) prunes if score < C and flags bit
; 2 is set. $80BB (ply < 3 only; it also decrements D) prunes if score < C - 16
; and flags bit 2 is set. $80AB is the shared "prune unless flags AND $C9"
; step.
;
; A Score - threshold (negative)
; HL Address of the move's flags byte
@label=PRUNE_TEST
c$80A7 BIT 2,(HL)    ; {Flags bit 2 clear: keep the move
 $80A9 JR Z,$809C    ; }
; This entry point is used by the routine at #R$80A2.
@label=PRUNE_ZERO
*$80AB LD A,$C9      ; {Flags AND $C9 non-zero (check, bit 6, capture,
 $80AD AND (HL)      ; pawn-to-6th/7th): keep
 $80AE JR NZ,$809C   ; }
 $80B0 DEC L         ; {Otherwise set the score byte (+0) to 0: pruned
 $80B1 DEC L         ;
 $80B2 DEC L         ;
 $80B3 LD (HL),$00   ; }
 $80B5 INC L         ; {Back to the flags byte
 $80B6 INC L         ;
 $80B7 INC L         ; }
 $80B8 JP $809C      ; Next move
@label=PRUNE_ENDGAME
 $80BB DEC D         ; D = D - 1
 $80BC ADD A,$10     ; {Score >= threshold - 16: keep
 $80BE JP P,$809C    ; }
 $80C1 JP $80A7      ; Otherwise test flags bit 2 as at $80A7

; Search: cut-off test at the depth limit
;
; Called from #R$7D43 with A = ply when the ply equals the iteration depth
; ($BCAA). On even plies only: if $BD09 is not negative (bit 7 clear), and
; $BD09 < C (unsigned), and the 8-bit difference $BD09 - C is below the byte at
; $BC9E + ply (unsigned), and the current list header +3 bit 0 (parent was a
; pawn move to the 6th/7th rank) is clear, the move just made is unmade and the
; search returns to the previous ply via #R$7E79 (discarding this routine's
; return address). Search-subsystem semantics: see docs/arch for the search.
;
; A Ply
; C Score to compare
@label=HORIZON_CUT
c$80C4 BIT 0,A         ; {Odd ply: return
 $80C6 RET NZ          ; }
 $80C7 LD HL,$BC9E     ; {HL = $BC9E + ply
 $80CA ADD A,L         ;
 $80CB LD L,A          ; }
 $80CC LD A,($BD09)    ; {A = $BD09: negative means return
 $80CF OR A            ;
 $80D0 RET M           ; }
 $80D1 SUB C           ; {A = $BD09 - C: no borrow means return
 $80D2 RET NC          ; }
 $80D3 CP (HL)         ; {A >= ($BC9E + ply): return
 $80D4 RET NC          ; }
 $80D5 CALL $8003      ; HL = header +3 of the current list
 $80D8 BIT 0,(HL)      ; {Bit 0 set (parent pawn move to 6th/7th): return
 $80DA RET NZ          ; }
 $80DB POP HL          ; Discard the return address
 $80DC CALL $821C      ; Unmake the current move
 $80DF JP $7E79        ; Back up one ply
; Entry from #R$7D43: make the best root-scored move ($BD1A).
@label=SRCH_MAKE_BEST
*$80E2 LD IX,($BD1A)   ; IX = best move entry
 $80E6 LD (IX+$00),$00 ; Score byte = 0 (selected)
 $80EA JP $80FA        ; Make it and descend
; Entry from #R$7D43: select the highest-scored remaining move.
@label=SRCH_NEXT_MOVE
*$80ED CALL $8015      ; DE = first entry with the highest score (#R$8015)
 $80F0 BIT 0,E         ; {None left (E still odd): return from this ply
 $80F2 JP NZ,$7E25     ; }
 $80F5 PUSH DE         ; {IX = selected move
 $80F6 POP IX          ; }
 $80F8 XOR A           ; {Score byte = 0 (selected)
 $80F9 LD (DE),A       ; }
@label=SRCH_MAKE_DESCEND
*$80FA CALL $810F      ; Make the move
 $80FD LD A,($BCA9)    ; {Ply 1: remember the root move ($7E06)
 $8100 DEC A           ;
 $8101 JP Z,$7E06      ; }
 $8104 ADD A,A         ; {Otherwise set bit 7 of $BC83 + 2 * (ply - 1)
 $8105 LD HL,$BC83     ;
 $8108 ADD A,L         ;
 $8109 LD L,A          ;
 $810A SET 7,(HL)      ; }
 $810C JP $7E0A        ; Toggle the side and descend ($7E0A)

; Make a move
;
; Applies the move at IX (+1 from, +2 to, +3 flags) to the board ($BD00) and
; the piece records ($BE00). Pushes restore information under its return
; address, so the caller's stack grows by 4 bytes (quiet move) or 6 bytes
; (capture, en passant, castling). Each make must be undone by #R$821C before
; the caller returns. Returns via JP (HL) in the main register set; the
; alternate set is used throughout.
; .
; Stack frame (top first): [type byte, marker] then, for captures/en
; passant/castling, [square, piece code] of the captured pawn/piece or the
; castling rook, then [from-square, moving piece code]. The marker byte is
; popped into F by #R$821C: $80 quiet (S), $84 quiet promotion (S, P/V), $00
; capture, $04 capture-promotion (P/V), $01 en passant (C), $40 castling (Z).
; .
; Side effects: the type byte of the moving piece is updated (moved bit 4; pawn
; advancement nibble; promotion to $19; king centralisation bits 6-7 and
; castled bit 5). Captured piece: square byte bit 7 set. $BD0D (material
; balance, Black minus White, pawn units) is adjusted by captures and
; promotions. Flags bit 0 of the move is set for a pawn move to the 6th or 7th
; rank and cleared for a promotion. Castling with score byte +0 = $FF puts the
; KING's piece code (not the rook's) on the rook's destination square.
;
; IX Move entry
@label=MAKEMOVE
c$810F POP HL         ; HL = return address (kept in the main set)
 $8110 EXX            ; Work in the alternate set
 $8111 LD H,$BD       ; {HL = board[from]
 $8113 LD L,(IX+$01)  ; }
 $8116 LD E,(HL)      ; {E = moving piece code; D = from-square
 $8117 LD D,L         ; }
 $8118 PUSH DE        ; Push [from, piece]
 $8119 LD (HL),$00    ; board[from] = 0
 $811B LD L,(IX+$02)  ; {C = piece code on the to-square (0 if empty)
 $811E LD C,(HL)      ; }
 $811F LD (HL),E      ; board[to] = moving piece
 $8120 LD B,L         ; B = to-square
 $8121 INC H          ; {HL = moving piece's record ($BE00 + code AND $FB)
 $8122 RES 2,E        ;
 $8124 LD L,E         ; }
 $8125 LD (HL),B      ; Record square = to
 $8126 INC L          ; HL = record type byte
 $8127 LD E,D         ; E = from-square
 $8128 LD D,(HL)      ; D = old type byte (saved for unmake)
 $8129 LD A,$0F       ; {Value 0: king
 $812B AND D          ;
 $812C JP Z,$81BF     ; }
 $812F DEC A          ; {Value 1: pawn
 $8130 JR Z,$813D     ; }
 $8132 SET 4,(HL)     ; Other pieces: set the moved bit 4
 $8134 DEC C          ; {Something on the to-square: capture
 $8135 INC C          ;
 $8136 JR NZ,$81A5    ; }
@label=MK_QUIET
*$8138 LD E,$80       ; Marker $80: quiet move
@label=MK_PUSHRET
*$813A PUSH DE        ; Push [old type, marker]
 $813B EXX            ; {Return
 $813C JP (HL)        ; }
; Pawn move. A = relative rank of the to-square x 16 (from the mover's side).
@label=MK_PAWN
*$813D LD A,B         ; {A = to-square rank x 16
 $813E AND $70        ; }
 $8140 CP E           ; {Black (rank below the from-square): mirror the rank
 $8141 JR NC,$8145    ; (XOR $70)
 $8143 XOR $70        ; }
*$8145 SUB $30        ; {Relative rank < 3 (to 2nd/3rd rank): type unchanged
 $8147 JR C,$8184     ; }
 $8149 JR Z,$8181     ; Relative rank 3 (4th rank): type $11
 $814B SUB $10        ; {Relative rank 4 (5th rank): type $31
 $814D JR Z,$817F     ; }
 $814F SET 0,(IX+$03) ; Rank 6 or more: set flags bit 0 (pawn to 6th/7th)
 $8153 SUB $20        ; {Relative rank 5 (6th rank): type $61
 $8155 LD A,$61       ;
 $8157 JR C,$8183     ; }
 $8159 LD A,$91       ; {Relative rank 6 (7th rank): type $91
 $815B JR Z,$8183     ; }
; Promotion (always to a queen).
 $815D RES 0,(IX+$03) ; Clear flags bit 0
 $8161 LD (HL),$19    ; Type = $19 (queen, moved)
 $8163 LD A,($BD0D)   ; {$BD0D: -8 for White, +8 for Black (queen 9 - pawn 1)
 $8166 BIT 7,L        ;
 $8168 JR Z,$816C     ;
 $816A ADD A,$10      ;
*$816C SUB $08        ;
 $816E LD ($BD0D),A   ; }
 $8171 LD E,$84       ; Marker $84: quiet promotion
 $8173 BIT 3,(IX+$03) ; {No capture: push the marker and return
 $8177 JP Z,$813A     ; }
 $817A LD E,$04       ; {Marker $04: capture-promotion
 $817C JP $81A7       ; }
@label=MK_PAWN_TYPE
*$817F ADD A,$20      ; {A = $11 + $20 or $11 (type for the 5th or 4th rank)
*$8181 ADD A,$11      ; }
@label=MK_PAWN_SETTYPE
*$8183 LD (HL),A      ; Store the new pawn type byte
@label=MK_PAWN_FLAGS
*$8184 LD A,(IX+$03)  ; {Not a capture (flags bit 3 clear): quiet pawn move
 $8187 BIT 3,A        ;
 $8189 JP Z,$8138     ; }
 $818C BIT 5,A        ; {Capture without bit 5: ordinary capture
 $818E JP Z,$81A5     ; }
; En passant: remove the pawn behind the to-square.
 $8191 LD A,B         ; {Captured pawn square = to - 16 (White) or to + 16
 $8192 CP E           ; (Black)
 $8193 JR NC,$8197    ;
 $8195 ADD A,$20      ;
*$8197 SUB $10        ; }
 $8199 DEC H          ; {C = captured pawn code; board[that square] = 0
 $819A LD L,A         ;
 $819B LD C,(HL)      ;
 $819C LD (HL),$00    ; }
 $819E INC H          ; {B = captured pawn square
 $819F LD B,L         ; }
 $81A0 LD E,$01       ; {Marker $01: en passant
 $81A2 JP $81A7       ; }
@label=MK_CAPTURE
*$81A5 LD E,$00       ; Marker $00: capture
@label=MK_CAPTURE_X
*$81A7 PUSH BC        ; Push [captured square, captured code]
 $81A8 RES 2,C        ; {HL = captured piece record
 $81AA LD L,C         ; }
 $81AB SET 7,(HL)     ; Mark captured (square byte bit 7)
 $81AD PUSH DE        ; Push [old type, marker]
 $81AE INC L          ; {A = captured value; negated if the captured piece is
 $81AF LD A,$0F       ; Black
 $81B1 AND (HL)       ;
 $81B2 BIT 7,L        ;
 $81B4 JR Z,$81B8     ;
 $81B6 NEG            ; }
*$81B8 LD HL,$BD0D    ; {$BD0D = $BD0D + A
 $81BB ADD A,(HL)     ;
 $81BC LD (HL),A      ; }
 $81BD EXX            ; {Return
 $81BE JP (HL)        ; }
; King move.
@label=MK_KING
*$81BF CALL $8200     ; Update the king's type byte (moved, centralisation)
 $81C2 LD A,(IX+$03)  ; {Neither capture nor castling: quiet king move
 $81C5 AND $18        ;
 $81C7 JP Z,$8138     ; }
 $81CA AND $08        ; {King capture: ordinary capture
 $81CC JP NZ,$81A5    ; }
; Castling.
 $81CF SET 5,(HL)     ; Type byte bit 5: has castled
 $81D1 DEC H          ; HL = board page
 $81D2 BIT 2,B        ; {Queenside if to-square bit 2 is clear (c-file)
 $81D4 JR Z,$81E0     ; }
 $81D6 INC B          ; {Kingside: rook on to + 1; C = rook code; clear its
 $81D7 LD L,B         ; square
 $81D8 LD C,(HL)      ;
 $81D9 LD (HL),$00    ; }
 $81DB DEC L          ; {Rook destination = to - 1
 $81DC DEC L          ;
 $81DD JP $81E9       ; }
*$81E0 DEC B          ; {Queenside: rook on to - 2; C = rook code; clear its
 $81E1 DEC B          ; square
 $81E2 LD L,B         ;
 $81E3 LD C,(HL)      ;
 $81E4 LD (HL),$00    ; }
 $81E6 INC L          ; {Rook destination = to + 1
 $81E7 INC L          ;
 $81E8 INC L          ; }
@label=MK_CASTLE_ROOK
*$81E9 LD (HL),C      ; Rook to its destination
 $81EA LD A,(IX+$00)  ; {Score byte $FF: put the king's code there instead (C
 $81ED INC A          ; AND $84)
 $81EE JR NZ,$81F4    ;
 $81F0 LD A,$84       ;
 $81F2 AND C          ;
 $81F3 LD (HL),A      ; }
@label=MK_CASTLE_PUSH
*$81F4 PUSH BC        ; Push [rook origin, rook code]
 $81F5 RES 2,C        ; {Rook record square = destination
 $81F7 LD B,$BE       ;
 $81F9 LD A,L         ;
 $81FA LD (BC),A      ; }
 $81FB LD E,$40       ; Marker $40: castling
 $81FD PUSH DE        ; {Push [old type, marker] and return
 $81FE EXX            ;
 $81FF JP (HL)        ; }

; Set a king's type byte: moved bit and centralisation
;
; Sets the moved bit, clears bits 6-7, then adds $40 for each ring k = 1, 2, 3
; for which both to + $11k and to - $11k are on the board. This gives bits 6-7
; = min(file, rank, 7 - file, 7 - rank), capped at 3. #R$660A uses entry $8203
; when setting up a position.
;
; B King square
; D Old type byte
; HL Address of the king's type byte
@label=KINGTYPE
c$8200 LD A,D        ; {A = old type + moved bit
 $8201 OR $10        ; }
; This entry point is used by the routine at #R$660A.
@label=KINGTYPE_X
*$8203 AND $3F       ; Clear bits 6-7
 $8205 LD E,$11      ; E = $11 (diagonal step)
@label=KINGTYPE_LOOP
*$8207 LD (HL),A     ; Store the type byte
 $8208 LD A,B        ; {Square + E off the board: done
 $8209 ADD A,E       ;
 $820A AND $88       ;
 $820C RET NZ        ; }
 $820D LD A,B        ; {Square - E off the board: done
 $820E SUB E         ;
 $820F AND $88       ;
 $8211 RET NZ        ; }
 $8212 LD A,$11      ; {E = E + $11
 $8214 ADD A,E       ;
 $8215 LD E,A        ; }
 $8216 LD A,$40      ; {Type byte + $40
 $8218 ADD A,(HL)    ;
 $8219 JP $8207      ; }

; Unmake a move
;
; Undoes the most recent #R$810F using the data it pushed. The marker is popped
; into F: P/V set (promotion) reverses the $BD0D promotion adjustment; S set
; (quiet) restores only the mover; Z (castling) restores the rook; C (en
; passant) puts the captured pawn back on its square; otherwise (capture) the
; captured piece goes back on the to-square and its record is restored. The
; mover's square and type byte are restored from the frame.
@label=UNMAKE
c$821C POP HL        ; {HL = return address (kept in the main set)
 $821D EXX           ; }
 $821E POP AF        ; A = old type byte, F = marker
 $821F POP HL        ; HL = [square, code] of the captured piece/rook, or
                     ; [from, mover] for a quiet move
 $8220 LD C,A        ; C = old type byte
 $8221 LD A,$00      ; A = 0 (flags unchanged)
 $8223 LD D,$BD      ; D = board page
 $8225 CALL PE,$826E ; Promotion: undo the $BD0D adjustment
 $8228 JP M,$8247    ; Quiet move
 $822B JR Z,$825F    ; Castling
 $822D JR C,$8258    ; En passant
 $822F LD B,L        ; B = captured piece code
@label=UN_RESTORE_CAP
*$8230 RES 2,L       ; {HL = captured piece record; clear its captured bit
 $8232 LD H,$BE      ;
 $8234 RES 7,(HL)    ; }
 $8236 INC L         ; {A = its value, negated if the piece is White
 $8237 LD A,$0F      ;
 $8239 AND (HL)      ;
 $823A BIT 7,L       ;
 $823C JR NZ,$8240   ;
 $823E NEG           ; }
*$8240 LD HL,$BD0D   ; {$BD0D = $BD0D + A
 $8243 ADD A,(HL)    ;
 $8244 LD (HL),A     ; }
 $8245 LD A,B        ; A = code to put back on the to-square
@label=UN_POP_MOVER
*$8246 POP HL        ; HL = [from, mover]
@label=UN_RESTORE_MOVER
*$8247 LD E,H        ; {board[from] = mover
 $8248 EX DE,HL      ;
 $8249 LD (HL),E     ;
 $824A EX DE,HL      ; }
 $824B RES 2,L       ; {HL = mover's record; B = its square (the to-square)
 $824D LD H,$BE      ;
 $824F LD B,(HL)     ; }
 $8250 LD (HL),E     ; Record square = from
 $8251 INC L         ; {Record type = old type byte
 $8252 LD (HL),C     ; }
 $8253 LD L,B        ; {board[to] = A (captured code, or 0)
 $8254 DEC H         ;
 $8255 LD (HL),A     ; }
 $8256 EXX           ; {Return
 $8257 JP (HL)       ; }
@label=UN_EP
*$8258 LD E,H        ; En passant: board[captured square] = captured pawn
 $8259 LD B,A        ; {A = 0 for the to-square
 $825A LD A,L        ;
 $825B LD (DE),A     ; }
 $825C JP $8230      ; Restore the captured pawn's record and the mover
@label=UN_CASTLE
*$825F LD E,H        ; {Castling: board[rook origin] = rook
 $8260 LD A,L        ;
 $8261 LD (DE),A     ; }
 $8262 RES 2,L       ; {Rook record square = origin (B = destination)
 $8264 LD H,$BE      ;
 $8266 LD B,(HL)     ;
 $8267 LD (HL),E     ; }
 $8268 XOR A         ; {board[rook destination] = 0
 $8269 LD E,B        ;
 $826A LD (DE),A     ; }
 $826B JP $8246      ; Restore the king

; Undo the $BD0D promotion adjustment
;
; Adds 8 to $BD0D for a White promotion, or subtracts 8 for Black. The value S
; of the caller's flags tells this apart: S set means a quiet promotion, so L
; is the mover's code; S clear means a capture-promotion, so L is the captured
; piece's code and the colour test is reversed. Preserves F via EX AF,AF'.
;
; L Piece code (see above)
@label=UN_PROMO_FIX
c$826E JP P,$8282    ; {S clear (capture-promotion): reverse the colour test
 $8271 EX AF,AF'     ; }
 $8272 LD A,($BD0D)  ; A = $BD0D
 $8275 BIT 7,L       ; {Mover is White?
 $8277 JR Z,$827B    ; }
@label=UN_PROMO_SUB
*$8279 SUB $10       ; A = A - $10 (then + 8 = net -8 for Black)
@label=UN_PROMO_ADD
*$827B ADD A,$08     ; {A = A + 8
 $827D LD ($BD0D),A  ; }
 $8280 EX AF,AF'     ; {Restore flags
 $8281 RET           ; }
@label=UN_PROMO_CAP
*$8282 EX AF,AF'     ; {Capture-promotion: L is the captured piece (opposite
 $8283 LD A,($BD0D)  ; colour)
 $8286 BIT 7,L       ;
 $8288 JR NZ,$827B   ;
 $828A JR $8279      ; }

; Unused (zero bytes up to $8400)
s$828C DEFS $0174

; Evaluate the position after a move
;
; Static evaluation of the current position from the point of view of the side
; that has just moved (the side NOT to move in bit 0 of $BD2D). Called after
; every make-move in the search and at the root. It builds attack maps for both
; sides in the piece records (bytes +2..+5), scores mobility, development, pawn
; structure and king safety, runs a static exchange evaluation (SEE) on every
; attacked piece, and combines material change, threats, positional score and a
; small random term into one unsigned byte. See docs/arch/50-eval.md for the
; full specification.
; .
; Register conventions inside the evaluation: main H=$BD (board page), main D =
; off-board mask $88 (pawn direction $11/$F1 while scanning pawns), main E =
; positional accumulator, main B = square of the piece being scanned, main C =
; ray direction. A' = king/pawn accumulator. Alternate set: H'=$BE
; (piece-record page), L' = record pointer (a piece code points at record+4),
; C' = attack weight of the scanning piece (pawn 1, minor $04, rook $10, queen
; $40), E' = line mask ($08 orthogonal, $C4 diagonal), B' = pass flags (bit 7
; colour being scanned, bit 4 second pass, bit 5 pin list non-empty, bit 6
; check seen, bit 0..bit 3 game phase from $BD2D).
; .
; If the side to move can capture the enemy king (or the kings touch) the
; routine aborts through #R$8C28, which restores SP from $BD3D and returns A=0.
;
;   IX Move-list entry of the move just made (+2 to-square read, +3 flags
; .    updated)
; O:A Score: $80 = level, higher is better for the side that has just moved;
; .   $02/$FC on large material swings; 0 if the move was illegal
; O:B Positional component (signed, mover's view), used by #R$7810
@label=Evaluate
c$8400 LD ($BD3D),SP  ; Save SP so that #R$8C28 can abort from any depth
 $8404 XOR A          ; {A'=0 (king/pawn accumulator), E=0 (positional
 $8405 LD E,A         ; accumulator)
 $8406 EX AF,AF'      ; }
 $8407 LD H,$BD       ; H=$BD (board page)
 $8409 EXX            ; {H'=$BE (piece-record page)
 $840A LD H,$BE       ; }
 $840C LD A,($BD2D)   ; {A=side/phase flags rotated: bit 7=side to move
 $840F RRCA           ; (1=White), bit 0..bit 3=phase bits}
 $8410 LD IY,$8A7A    ; IY=pawn routine: #R$8A7A normally,
 $8414 BIT 1,A        ; {#R$8A6F when total material is below $34,
 $8416 JR Z,$8424     ;
 $8418 LD IY,$8A6F    ; }
 $841C BIT 2,A        ; {#R$8A2B when it is below $28
 $841E JR Z,$8424     ;
 $8420 LD IY,$8A2B    ; }
*$8424 ADD A,$80      ; {B'=pass flags: bit 7=colour scanned first (side to
 $8426 LD B,A         ; move), Carry=side to move is White}
 $8427 EXX            ; Back to the main set
 $8428 JP C,$883A     ; White to move: scan White first (#R$883A)
; Scan Black's pieces (queen, rooks, bishops, knights, then pawns),
; accumulating attacks in the records and positional score in E/A'.
@label=EvBlackPieces
*$842B LD D,$88       ; D=$88 (off-board mask)
 $842D LD A,($BE88)   ; {Black queen (if not captured)
 $8430 OR A           ;
 $8431 CALL P,$8C43   ; }
 $8434 LD A,($BE90)   ; {Black rooks
 $8437 OR A           ;
 $8438 CALL P,$8C4E   ;
 $843B LD A,($BE98)   ;
 $843E OR A           ;
 $843F CALL P,$8C4E   ; }
 $8442 LD A,($BEA0)   ; {Black bishops
 $8445 OR A           ;
 $8446 CALL P,$8D80   ;
 $8449 LD A,($BEA8)   ;
 $844C OR A           ;
 $844D CALL P,$8D80   ; }
 $8450 LD A,($BEB0)   ; {Black knights
 $8453 OR A           ;
 $8454 CALL P,$8CBB   ;
 $8457 LD A,($BEB8)   ;
 $845A OR A           ;
 $845B CALL P,$8CBB   ; }
 $845E LD D,$F1       ; {D=$F1 (black pawns attack down the board); B=C=$FF (no
 $8460 LD BC,$FFFF    ; previous pawn files)}
 $8463 LD HL,($BEC0)  ; {Black pawns a..h (records $BEC0..$BEF8; the d- and
 $8466 BIT 7,L        ; e-pawn records use #R$8A54)
 $8468 CALL Z,$8A5B   ;
 $846B LD HL,($BEC8)  ;
 $846E BIT 7,L        ;
 $8470 CALL Z,$8A5B   ;
 $8473 LD HL,($BED0)  ;
 $8476 BIT 7,L        ;
 $8478 CALL Z,$8A5B   ;
 $847B LD HL,($BED8)  ;
 $847E BIT 7,L        ;
 $8480 CALL Z,$8A54   ;
 $8483 LD HL,($BEE0)  ;
 $8486 BIT 7,L        ;
 $8488 CALL Z,$8A54   ;
 $848B LD HL,($BEE8)  ;
 $848E BIT 7,L        ;
 $8490 CALL Z,$8A5B   ;
 $8493 LD HL,($BEF0)  ;
 $8496 BIT 7,L        ;
 $8498 CALL Z,$8A5B   ;
 $849B LD HL,($BEF8)  ;
 $849E BIT 7,L        ;
 $84A0 CALL Z,$8A5B   ; }
 $84A3 EXX            ; Second pass done?
 $84A4 BIT 4,B        ; {No: switch colour and scan White (#R$882C)
 $84A6 JP Z,$882C     ; }
; Both sides scanned. Finish the positional score, then evaluate exchanges on
; every attacked piece.
@label=EvScoreExchanges
*$84A9 BIT 6,B        ; {Skip if a check was seen (bit 6 of B')
 $84AB JR NZ,$84BA    ; }
 $84AD LD L,(IX+$02)  ; {L=piece code on the move's to-square
 $84B0 DEC H          ;
 $84B1 LD L,(HL)      ;
 $84B2 INC H          ; }
 $84B3 BIT 2,L        ; {If a piece stands there,
 $84B5 JR Z,$84BA     ; }
 $84B7 INC L          ; {set bit 1 of its record +5 ('moved piece' marker for
 $84B8 SET 1,(HL)     ; the SEE penalty)}
*$84BA BIT 3,B        ; {Late endgame (bit 3 of B')?
 $84BC JP Z,$84CB     ; }
 $84BF EXX            ; {Yes: halve E, or quarter it if there are no pawns
 $84C0 LD A,($BD6D)   ; ($BD6D=0)
 $84C3 OR A           ;
 $84C4 JR NZ,$84C8    ;
 $84C6 SRA E          ;
*$84C8 SRA E          ;
 $84CA EXX            ; }
*$84CB BIT 5,B        ; Pin list non-empty (bit 5 of B')?
 $84CD EXX            ; {If so, remove the pinned pieces' illegal attacks
 $84CE CALL NZ,$8E74  ; (#R$8E74)}
 $84D1 LD HL,$BD4A    ; {E = A'/4 + E + $BD4A (positional score, Black's view)
 $84D4 EX AF,AF'      ;
 $84D5 SRA A          ;
 $84D7 SRA A          ;
 $84D9 ADD A,E        ;
 $84DA ADD A,(HL)     ;
 $84DB LD E,A         ; }
 $84DC LD HL,$0000    ; {$BD39/$BD3A = 0 (best and second-best SEE gain), save
 $84DF LD ($BD39),HL  ; IX in $BD3B
 $84E2 LD ($BD3B),IX  ; }
 $84E6 LD HL,($BE8A)  ; {Black queen: if attacked (+2/+3 non-zero), SEE with
 $84E9 LD A,H         ; value 9; clear its attack bytes
 $84EA OR L           ;
 $84EB JR Z,$84F9     ;
 $84ED LD BC,($BE8C)  ;
 $84F1 LD A,$09       ;
 $84F3 CALL $8AD6     ;
 $84F6 LD ($BE8A),HL  ;
*$84F9 LD ($BE8C),HL  ; }
 $84FC LD HL,($BE92)  ; {Black rook (a): SEE with value 5
 $84FF LD A,H         ;
 $8500 OR L           ;
 $8501 JR Z,$850F     ;
 $8503 LD BC,($BE94)  ;
 $8507 LD A,$05       ;
 $8509 CALL $8AD6     ;
 $850C LD ($BE92),HL  ;
*$850F LD ($BE94),HL  ; }
 $8512 LD HL,($BE9A)  ; {Black rook (h): SEE with value 5
 $8515 LD A,H         ;
 $8516 OR L           ;
 $8517 JR Z,$8525     ;
 $8519 LD BC,($BE9C)  ;
 $851D LD A,$05       ;
 $851F CALL $8AD6     ;
 $8522 LD ($BE9A),HL  ;
*$8525 LD ($BE9C),HL  ; }
 $8528 LD HL,($BEA2)  ; {Black bishop (c): SEE with value 3
 $852B LD A,H         ;
 $852C OR L           ;
 $852D JR Z,$853B     ;
 $852F LD BC,($BEA4)  ;
 $8533 LD A,$03       ;
 $8535 CALL $8AD6     ;
 $8538 LD ($BEA2),HL  ;
*$853B LD ($BEA4),HL  ; }
 $853E LD HL,($BEAA)  ; {Black bishop (f): SEE with value 3
 $8541 LD A,H         ;
 $8542 OR L           ;
 $8543 JR Z,$8551     ;
 $8545 LD BC,($BEAC)  ;
 $8549 LD A,$03       ;
 $854B CALL $8AD6     ;
 $854E LD ($BEAA),HL  ;
*$8551 LD ($BEAC),HL  ; }
 $8554 LD HL,($BEB2)  ; {Black knight (b): SEE with value 3
 $8557 LD A,H         ;
 $8558 OR L           ;
 $8559 JR Z,$8567     ;
 $855B LD BC,($BEB4)  ;
 $855F LD A,$03       ;
 $8561 CALL $8AD6     ;
 $8564 LD ($BEB2),HL  ;
*$8567 LD ($BEB4),HL  ; }
 $856A LD HL,($BEBA)  ; {Black knight (g): SEE with value 3
 $856D LD A,H         ;
 $856E OR L           ;
 $856F JR Z,$857D     ;
 $8571 LD BC,($BEBC)  ;
 $8575 LD A,$03       ;
 $8577 CALL $8AD6     ;
 $857A LD ($BEBA),HL  ;
*$857D LD ($BEBC),HL  ; }
 $8580 LD HL,($BEC2)  ; {Black pawn records a..h: SEE with value = low nibble
 $8583 LD A,H         ; of the type byte (1, or the promoted piece's value)
 $8584 OR L           ;
 $8585 JR Z,$8594     ;
 $8587 LD BC,($BEC4)  ;
 $858B LD A,($BEC1)   ;
 $858E CALL $8AD4     ;
 $8591 LD ($BEC2),HL  ;
*$8594 LD ($BEC4),HL  ;
 $8597 LD HL,($BECA)  ;
 $859A LD A,H         ;
 $859B OR L           ;
 $859C JR Z,$85AB     ;
 $859E LD BC,($BECC)  ;
 $85A2 LD A,($BEC9)   ;
 $85A5 CALL $8AD4     ;
 $85A8 LD ($BECA),HL  ;
*$85AB LD ($BECC),HL  ;
 $85AE LD HL,($BED2)  ;
 $85B1 LD A,H         ;
 $85B2 OR L           ;
 $85B3 JR Z,$85C2     ;
 $85B5 LD BC,($BED4)  ;
 $85B9 LD A,($BED1)   ;
 $85BC CALL $8AD4     ;
 $85BF LD ($BED2),HL  ;
*$85C2 LD ($BED4),HL  ;
 $85C5 LD HL,($BEDA)  ;
 $85C8 LD A,H         ;
 $85C9 OR L           ;
 $85CA JR Z,$85D9     ;
 $85CC LD BC,($BEDC)  ;
 $85D0 LD A,($BED9)   ;
 $85D3 CALL $8AD4     ;
 $85D6 LD ($BEDA),HL  ;
*$85D9 LD ($BEDC),HL  ;
 $85DC LD HL,($BEE2)  ;
 $85DF LD A,H         ;
 $85E0 OR L           ;
 $85E1 JR Z,$85F0     ;
 $85E3 LD BC,($BEE4)  ;
 $85E7 LD A,($BEE1)   ;
 $85EA CALL $8AD4     ;
 $85ED LD ($BEE2),HL  ;
*$85F0 LD ($BEE4),HL  ;
 $85F3 LD HL,($BEEA)  ;
 $85F6 LD A,H         ;
 $85F7 OR L           ;
 $85F8 JR Z,$8607     ;
 $85FA LD BC,($BEEC)  ;
 $85FE LD A,($BEE9)   ;
 $8601 CALL $8AD4     ;
 $8604 LD ($BEEA),HL  ;
*$8607 LD ($BEEC),HL  ;
 $860A LD HL,($BEF2)  ;
 $860D LD A,H         ;
 $860E OR L           ;
 $860F JR Z,$861E     ;
 $8611 LD BC,($BEF4)  ;
 $8615 LD A,($BEF1)   ;
 $8618 CALL $8AD4     ;
 $861B LD ($BEF2),HL  ;
*$861E LD ($BEF4),HL  ;
