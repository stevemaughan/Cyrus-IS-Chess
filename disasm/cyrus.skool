; Printer text: Replay
t$6863 DEFM "Repla",$F9

; R: replay the whole game
;
; Entry #R$6876 is also used to print the move record (P then R).
@label=KeyReplay
c$6869 LD A,($C058)  ;
 $686C INC A         ;
 $686D JP Z,$6800    ;
 $6870 LD HL,$6863   ;
 $6873 CALL $743B    ;
; This entry point is used by the routine at #R$69C9.
@label=StartReplayAll
*$6876 CALL $7046    ; {Replay target $FFFF (to the end of the record), replay
 $6879 CALL $704D    ; mode on
 $687C CALL $73F7    ;
 $687F LD HL,($4552) ;
 $6882 LD D,B        ;
 $6883 LD C,H        ;
 $6884 LD B,C        ;
 $6885 LD E,C        ;
 $6886 LD C,C        ;
 $6887 LD C,(HL)     ;
 $6888 LD B,A        ;
 $6889 XOR D         ;
 $688A CALL $73AE    ;
 $688D LD A,$01      ;
 $688F LD ($BCC3),A  ;
 $6892 LD HL,$FFFF   ;
 $6895 JR $68B2      ; }

; Printer text: take-Back
t$6897 DEFM "take-Bac",$EB

; B: take back one ply
;
; Implemented by restoring the start position and replaying $C001 - 1 plies.
; Entry #R$68B2 restores the start position (new game, or the position saved at
; the end of set-up mode) and starts a replay to the ply count in HL.
@label=KeyTakeBack
c$68A0 LD HL,($C001) ;
 $68A3 LD A,L        ;
 $68A4 OR H          ;
 $68A5 JP Z,$6800    ;
 $68A8 LD HL,$6897   ;
 $68AB CALL $743B    ;
; This entry point is used by the routine at #R$69B3.
@label=TakeBackOnePly
*$68AE LD HL,($C001) ;
 $68B1 DEC HL        ;
; This entry point is used by the routines at #R$6869 and #R$6BCF.
@label=RestartAndReplay
*$68B2 LD ($C003),HL ; Replay target
 $68B5 LD A,($C006)  ; {Start move number; 1 = standard start: reinitialise via
 $68B8 LD ($BD49),A  ; #R$6505
 $68BB DEC A         ;
 $68BC JP Z,$60A4    ; }
 $68BF CALL $658E    ; {Set-up start: clear the board and restore the saved
 $68C2 LD A,($C005)  ; side to move and the 32 (square, value) pairs
 $68C5 LD ($BD2D),A  ;
 $68C8 AND $01       ;
 $68CA LD ($BCBE),A  ;
 $68CD LD DE,$C007   ;
 $68D0 LD HL,$BE00   ;
 $68D3 LD B,$20      ;
*$68D5 LD A,(DE)     ;
 $68D6 LD (HL),A     ;
 $68D7 INC HL        ;
 $68D8 INC DE        ;
 $68D9 LD A,(DE)     ;
 $68DA LD (HL),A     ;
 $68DB INC DE        ;
 $68DC LD A,L        ;
 $68DD ADD A,$07     ;
 $68DF LD L,A        ;
 $68E0 DJNZ $68D5    ; }
 $68E2 LD HL,$BE00   ; {Rebuild the board from the piece lists
 $68E5 LD DE,$BD00   ;
*$68E8 LD A,(HL)     ;
 $68E9 OR A          ;
 $68EA JP M,$68F2    ;
 $68ED LD E,A        ;
 $68EE LD A,L        ;
 $68EF OR $04        ;
 $68F1 LD (DE),A     ;
*$68F2 LD A,L        ;
 $68F3 ADD A,$08     ;
 $68F5 LD L,A        ;
 $68F6 JR NC,$68E8   ; }
 $68F8 CALL $6F99    ; Reset the 50-move counter, $BD0D and the
                     ; last-move/repetition data
 $68FB LD A,($BCDB)  ; {Printing the record: draw and print the start position
 $68FE OR A          ;
 $68FF JR Z,$6907    ;
 $6901 CALL $70DF    ;
 $6904 CALL $729D    ;
*$6907 JP $60A7      ; }

; Printer text: take-Forward
@label=TextTakeForward
t$690A DEFM "take-Forwar",$E4

; F: take forward one ply
;
; Replays the next recorded ply, if any.
@label=KeyForward
c$6916 LD HL,($C001) ;
 $6919 LD BC,$C058   ;
 $691C ADD HL,BC     ;
 $691D LD A,(HL)     ;
 $691E INC A         ;
 $691F JP Z,$6800    ;
 $6922 LD HL,$690A   ;
 $6925 CALL $743B    ;
 $6928 LD HL,($C001) ;
 $692B INC HL        ;
 $692C LD ($C003),HL ;
 $692F JP $60B7      ;

; L: next level
;
; Cycles the level index $BCCD through 0-10 (Levels 1-8, P1, P2, P3) and sets
; the search level $BCBD: Levels 1-8 -> 0-7, P1 -> 0, P2 -> 3, P3 -> 7. There
; is no time limit anywhere: a level is purely a search-size setting.
@label=KeyLevel
c$6932 LD A,($BCCD)  ; {$BCCD = (BCCD + 1) mod 11
 $6935 INC A         ;
 $6936 CP $0B        ;
 $6938 JR NZ,$693B   ;
 $693A XOR A         ;
*$693B LD ($BCCD),A  ; }
 $693E CP $08        ; {P1 -> 0, P2 -> 3, P3 -> 7, otherwise $BCBD = $BCCD
 $6940 JR NZ,$6946   ;
 $6942 LD A,$00      ;
 $6944 JR $6954      ;
*$6946 CP $09        ;
 $6948 JR NZ,$694E   ;
 $694A LD A,$03      ;
 $694C JR $6954      ;
*$694E CP $0A        ;
 $6950 JR NZ,$6954   ;
 $6952 LD A,$07      ;
*$6954 LD ($BCBD),A  ;
 $6957 CALL $737C    ;
 $695A JP $6800      ; }

; M: Cyrus takes over the side to move
;
; Entry #R$696A swaps the side Cyrus plays ($BCBE) and negates the score $BCA0,
; then continues the main loop.
@label=KeyMove
c$695D LD A,($BCBE)  ;
 $6960 OR A          ;
 $6961 LD A,$01      ;
 $6963 JR Z,$6967    ;
 $6965 LD A,$02      ;
*$6967 LD ($BCC2),A  ;
; This entry point is used by the routines at #R$6147 and #R$61C8.
@label=SwapSides
*$696A LD A,($BCBE)  ;
 $696D OR A          ;
 $696E LD A,$01      ;
 $6970 JR Z,$6973    ;
 $6972 XOR A         ;
*$6973 LD ($BCBE),A  ;
 $6976 LD HL,$BCA0   ;
 $6979 XOR A         ;
 $697A SUB (HL)      ;
 $697B LD (HL),A     ;
 $697C JP $60B7      ;

; G: new game
;
; Used by the routine at #R$6800.
@label=KeyNewGame
c$697F CALL $6985    ;
 $6982 JP $60B7      ;

; Ask NEW GAME? and start one on Y
;
; Used by the routines at #R$697F and #R$6D4D.
@label=AskNewGame
c$6985 CALL $704D      ;
 $6988 CALL $740E      ;
 $698B DEFM "NEW GAME" ;
 $6993 DEFB $BF        ; Last character (bit 7 set)
 $6994 CALL $7405      ;
 $6997 DEFM "Yes  N"   ;
 $699D DEFB $EF        ; Last character (bit 7 set)
 $699E CALL $6FEF      ;
 $69A1 CALL $675A      ;
 $69A4 CP $59          ;
 $69A6 JP Z,$607F      ;
 $69A9 RET             ;

; Printer text: Next-best
@label=TextNextBest
t$69AA DEFM "Next-bes",$F4

; N: next-best move
;
; Sets $BCDD and takes back one ply. Because the root exclusion list at $BF00
; is neither cleared nor extended while $BCDD is set, the retracted move stays
; excluded and the main loop makes Cyrus play the side to move again (#R$611F).
; See #R$7CBA for how the search uses the list.
@label=KeyNextBest
c$69B3 LD HL,($C001) ;
 $69B6 LD A,L        ;
 $69B7 OR H          ;
 $69B8 JP Z,$6800    ;
 $69BB LD HL,$69AA   ;
 $69BE CALL $743B    ;
 $69C1 LD A,$01      ;
 $69C3 LD ($BCDD),A  ;
 $69C6 JP $68AE      ;

