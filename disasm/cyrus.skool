 $74A7 BIT 3,(IX+$03) ;
 $74AB JR Z,$74AF     ;
 $74AD LD A,$78       ;
*$74AF CALL $729B     ;
 $74B2 LD A,(IX+$02)  ;
 $74B5 CALL $74FB     ;
