 $878B LD A,($BE79)   ;
 $878E CALL $8AD4     ;
 $8791 LD ($BE7A),HL  ;
*$8794 LD ($BE7C),HL  ; }
; Combine. D,E = gains available against Black's pieces (second, best); H,L =
; against White's pieces (second, best). Arrange them as threats against the
; side to move (D,E) and against the mover (H,L), and take material from the
; mover's view.
 $8797 LD B,E         ; {B = positional score (White's view); restore IX
 $8798 LD IX,($BD3B)  ; }
 $879C POP DE         ; {D,E = Black's pieces (second, best); H,L = White's
 $879D LD HL,($BD39)  ; pieces}
 $87A0 LD A,($BD2D)   ; {White to move?
 $87A3 RRA            ;
 $87A4 JR NC,$87B0    ; }
 $87A6 XOR A          ; {Yes: mover is Black: negate B, swap the threat pairs,
 $87A7 SUB B          ; A = $BD0D (material change, Black's view)
 $87A8 LD B,A         ;
 $87A9 EX DE,HL       ;
 $87AA LD A,($BD0D)   ;
 $87AD JP $87B5       ; }
*$87B0 LD A,($BD0D)   ; {No: mover is White: A = -$BD0D
 $87B3 NEG            ; }
*$87B5 SUB L          ; {A = 2*(material - best gain the side to move has
 $87B6 ADD A,A        ; against the mover)}
 $87B7 DEC L          ; {Any such gain?
 $87B8 JP M,$87C3     ; }
 $87BB SET 1,(IX+$03) ; Yes: flag the move (bit 1 of IX+3)
 $87BF JR Z,$87C2     ; {If the gain is 2 or more, A=A-1
 $87C1 DEC A          ; }
*$87C2 SUB H          ; A = A - second gain
*$87C3 DEC E          ; {Mover threatens something of the side to move?
 $87C4 JP M,$87ED     ; }
 $87C7 BIT 2,(IX+$03) ; {Skip the bonus if the moved piece itself is en prise
 $87CB JR NZ,$87E2    ; (bit 2 of IX+3)}
 $87CD INC B          ; {B=B+2
 $87CE INC B          ; }
 $87CF DEC D          ; {A second threat?
 $87D0 JP M,$87E2     ; }
 $87D3 SET 6,(IX+$03) ; {Yes: flag a double threat (bit 6 of IX+3), B=B+2
 $87D7 INC B          ;
 $87D8 INC B          ; }
 $87D9 DEC D          ; {A gain of 2 or more on the second threat: B=B+2
 $87DA JP M,$87ED     ;
 $87DD INC B          ;
 $87DE INC B          ;
 $87DF JP $87ED       ; }
*$87E2 EX AF,AF'      ; {If mover's best threat exceeds the side to move's best
 $87E3 LD A,E         ; capture, flag bit 6 of IX+3
 $87E4 INC L          ;
 $87E5 CP L           ;
 $87E6 JR C,$87EC     ;
 $87E8 SET 6,(IX+$03) ;
*$87EC EX AF,AF'      ; }
; Scale: material outside -28..27 half-pawns saturates the score.
*$87ED CP $1C         ; {Material component in range?
 $87EF JR C,$87FD     ;
 $87F1 CP $E4         ;
 $87F3 JP NC,$87FD    ; }
 $87F6 RLA            ; {No: return $02 (losing) or $FC (winning)
 $87F7 LD A,$02       ;
 $87F9 RET C          ;
 $87FA LD A,$FC       ;
 $87FC RET            ; }
*$87FD ADD A,A        ; {C = material * 4 (8 per pawn)
 $87FE ADD A,A        ;
 $87FF LD C,A         ; }
 $8800 LD A,B         ; {D = (B + B/2 + carry)/2 (positional * 3/4)
 $8801 SRA A          ;
 $8803 ADC A,B        ;
 $8804 SRA A          ;
 $8806 LD D,A         ; }
 $8807 LD HL,$BCCE    ; {Increment the random byte $BCCE; add its bit 0 (bit
 $880A INC (HL)       ; 0..bit 1 on move 1)
 $880B LD A,($BD49)   ;
 $880E DEC A          ;
 $880F LD A,(HL)      ;
 $8810 JR NZ,$8816    ;
 $8812 AND $03        ;
 $8814 JR $8818       ;
*$8816 AND $01        ;
*$8818 ADD A,D        ; }
 $8819 CP $0C         ; {Clamp the positional term to -12..+12
 $881B JR C,$8828     ;
 $881D CP $F4         ;
 $881F JR NC,$8828    ;
 $8821 RLA            ;
 $8822 LD A,$0C       ;
 $8824 JR NC,$8828    ;
 $8826 LD A,$F4       ; }
*$8828 ADD A,C        ; {A = material + positional + $80
 $8829 ADD A,$80      ;
 $882B RET            ; }
@label=EvSwitchToWhite
*$882C LD A,$90       ; {Second pass: B' bit 4 set, colour flipped to White
 $882E ADD A,B        ;
 $882F LD B,A         ; }
 $8830 EXX            ; {E = -E
 $8831 XOR A          ;
 $8832 SUB E          ;
 $8833 LD E,A         ; }
 $8834 LD H,$BD       ; {H=$BD; A' = -A'
 $8836 EX AF,AF'      ;
 $8837 NEG            ;
 $8839 EX AF,AF'      ; }
; Scan White's pieces, then both kings.
@label=EvWhitePieces
*$883A LD A,($BE08)   ; {White queen (if present)
 $883D LD D,$88       ;
 $883F OR A           ;
 $8840 CALL P,$8C43   ; }
 $8843 LD A,($BE10)   ; {White rooks
 $8846 OR A           ;
 $8847 CALL P,$8C4E   ;
 $884A LD A,($BE18)   ;
 $884D OR A           ;
 $884E CALL P,$8C4E   ; }
 $8851 LD A,($BE20)   ; {White bishops
 $8854 OR A           ;
 $8855 CALL P,$8D74   ;
 $8858 LD A,($BE28)   ;
 $885B OR A           ;
 $885C CALL P,$8D74   ; }
 $885F LD A,($BE30)   ; {White knights
 $8862 OR A           ;
 $8863 CALL P,$8CC8   ;
 $8866 LD A,($BE38)   ;
 $8869 OR A           ;
 $886A CALL P,$8CC8   ; }
 $886D LD D,$11       ; {D=$11 (white pawns attack up the board); B=C=$FF
 $886F LD BC,$FFFF    ; }
 $8872 LD HL,($BE40)  ; {White pawns a..h (d- and e-pawn records use #R$8A54)
 $8875 BIT 7,L        ;
 $8877 CALL Z,$8A5B   ;
 $887A LD HL,($BE48)  ;
 $887D BIT 7,L        ;
 $887F CALL Z,$8A5B   ;
 $8882 LD HL,($BE50)  ;
 $8885 BIT 7,L        ;
 $8887 CALL Z,$8A5B   ;
 $888A LD HL,($BE58)  ;
 $888D BIT 7,L        ;
 $888F CALL Z,$8A54   ;
 $8892 LD HL,($BE60)  ;
 $8895 BIT 7,L        ;
 $8897 CALL Z,$8A54   ;
 $889A LD HL,($BE68)  ;
 $889D BIT 7,L        ;
 $889F CALL Z,$8A5B   ;
 $88A2 LD HL,($BE70)  ;
 $88A5 BIT 7,L        ;
 $88A7 CALL Z,$8A5B   ;
 $88AA LD HL,($BE78)  ;
 $88AD BIT 7,L        ;
 $88AF CALL Z,$8A5B   ; }
 $88B2 LD HL,($BE00)  ; {White king (#R$8978: early-queen check, then #R$897D)
 $88B5 CALL $8978     ; }
 $88B8 EX AF,AF'      ; {A' = -A', E = -E (Black's view)
 $88B9 NEG            ;
 $88BB EX AF,AF'      ;
 $88BC XOR A          ;
 $88BD SUB E          ;
 $88BE LD E,A         ; }
 $88BF LD HL,($BE80)  ; {Black king (B' bit 7 set = black)
 $88C2 EXX            ;
 $88C3 SET 7,B        ;
 $88C5 CALL $897D     ; }
 $88C8 EXX            ; {Second pass done?
 $88C9 BIT 4,B        ;
 $88CB JP NZ,$84A9    ; }
 $88CE SET 4,B        ; {No: set the second-pass flag and scan Black (#R$842B)
 $88D0 EXX            ;
 $88D1 JP $842B       ; }

; Late endgame king: centralisation
;
; Used by #R$8943 when there are no pawns ($BD6D=0) and the king belongs to the
; side favoured by $BD1E. Adds a centralisation term to A': D (the king's
; diagonal edge distance * 8, or -10 if 0) plus 16 on files d/e or ranks 4/5,
; plus 8 on files c/f or ranks 3/6.
;
; A $BD6D
; D King's edge distance * 8 (from type bit 6..bit 7)
; L King's square
@label=EvKingCentralise
c$88D4 OR A          ; {Pawns on the board: just add D (#R$896F)
 $88D5 JP NZ,$896F   ; }
 $88D8 LD A,D        ; {D=0: use -10
 $88D9 OR A          ;
 $88DA JR NZ,$88DF   ;
 $88DC SUB $0A       ;
 $88DE LD D,A        ; }
*$88DF LD A,$07      ; {Files d,e?
 $88E1 AND L         ;
 $88E2 INC A         ;
 $88E3 RRA           ;
 $88E4 CP $02        ;
 $88E6 JR Z,$88F3    ; }
 $88E8 LD A,$70      ; {Ranks 4,5?
 $88EA AND L         ;
 $88EB CP $30        ;
 $88ED JR Z,$88F3    ;
 $88EF CP $40        ;
 $88F1 JR NZ,$88F9   ; }
*$88F3 EX AF,AF'     ; {Yes: A' = A' + 16 + D
 $88F4 ADD A,$10     ;
 $88F6 JP $8970      ; }
*$88F9 LD A,$07      ; {Files c,f?
 $88FB AND L         ;
 $88FC CP $02        ;
 $88FE JR Z,$890F    ;
 $8900 CP $05        ;
 $8902 JR Z,$890F    ; }
 $8904 LD A,$70      ; {Ranks 3,6?
 $8906 AND L         ;
 $8907 CP $20        ;
 $8909 JR Z,$890F    ;
 $890B CP $50        ;
 $890D JR NZ,$896F   ; }
; This entry point is used by the routine at #R$8943.
*$890F EX AF,AF'     ; {Yes: A' = A' + 8 + D
 $8910 ADD A,$08     ;
 $8912 JP $8970      ; }

; Opening: penalise early queen moves
;
; Used by #R$8978 before move 8. C = 9 - move number; a queen that has moved
; (bit 4 of its type byte) and is still on the board costs its side C points of
; E.
@label=EvEarlyQueenCheck
c$8915 LD A,($BD49)  ; {C = 9 - $BD49
 $8918 CPL           ;
 $8919 ADD A,$0A     ;
 $891B EXX           ;
 $891C LD C,A        ; }
 $891D LD A,($BE89)  ; {Black queen moved and present: E=E+C
 $8920 BIT 4,A       ;
 $8922 JR Z,$892E    ;
 $8924 LD A,($BE88)  ;
 $8927 OR A          ;
 $8928 JP M,$892E    ;
 $892B LD A,E        ;
 $892C ADD A,C       ;
 $892D LD E,A        ; }
*$892E LD A,($BE09)  ; {White queen moved and present: E=E-C
 $8931 BIT 4,A       ;
 $8933 JR Z,$893F    ;
 $8935 LD A,($BE08)  ;
 $8938 OR A          ;
 $8939 JP M,$893F    ;
 $893C LD A,E        ;
 $893D SUB C         ;
 $893E LD E,A        ; }
*$893F EXX           ; {Continue with the king (#R$897D)
 $8940 JP $897D      ; }

; Endgame king evaluation
;
; Used by #R$897D in the endgame (bit 2 of B'). Pawns next to the king are
; worth 8 each in A'; in the late endgame (bit 3) they are worth 4 and the king
; may be centralised.
;
; A Pass flags (B')
; H King's type byte
; L King's square
@label=EvEndgameKing
c$8943 BIT 3,A       ; {Late endgame?
 $8945 JR NZ,$894F   ; }
 $8947 LD H,$BD      ; {No: weight 8 per adjacent pawn
 $8949 LD B,L        ;
 $894A LD C,$08      ;
 $894C JP $89AC      ; }
*$894F LD B,A        ; {Late: weight 4; D = edge distance * 8 (type bit 6..bit
 $8950 LD C,$04      ; 7)
 $8952 LD A,$C0      ;
 $8954 AND H         ;
 $8955 RRA           ;
 $8956 RRA           ;
 $8957 RRA           ;
 $8958 LD D,A        ; }
 $8959 LD A,($BD1E)  ; {$BD1E = 0?
 $895C OR A          ;
 $895D JR Z,$8966    ; }
 $895F XOR B         ; {Same sign as the colour being scanned: centralisation
 $8960 LD A,($BD6D)  ; (#R$88D4) with A=$BD6D
 $8963 JP P,$88D4    ; }
@label=EvEndgameKing2
*$8966 RR D          ; D = D/2
 $8968 OR A          ; {$BD1E set and pawns present: just add D
 $8969 JR NZ,$896F   ; }
 $896B BIT 7,H       ; {Otherwise a king with bit 7 of its type set gets +8
 $896D JR NZ,$890F   ; (#R$890F)}
; This entry point is used by the routine at #R$88D4.
*$896F EX AF,AF'     ; {A' = A' + D
; This entry point is used by the routine at #R$88D4.
*$8970 ADD A,D       ;
 $8971 EX AF,AF'     ; }
 $8972 LD H,$BD      ; {Scan the king's neighbours (#R$89AC)
 $8974 LD B,L        ;
 $8975 JP $89AC      ; }

; Evaluate the white king
;
; Used by #R$8400. Before move 8 (bit 0 of B' clear) first applies the
; early-queen penalty (#R$8915).
;
; H King's type byte
; L King's square
@label=EvWhiteKing
c$8978 EXX           ; {Move 8 reached?
 $8979 BIT 0,B       ;
 $897B JR Z,$8915    ; }

; Evaluate a king (middlegame)
;
; Used by #R$8400 (black king) and #R$8978. The king's type byte: bit 4 moved,
; bit 5 castled, bit 6..bit 7 distance from the edge along the diagonals (0..3,
; maintained by #R$8200).
;
; H King's type byte
; L King's square
@label=EvKing
c$897D LD A,B        ; {A=pass flags; endgame?
 $897E EXX           ;
 $897F BIT 2,A       ;
 $8981 JR NZ,$8943   ; }
 $8983 BIT 5,H       ; {Castled?
 $8985 JP Z,$8A0D    ; }
 $8988 LD A,$C0      ; {Castled but away from the edge: exposed (#R$89FB)
 $898A AND H         ;
 $898B JR NZ,$89FB   ; }
 $898D LD C,$0A      ; {Castled: pawn-shelter weight 10
 $898F LD B,L        ; }
 $8990 LD H,$BD      ; {Look two ranks ahead (or behind, if that leaves the
 $8992 LD A,$1F      ; board) on files f-1..f+1
 $8994 ADD A,B       ;
 $8995 JP P,$899A    ;
 $8998 SUB $40       ;
*$899A LD L,A        ; }
 $899B BIT 6,(HL)    ; {Any pawn there (piece code bit 6)?
 $899D JR NZ,$89AB   ;
 $899F INC L         ;
 $89A0 BIT 6,(HL)    ;
 $89A2 JR NZ,$89AB   ;
 $89A4 INC L         ;
 $89A5 BIT 6,(HL)    ;
 $89A7 JR NZ,$89AB   ; }
 $89A9 DEC E         ; {None: E=E-2
 $89AA DEC E         ; }
*$89AB LD L,B        ; Restore L
; This entry point is used by the routines at #R$8943 and #R$89FB.
@label=EvKingNeighbours
*$89AC DEC L         ; {Left neighbour (no file check: may read an off-board
 $89AD XOR A         ; byte)
 $89AE OR (HL)       ;
 $89AF CALL NZ,$89E2 ; }
 $89B2 INC L         ; {Right neighbour
 $89B3 INC L         ;
 $89B4 OR (HL)       ;
 $89B5 CALL NZ,$89E2 ; }
 $89B8 LD A,$10      ; {Rank above (if on the board): centre, right, left
 $89BA ADD A,B       ;
 $89BB JP M,$89CF    ;
 $89BE LD L,A        ;
 $89BF XOR A         ;
 $89C0 OR (HL)       ;
 $89C1 CALL NZ,$89E2 ;
 $89C4 INC L         ;
 $89C5 OR (HL)       ;
 $89C6 CALL NZ,$89E2 ;
 $89C9 DEC L         ;
 $89CA DEC L         ;
 $89CB OR (HL)       ;
 $89CC CALL NZ,$89E2 ; }
*$89CF LD A,$F0      ; {Rank below (if on the board): centre, right, left
 $89D1 ADD A,B       ;
 $89D2 RET M         ;
 $89D3 LD L,A        ;
 $89D4 XOR A         ;
 $89D5 OR (HL)       ;
 $89D6 CALL NZ,$89E2 ;
 $89D9 INC L         ;
 $89DA OR (HL)       ;
 $89DB CALL NZ,$89E2 ;
 $89DE DEC L         ;
 $89DF DEC L         ;
 $89E0 OR (HL)       ;
 $89E1 RET Z         ; }

; King: process a neighbouring piece
;
; Used by #R$897D. Counts the king as a defender (+1 in record +5) of a
; friendly neighbour or an attacker (+1 in record +3) of an enemy one, and adds
; the shelter weight C to A' if the neighbour is a pawn record (either colour).
; Kings next to each other abort the evaluation.
;
; A Piece code
; C Shelter weight
@label=EvKingNeighbourSquare
c$89E2 EXX           ; {L'=record+5
 $89E3 LD L,A        ;
 $89E4 INC L         ; }
 $89E5 XOR B         ; {Friendly?
 $89E6 JP P,$89F1    ; }
 $89E9 LD A,$78      ; {Enemy king next to this king: abort
 $89EB AND L         ;
 $89EC JP Z,$8C28    ; }
 $89EF DEC L         ; {Enemy: L'=record+3
 $89F0 DEC L         ; }
*$89F1 INC (HL)      ; Count the king attack/defence
 $89F2 XOR A         ; {Pawn record ($40-$7F, $C0-$FF)?
 $89F3 BIT 6,L       ;
 $89F5 EXX           ;
 $89F6 RET Z         ; }
 $89F7 EX AF,AF'     ; {Yes: A' = A' + C
 $89F8 ADD A,C       ;
 $89F9 EX AF,AF'     ;
 $89FA RET           ; }

; King away from the edge or uncastled
;
; Continuation of #R$897D.
@label=EvKingExposed
c$89FB LD C,$04      ; Shelter weight 4
 $89FD BIT 7,H       ; {Edge distance 2 or more: E=E-2
 $89FF JP Z,$8A04    ;
 $8A02 DEC E         ;
 $8A03 DEC E         ; }
*$8A04 DEC E         ; {E=E-3
 $8A05 DEC E         ;
 $8A06 DEC E         ; }
 $8A07 LD B,L        ; {Scan neighbours
 $8A08 LD H,$BD      ;
 $8A0A JP $89AC      ; }
; This entry point is used by the routine at #R$897D.
@label=EvKingUncastled
*$8A0D BIT 4,H       ; {King moved?
 $8A0F JR NZ,$8A1A   ; }
 $8A11 LD H,$BD      ; {Never moved: weight 0, E=E+1
 $8A13 LD B,L        ;
 $8A14 LD C,$00      ;
 $8A16 INC E         ;
 $8A17 JP $89AC      ; }
*$8A1A LD A,E        ; {Moved without castling: E=E-6, weight 8
 $8A1B SUB $06       ;
 $8A1D LD E,A        ;
 $8A1E LD C,$08      ; }
 $8A20 LD A,$C0      ; {Away from the edge: further penalty (#R$89FB)
 $8A22 AND H         ;
 $8A23 JR NZ,$89FB   ; }
 $8A25 LD H,$BD      ; {Scan neighbours
 $8A27 LD B,L        ;
 $8A28 JP $89AC      ; }

; Pawn: late-endgame advancement bonus
;
; Reached through JP (IY) from #R$8A5B when total material is below $28. A'
; gains the pawn type byte / 4 (0, 4, 12, 24 or 36 for relative ranks <=3, 4,
; 5, 6, 7). In the first pass a pawn on its seventh rank records the piece in
; front of it in $BD4E.
;
; H Pawn type byte
; L Square diagonally ahead-right (pawn square + D)
@label=EvPawnLateEndgame
c$8A2B SRL H         ; {A' = A' + type/4
 $8A2D SRL H         ;
 $8A2F EX AF,AF'     ;
 $8A30 ADD A,H       ;
 $8A31 EX AF,AF'     ; }
 $8A32 BIT 5,H       ; {Seventh-rank pawn (type bit 7)?
 $8A34 JP Z,$8A7A    ; }
 $8A37 EXX           ; {Only in the first pass
 $8A38 BIT 4,B       ;
 $8A3A EXX           ;
 $8A3B JR NZ,$8A7A   ; }
 $8A3D LD H,$BD      ; {$BD4E = contents of the square in front of the pawn
 $8A3F DEC L         ;
 $8A40 LD A,(HL)     ;
 $8A41 INC L         ;
 $8A42 LD ($BD4E),A  ; }
 $8A45 JP $8A7C      ; Mark its attacks (#R$8A7C)

; Pawn penalties
;
; Continuations of #R$8A54/#R$8A5B.
@label=EvPawnDoubled
c$8A48 DEC E         ; {Doubled pawn: E=E-3
 $8A49 DEC E         ;
 $8A4A DEC E         ;
 $8A4B JP $8A6B      ; }
; This entry point is used by the routine at #R$8A54.
@label=EvPawnCentreUnmoved
*$8A4E DEC E         ; {Unmoved centre pawn: E=E-3
 $8A4F DEC E         ;
 $8A50 DEC E         ;
 $8A51 JP $8A5B      ; }

; Evaluate a d- or e-pawn record
;
; Used by #R$8400 for the d- and e-pawn records. A pawn standing on rank 2 or
; rank 7 (either colour) costs 3.
;
; H Type byte
; L Square
@label=EvCentrePawn
c$8A54 LD A,L        ; {(rank+2) AND 4 = 0, i.e. on rank 2 or 7?
 $8A55 ADD A,$20     ;
 $8A57 BIT 6,A       ;
 $8A59 JR Z,$8A4E    ; }

; Evaluate a pawn record
;
; Used by #R$8400. Dispatches promoted pieces to the piece routines, penalises
; a pawn on the same file as either of the previous two pawn records scanned,
; then jumps through IY to add the phase-dependent advancement bonus and mark
; the pawn's two attacked squares.
;
; B,C File of the previous two pawn records ($FF = none)
; D Pawn direction $11 (White) or $F1 (Black)
; H Type byte
; L Square
@label=EvPawn
c$8A5B LD A,$0E      ; {Promoted (type bit 1..bit 3)?
 $8A5D AND H         ;
 $8A5E JR NZ,$8A96   ; }
 $8A60 LD A,D        ; {L = square diagonally ahead-right; A = its file nibble
 $8A61 ADD A,L       ; (= the pawn's file + 1)
 $8A62 LD L,A        ;
 $8A63 AND $0F       ; }
 $8A65 CP B          ; {Same file as one of the previous two pawns: doubled
 $8A66 JR Z,$8A48    ; (#R$8A48)
 $8A68 CP C          ;
 $8A69 JR Z,$8A48    ; }
; This entry point is used by the routine at #R$8A48.
@label=EvPawn2
*$8A6B LD C,B        ; {Remember the file; continue at IY
 $8A6C LD B,A        ;
 $8A6D JP (IY)       ; }

; Pawn: endgame advancement bonus
;
; Reached through JP (IY) when total material is below $34: A' gains type/8 (0,
; 2, 6, 12 or 18 for relative ranks <=3..7).
@label=EvPawnEndgame
c$8A6F SRL H         ; {Unadvanced pawn: no bonus
 $8A71 JR Z,$8A7A    ; }
 $8A73 SRL H         ; {A' = A' + type/8
 $8A75 SRL H         ;
 $8A77 EX AF,AF'     ;
 $8A78 ADD A,H       ;
 $8A79 EX AF,AF'     ; }
; This entry point is used by the routine at #R$8A2B.
@label=EvPawnAttacks
*$8A7A LD H,$BD      ; H=$BD
; This entry point is used by the routine at #R$8A2B.
@label=EvPawnAttacks2
*$8A7C LD A,(HL)     ; {Piece diagonally ahead-right?
 $8A7D OR A          ;
 $8A7E CALL NZ,$8A85 ; }
 $8A81 DEC L         ; {Piece diagonally ahead-left (L-2)? (no board-edge
 $8A82 DEC L         ; checks)
 $8A83 OR (HL)       ;
 $8A84 RET Z         ; }

; Pawn attacks a piece
;
; Used by #R$8A5B. Adds 1 to the defender count (+4) of a friendly piece or to
; the attacker count (+2) of an enemy piece.
;
; A Piece code
@label=EvPawnHit
c$8A85 EXX           ; {L'=record+4
 $8A86 LD L,A        ; }
 $8A87 XOR B         ; {Friendly?
 $8A88 JP P,$8A92    ; }
 $8A8B LD A,$78      ; {Enemy king: check (#R$8ABA)
 $8A8D AND L         ;
 $8A8E JR Z,$8ABA    ; }
 $8A90 DEC L         ; {Enemy: L'=record+2
 $8A91 DEC L         ; }
*$8A92 INC (HL)      ; {Count the pawn
 $8A93 EXX           ;
 $8A94 XOR A         ;
 $8A95 RET           ; }

; Evaluate a promoted pawn record as its new piece
;
; Continuation of #R$8A5B. Saves B, C, D, pushes the return stub #R$8AB5 and
; dispatches on the type byte: queen, rook, bishop or knight (no development
; penalty).
@label=EvPromotedPawn
c$8A96 PUSH BC       ; {Save pawn state; return via #R$8AB5
 $8A97 PUSH DE       ;
 $8A98 LD BC,$8AB5   ;
 $8A9B PUSH BC       ; }
 $8A9C LD C,H        ; {C=type, H=$BD, D=$88
 $8A9D LD H,$BD      ;
 $8A9F LD D,$88      ; }
 $8AA1 LD A,L        ; {Queen?
 $8AA2 BIT 3,C       ;
 $8AA4 JP NZ,$8C43   ; }
 $8AA7 BIT 2,C       ; {Rook?
 $8AA9 JP NZ,$8C4E   ; }
 $8AAC BIT 7,C       ; {Bishop?
 $8AAE LD B,A        ;
 $8AAF JP NZ,$8D86   ; }
 $8AB2 JP $8CCD      ; Knight

; Return from a promoted piece
;
; Restores D (pawn direction) and B, C (pawn files) but keeps E.
@label=EvPromotedPawnReturn
c$8AB5 LD L,E        ; {Restore DE but keep E
 $8AB6 POP DE        ;
 $8AB7 LD E,L        ;
 $8AB8 POP BC        ; }
 $8AB9 RET           ; Restore BC and return

; Pawn attacks the enemy king
;
; Continuation of #R$8A85. In the first pass the side to move could capture the
; king: abort. Otherwise flag the move as a check (bit 7 of IX+3) and add 1 to
; E.
@label=EvPawnGivesCheck
c$8ABA BIT 4,B        ; {First pass: abort
 $8ABC JP Z,$8C28     ; }
 $8ABF SET 7,(IX+$03) ; Flag check on the move
 $8AC3 EXX            ; {E=E+1
 $8AC4 INC E          ;
 $8AC5 RET            ; }

; SEE: no direct attackers
;
; Continuation of #R$8AD6. Without direct attackers the piece counts as
; attacked only if the enemy king (record +3 bit 0) is among the attackers; the
; x-ray attackers and the king are then fed to the exchange.
@label=EvSeeNoDirect
c$8AC6 BIT 0,H       ; {King among the x-ray attackers?
 $8AC8 JR NZ,$8ACD   ; }
 $8ACA LD H,$00      ; {No: nothing to do
 $8ACC RET           ; }
*$8ACD LD A,H        ; {Yes: start the attacker generator on record +3
 $8ACE CALL $8B6A    ;
 $8AD1 JP $8AE0      ; }

; SEE for a pawn record
;
; Used by #R$8400. A = type byte; the value is its low nibble.
@label=EvSeePawn
c$8AD4 AND $0F       ; A = value (type AND $0F)

; Static exchange evaluation of one piece
;
; Used by #R$8400. Plays out the capture sequence on the piece using two
; coroutines: #R$8B50/#R$8B6A yield attackers in the order pawn, minor, rook,
; queen, x-ray minor, x-ray rook, x-ray queen, king (continuation in IY);
; #R$8BB9 yields defenders likewise (continuation in IX). The loop works in the
; alternate set with A = running gain, E' = lower bound, D' = upper bound, L' =
; current attacker value, H' = current defender value, C' = defenders left of
; that value; main D = attackers left of that value.
; .
; A positive result updates $BD39 (best) and $BD3A (second best). Any
; non-negative result costs E one point, three if the piece carries the
; moved/checking marker (+5 bit 1), which also flags bit 2 of IX+3.
;
;   A Piece value
;   B Record +5 (x-ray defenders, king defender bit 0, marker bit 1)
;   C Record +4 (defenders: pawns bit 0-1, minors bit 2-3, rooks bit 4-5,
; .   queens bit 6-7)
;   H Record +3 (x-ray attackers, king attacker bit 0)
;   L Record +2 (attackers: pawns bit 0-1, minors bit 2-3, rooks bit 4-5,
; .   queens bit 6-7)
; O:HL 0 (written back to clear the record)
@label=EvSee
c$8AD6 EXX            ; {D' = value (upper bound)
 $8AD7 LD D,A         ;
 $8AD8 EXX            ; }
 $8AD9 LD A,L         ; {No direct attackers? (#R$8AC6)
 $8ADA OR A           ;
 $8ADB JR Z,$8AC6     ; }
 $8ADD CALL $8B50     ; First attacker: L' = value, main D = count
; This entry point is used by the routine at #R$8AC6.
@label=EvSeeStart
*$8AE0 CALL $8BB9     ; First defender: H' = value, C' = count
 $8AE3 LD E,$FF       ; {E' = -1 (lower bound); A = value (gain if the first
 $8AE5 LD A,D         ; attacker captures)}
@label=EvSeeLoop
*$8AE6 LD B,$00       ; B' = 0
 $8AE8 BIT 0,H        ; {No defender left: stop
 $8AEA JR Z,$8B1A     ; }
 $8AEC SUB L          ; Defender recaptures: A = A - attacker value
 $8AED EXX            ; {One attacker of this value used; fetch the next kind
 $8AEE DEC D          ; when exhausted
 $8AEF EXX            ;
 $8AF0 CALL Z,$8B8C   ; }
 $8AF3 CP E           ; {Below the lower bound: B'=1
 $8AF4 JP M,$8B12     ; }
 $8AF7 CP D           ; {At or above the upper bound: B'=2
 $8AF8 JP P,$8B11     ; }
 $8AFB LD E,A         ; Otherwise raise the lower bound
@label=EvSeeAttacker
*$8AFC BIT 0,L        ; {No attacker left: stop
 $8AFE JR Z,$8B1A     ; }
 $8B00 ADD A,H        ; Attacker recaptures: A = A + defender value
 $8B01 CP E           ; {Below the lower bound: B'=B'-1, stop if 0
 $8B02 JP M,$8B17     ; }
 $8B05 CP D           ; {At or above the upper bound: B'=B'-2, stop if 0
 $8B06 JP P,$8B16     ; }
 $8B09 LD D,A         ; Otherwise lower the upper bound
*$8B0A DEC C          ; {One defender used; fetch the next kind when exhausted
 $8B0B CALL Z,$8BFA   ; }
 $8B0E JP $8AE6       ; Next round
*$8B11 INC B          ; {B'=2 / B'=1
*$8B12 INC B          ;
 $8B13 JP $8AFC       ; }
*$8B16 DEC B          ; {B'=B'-2 / B'=B'-1; continue unless 0
*$8B17 DEC B          ;
 $8B18 JR NZ,$8B0A    ; }
@label=EvSeeResult
*$8B1A CP E           ; {A = max(A, lower bound)
 $8B1B JP P,$8B1F     ;
 $8B1E LD A,E         ; }
*$8B1F CP D           ; {A = min(A, upper bound)
 $8B20 JP M,$8B24     ;
 $8B23 LD A,D         ; }
*$8B24 OR A           ; {Negative: piece is safe, return HL=0
 $8B25 EXX            ;
 $8B26 JP M,$8B3E     ; }
 $8B29 JR Z,$8B39     ; Zero: no gain, but still penalised
 $8B2B LD HL,$BD39    ; {Keep the best gain in $BD39,
 $8B2E CP (HL)        ;
 $8B2F JR C,$8B34     ;
 $8B31 LD C,A         ;
 $8B32 LD A,(HL)      ;
 $8B33 LD (HL),C      ; }
*$8B34 INC L          ; {and the second best in $BD3A
 $8B35 CP (HL)        ;
 $8B36 JR C,$8B39     ;
 $8B38 LD (HL),A      ; }
@label=EvSeePenalty
*$8B39 DEC E          ; E=E-1 for a piece under attack
 $8B3A BIT 1,B        ; {Moved/checking piece (+5 bit 1)?
 $8B3C JR NZ,$8B42    ; }
*$8B3E LD HL,$0000    ; {No: return HL=0
 $8B41 RET            ; }
*$8B42 LD IX,($BD3B)  ; {Yes: restore IX, flag bit 2 of IX+3 (moved piece en
 $8B46 SET 2,(IX+$03) ; prise), E=E-2
 $8B4A LD HL,$0000    ;
 $8B4D DEC E          ;
 $8B4E DEC E          ;
 $8B4F RET            ; }

; SEE coroutine: direct attackers
;
; Used by #R$8AD6. Yields each non-empty attacker group of record +2 (main L)
; in increasing value, then continues with the x-ray byte +3 (#R$8B6A). Each
; yield (#R$8B84...#R$8BB1) stores the continuation in IY, sets L'=value and
; main D=count, and returns with the alternate set active and A/A' swapped.
; Exhausted: L'=0.
@label=EvAttackerGen
c$8B50 AND $03       ; {Pawns
 $8B52 CALL NZ,$8B84 ; }
 $8B55 LD A,$0C      ; {Minor pieces
 $8B57 AND L         ;
 $8B58 CALL NZ,$8B91 ; }
 $8B5B LD A,$30      ; {Rooks
 $8B5D AND L         ;
 $8B5E CALL NZ,$8B9B ; }
 $8B61 LD A,$C0      ; {Queens
 $8B63 AND L         ;
 $8B64 CALL NZ,$8BA7 ; }
 $8B67 OR H          ; {X-ray byte empty: finished
 $8B68 JR Z,$8B80    ; }

; SEE coroutine: x-ray attackers
;
; Used by #R$8AC6 and continuation of #R$8B50. Groups of record +3 (main H):
; minors, rooks, queens, then the king (bit 0).
@label=EvXrayAttackerGen
c$8B6A AND $0C       ; {X-ray minors
 $8B6C CALL NZ,$8B91 ; }
 $8B6F LD A,$30      ; {X-ray rooks
 $8B71 AND H         ;
 $8B72 CALL NZ,$8B9B ; }
 $8B75 LD A,$C0      ; {X-ray queens
 $8B77 AND H         ;
 $8B78 CALL NZ,$8BA7 ; }
 $8B7B INC A         ; {King
 $8B7C AND H         ;
 $8B7D CALL NZ,$8BB1 ; }
; This entry point is used by the routine at #R$8B50.
@label=EvAttackersDone
*$8B80 EXX           ; {No more attackers: L'=0
 $8B81 LD L,A        ;
 $8B82 EX AF,AF'     ;
 $8B83 RET           ; }

; Yield pawn attackers
;
; Coroutine yield used by #R$8B50.
@label=EvYieldPawnAttackers
c$8B84 LD D,A        ; {D=count; IY=continuation
 $8B85 POP IY        ; }
 $8B87 EXX           ; {L'=1 (pawn)
 $8B88 LD L,$01      ;
 $8B8A EX AF,AF'     ;
 $8B8B RET           ; }

; Resume the attacker coroutine
;
; Used by #R$8AD6 when the current attacker group is used up.
@label=EvNextAttacker
c$8B8C EX AF,AF'     ; {Save the SEE state and resume at IY
 $8B8D EXX           ;
 $8B8E XOR A         ;
 $8B8F JP (IY)       ; }

; Yield minor-piece attackers
;
; Coroutine yield used by #R$8B50 and #R$8B6A.
@label=EvYieldMinorAttackers
c$8B91 RRA           ; {D=count (bit 2-3); IY=continuation
 $8B92 RRA           ;
 $8B93 LD D,A        ;
 $8B94 POP IY        ; }
 $8B96 EXX           ; {L'=3
 $8B97 LD L,$03      ;
 $8B99 EX AF,AF'     ;
 $8B9A RET           ; }

; Yield rook attackers
;
; Coroutine yield used by #R$8B50 and #R$8B6A.
@label=EvYieldRookAttackers
c$8B9B RRA           ; {D=count (bit 4-5); IY=continuation
 $8B9C RRA           ;
 $8B9D RRA           ;
 $8B9E RRA           ;
 $8B9F LD D,A        ;
 $8BA0 POP IY        ; }
 $8BA2 EXX           ; {L'=5
 $8BA3 LD L,$05      ;
 $8BA5 EX AF,AF'     ;
 $8BA6 RET           ; }

; Yield queen attackers
;
; Coroutine yield used by #R$8B50 and #R$8B6A.
@label=EvYieldQueenAttackers
c$8BA7 RLCA          ; {D=count (bit 6-7); IY=continuation
 $8BA8 RLCA          ;
 $8BA9 LD D,A        ;
 $8BAA POP IY        ; }
 $8BAC EXX           ; {L'=9
 $8BAD LD L,$09      ;
 $8BAF EX AF,AF'     ;
 $8BB0 RET           ; }

; Yield the king as attacker
;
; Coroutine yield used by #R$8B6A.
@label=EvYieldKingAttacker
c$8BB1 LD D,A        ; {D=1; IY=continuation
 $8BB2 POP IY        ; }
 $8BB4 EXX           ; {L'=13
 $8BB5 LD L,$0D      ;
 $8BB7 EX AF,AF'     ;
 $8BB8 RET           ; }

; SEE coroutine: defenders
;
; Used by #R$8AD6. Yields defender groups from record +4 (main C) then x-ray
; defenders from +5 (main B): minors, rooks, queens and finally the king (bit
; 0), which also costs E one point when it is reached. Continuation in IX.
; Exhausted: H'=0.
@label=EvDefenderGen
c$8BB9 EXX           ; {No direct defenders?
 $8BBA LD A,C        ;
 $8BBB OR A          ;
 $8BBC JR Z,$8BD5    ; }
 $8BBE AND $03       ; {Pawns
 $8BC0 CALL NZ,$8BF2 ; }
 $8BC3 LD A,$0C      ; {Minors
 $8BC5 AND C         ;
 $8BC6 CALL NZ,$8BFF ; }
 $8BC9 LD A,$30      ; {Rooks
 $8BCB AND C         ;
 $8BCC CALL NZ,$8C09 ; }
 $8BCF LD A,$C0      ; {Queens
 $8BD1 AND C         ;
 $8BD2 CALL NZ,$8C15 ; }
*$8BD5 OR B          ; {X-ray byte empty: finished
 $8BD6 JR Z,$8BEE    ; }
 $8BD8 AND $0C       ; {X-ray minors
 $8BDA CALL NZ,$8BFF ; }
 $8BDD LD A,$30      ; {X-ray rooks
 $8BDF AND B         ;
 $8BE0 CALL NZ,$8C09 ; }
 $8BE3 LD A,$C0      ; {X-ray queens
 $8BE5 AND B         ;
 $8BE6 CALL NZ,$8C15 ; }
 $8BE9 INC A         ; {King
 $8BEA AND B         ;
 $8BEB CALL NZ,$8C1F ; }
@label=EvDefendersDone
*$8BEE EXX           ; {No more defenders: H'=0
 $8BEF LD H,A        ;
 $8BF0 EX AF,AF'     ;
 $8BF1 RET           ; }

; Yield pawn defenders
;
; Coroutine yield used by #R$8BB9.
@label=EvYieldPawnDefenders
c$8BF2 EXX           ; {C'=count, H'=1; IX=continuation
 $8BF3 LD C,A        ;
 $8BF4 LD H,$01      ;
 $8BF6 POP IX        ;
 $8BF8 EX AF,AF'     ;
 $8BF9 RET           ; }

; Resume the defender coroutine
;
; Used by #R$8AD6.
@label=EvNextDefender
c$8BFA EX AF,AF'     ; {Save the SEE state and resume at IX
 $8BFB EXX           ;
 $8BFC XOR A         ;
 $8BFD JP (IX)       ; }

; Yield minor defenders
;
; Coroutine yield used by #R$8BB9.
@label=EvYieldMinorDefenders
c$8BFF RRA           ; {C'=count, H'=3; IX=continuation
 $8C00 RRA           ;
 $8C01 POP IX        ;
 $8C03 EXX           ;
 $8C04 LD H,$03      ;
 $8C06 LD C,A        ;
 $8C07 EX AF,AF'     ;
 $8C08 RET           ; }

; Yield rook defenders
;
; Coroutine yield used by #R$8BB9.
@label=EvYieldRookDefenders
c$8C09 RRA           ; {C'=count, H'=5; IX=continuation
 $8C0A RRA           ;
 $8C0B RRA           ;
 $8C0C RRA           ;
 $8C0D POP IX        ;
 $8C0F EXX           ;
 $8C10 LD H,$05      ;
 $8C12 LD C,A        ;
 $8C13 EX AF,AF'     ;
 $8C14 RET           ; }

; Yield queen defenders
;
; Coroutine yield used by #R$8BB9.
@label=EvYieldQueenDefenders
c$8C15 RLCA          ; {C'=count, H'=9; IX=continuation
 $8C16 RLCA          ;
 $8C17 POP IX        ;
 $8C19 EXX           ;
 $8C1A LD H,$09      ;
 $8C1C LD C,A        ;
 $8C1D EX AF,AF'     ;
 $8C1E RET           ; }

; Yield the king as defender
;
; Coroutine yield used by #R$8BB9. Costs E one point.
@label=EvYieldKingDefender
c$8C1F DEC E         ; E=E-1
 $8C20 POP IX        ; {C'=1, H'=13; IX=continuation
 $8C22 EXX           ;
 $8C23 LD H,$0D      ;
 $8C25 LD C,A        ;
 $8C26 EX AF,AF'     ;
 $8C27 RET           ; }

; Abort the evaluation: illegal position
;
; Used when the side to move attacks the enemy king or the kings touch. Clears
; the pin list and the attack bytes (+2..+5) of records $BE08..$BEF8 (not the
; white king's), restores SP from $BD3D and returns A=0 to the caller of
; #R$8400.
@label=EvAbort
c$8C28 XOR A         ; {Empty the pin list
 $8C29 LD ($BD79),A  ; }
 $8C2C LD B,$1F      ; {Clear +2..+5 of 31 records
 $8C2E LD DE,$0005   ;
 $8C31 LD HL,$BE0A   ;
*$8C34 LD (HL),A     ;
 $8C35 INC L         ;
 $8C36 LD (HL),A     ;
 $8C37 INC L         ;
 $8C38 LD (HL),A     ;
 $8C39 INC L         ;
 $8C3A LD (HL),A     ;
 $8C3B ADD HL,DE     ;
 $8C3C DJNZ $8C34    ; }
 $8C3E LD SP,($BD3D) ; {Return 0 from #R$8400
 $8C42 RET           ; }

; Queen attacks
;
; Used by #R$8400 and #R$8A96. Rook lines and diagonals with weight $40.
;
; A Square
@label=EvQueen
c$8C43 LD B,A        ; {B=square; C'=$40
 $8C44 EXX           ;
 $8C45 LD C,$40      ; }
 $8C47 CALL $8C52    ; Rook lines
 $8C4A EXX           ; {Diagonals (#R$8D89)
 $8C4B JP $8D89      ; }

; Rook attacks
;
; Used by #R$8400 and #R$8A96.
;
; A Square
@label=EvRook
c$8C4E LD B,A        ; {B=square; C'=$10
 $8C4F EXX           ;
 $8C50 LD C,$10      ; }

; Scan the rook lines of a queen or rook
;
; Used by #R$8C43 and #R$8C4E. Horizontal rays do not count mobility; vertical
; rays add 1 to E for every square up to and including the first piece. The
; first piece hit is processed by #R$8C98 (horizontal) or #R$8C80 (vertical).
;
; B Square
; C' Weight
@label=EvOrthogonals
c$8C52 LD E,$08      ; {E' = $08 (pieces that move orthogonally)
 $8C54 EXX           ; }
 $8C55 LD L,B        ; {East
 $8C56 XOR A         ;
*$8C57 INC L         ;
 $8C58 BIT 3,L       ;
 $8C5A JR NZ,$8C65   ;
 $8C5C OR (HL)       ;
 $8C5D JR Z,$8C57    ; }
 $8C5F LD C,$01      ; {Piece hit (C=+1)
 $8C61 CALL $8C98    ; }
 $8C64 XOR A         ; {West
*$8C65 LD L,B        ;
*$8C66 DEC L         ;
 $8C67 BIT 3,L       ;
 $8C69 JR NZ,$8C73   ;
 $8C6B OR (HL)       ;
 $8C6C JR Z,$8C66    ; }
 $8C6E LD C,$FF      ; {Piece hit (C=-1)
 $8C70 CALL $8C98    ; }
*$8C73 LD C,$10      ; {North (if not on rank 8)
 $8C75 LD A,B        ;
 $8C76 ADD A,C       ;
 $8C77 CALL P,$8C80  ; }
 $8C7A LD C,$F0      ; {South
 $8C7C LD L,B        ; }
; This entry point is used by the routine at #R$8C80.
@label=EvVerticalStep
*$8C7D LD A,L        ; {Next square; stop off the board
 $8C7E ADD A,C       ;
 $8C7F RET M         ; }

; Vertical ray: next square
;
; Part of #R$8C52.
@label=EvVerticalSquare
c$8C80 LD L,A        ; {Count mobility
 $8C81 INC E         ; }
 $8C82 XOR A         ; {Empty: continue
 $8C83 OR (HL)       ;
 $8C84 JR Z,$8C7D    ; }
 $8C86 EXX           ; {L'=record+4 of the piece; enemy (#R$8DB9)?
 $8C87 LD L,A        ;
 $8C88 XOR B         ;
 $8C89 JP M,$8DB9    ; }
 $8C8C LD A,C        ; {Friendly: defender count +weight
 $8C8D ADD A,(HL)    ;
 $8C8E LD (HL),A     ; }
 $8C8F SET 1,L       ; {Also an orthogonal mover?
 $8C91 LD A,(HL)     ;
 $8C92 AND E         ; }
 $8C93 EXX           ; {No: done
 $8C94 RET Z         ; }
 $8C95 JP $8DF8      ; Yes: x-ray through it (#R$8DF8)

; Horizontal ray: first piece hit
;
; Part of #R$8C52. Enemy pieces go to #R$8DB9; a friendly orthogonal mover is
; x-rayed to the next piece only (no mobility).
;
; A Piece code
; C Direction
@label=EvHorizontalHit
c$8C98 EXX           ; {Enemy?
 $8C99 LD L,A        ;
 $8C9A XOR B         ;
 $8C9B JP M,$8DB9    ; }
 $8C9E LD A,C        ; {Friendly: defender count +weight
 $8C9F ADD A,(HL)    ;
 $8CA0 LD (HL),A     ; }
 $8CA1 SET 1,L       ; {Also an orthogonal mover?
 $8CA3 LD A,(HL)     ;
 $8CA4 AND E         ; }
 $8CA5 EXX           ; {No: done
 $8CA6 RET Z         ; }
*$8CA7 LD A,L        ; {Look beyond it
 $8CA8 ADD A,C       ;
 $8CA9 LD L,A        ;
 $8CAA AND D         ;
 $8CAB RET NZ        ;
 $8CAC OR (HL)       ;
 $8CAD JR Z,$8CA7    ; }
 $8CAF EXX           ; {Enemy beyond: x-ray attacker (#R$8E07)
 $8CB0 LD L,A        ;
 $8CB1 XOR B         ;
 $8CB2 JP M,$8E07    ; }
 $8CB5 INC L         ; {Friendly beyond: x-ray defender (+5)
 $8CB6 LD A,C        ;
 $8CB7 ADD A,(HL)    ;
 $8CB8 LD (HL),A     ;
 $8CB9 EXX           ;
 $8CBA RET           ; }

; Black knight
;
; Used by #R$8400. A knight on its back rank costs 3.
;
; A Square
@label=EvBlackKnight
c$8CBB LD B,A        ; {On rank 8?
 $8CBC OR $70        ;
 $8CBE CP B          ;
 $8CBF JP NZ,$8CCD   ; }
; This entry point is used by the routine at #R$8CC8.
@label=EvKnightBackRank
*$8CC2 DEC E         ; {Yes: E=E-3
 $8CC3 DEC E         ;
 $8CC4 DEC E         ;
 $8CC5 JP $8CCD      ; }

; White knight
;
; Used by #R$8400.
;
; A Square
@label=EvWhiteKnight
c$8CC8 LD B,A        ; {On rank 1: penalty (#R$8CC2)
 $8CC9 AND $70       ;
 $8CCB JR Z,$8CC2    ; }
; This entry point is used by the routines at #R$8A96 and #R$8CBB.
@label=EvKnight
*$8CCD EXX           ; {C'=$04; E=E-1 (mobility counts target squares - 1)
 $8CCE LD C,$04      ;
 $8CD0 EXX           ;
 $8CD1 DEC E         ; }
; This entry point is used by the routine at #R$8EC9.
@label=EvKnightWalk
*$8CD2 LD A,$0E      ; {Upward targets +14, +18, +31, +33 (skipped if the first
 $8CD4 ADD A,B       ; leaves the top of the board)
 $8CD5 JP M,$8CF5    ;
 $8CD8 LD L,A        ;
 $8CD9 AND D         ;
 $8CDA CALL Z,$8D15  ;
 $8CDD LD A,$12      ;
 $8CDF ADD A,B       ;
 $8CE0 LD L,A        ;
 $8CE1 AND D         ;
 $8CE2 CALL Z,$8D15  ;
 $8CE5 LD A,$1F      ;
 $8CE7 ADD A,B       ;
 $8CE8 LD L,A        ;
 $8CE9 AND D         ;
 $8CEA CALL Z,$8D15  ;
 $8CED LD A,$21      ;
 $8CEF ADD A,B       ;
 $8CF0 LD L,A        ;
 $8CF1 AND D         ;
 $8CF2 CALL Z,$8D15  ; }
*$8CF5 LD A,$F2      ; {Downward targets -14, -18, -31, -33 (stops as soon as
 $8CF7 ADD A,B       ; one leaves the bottom)
 $8CF8 RET M         ;
 $8CF9 LD L,A        ;
 $8CFA AND D         ;
 $8CFB CALL Z,$8D15  ;
 $8CFE LD A,$EE      ;
 $8D00 ADD A,B       ;
 $8D01 LD L,A        ;
 $8D02 AND D         ;
 $8D03 CALL Z,$8D15  ;
 $8D06 LD A,$E1      ;
 $8D08 ADD A,B       ;
 $8D09 RET M         ;
 $8D0A LD L,A        ;
 $8D0B AND D         ;
 $8D0C CALL Z,$8D15  ;
 $8D0F LD A,$DF      ;
 $8D11 ADD A,B       ;
 $8D12 LD L,A        ;
 $8D13 AND D         ;
 $8D14 RET NZ        ; }

; Knight target square
;
; Part of #R$8CC8. Counts mobility and marks the piece found.
;
; L Target square
@label=EvKnightTarget
c$8D15 INC E         ; {Count mobility; empty: done
 $8D16 OR (HL)       ;
 $8D17 RET Z         ; }
 $8D18 EXX           ; {L'=record+4; friendly?
 $8D19 LD L,A        ;
 $8D1A XOR B         ;
 $8D1B JP P,$8D25    ; }
 $8D1E LD A,$78      ; {Enemy king: check (#R$8D2A)
 $8D20 AND L         ;
 $8D21 JR Z,$8D2A    ; }
 $8D23 DEC L         ; {Enemy: L'=record+2
 $8D24 DEC L         ; }
*$8D25 LD A,C        ; {Add the weight
 $8D26 ADD A,(HL)    ;
 $8D27 LD (HL),A     ;
 $8D28 EXX           ;
 $8D29 RET           ; }

; Knight attacks the enemy king
;
; First pass: abort. Second pass: flag the move as a check (bit 7 of IX+3); a
; first check marks the checking piece (+5 bit 1) and adds 2 to E, a second
; (double check) clears $BD4E and adds $14 to A'.
@label=EvKnightChecksKing
c$8D2A BIT 4,B        ; {First pass: abort
 $8D2C JP Z,$8C28     ; }
 $8D2F SET 7,(IX+$03) ; Flag check
 $8D33 BIT 6,B        ; {Already a check?
 $8D35 SET 6,B        ;
 $8D37 EXX            ;
 $8D38 JR NZ,$8D44    ; }
 $8D3A LD L,B         ; {First check: mark the checking piece (+5 bit 1)
 $8D3B LD L,(HL)      ;
 $8D3C INC L          ;
 $8D3D INC H          ;
 $8D3E SET 1,(HL)     ;
 $8D40 DEC H          ; }
 $8D41 INC E          ; {E=E+2
 $8D42 INC E          ;
 $8D43 RET            ; }
@label=EvKnightDoubleCheck
*$8D44 LD ($BD4E),A   ; {Double check: $BD4E=0, A'=A'+$14
 $8D47 EX AF,AF'      ;
 $8D48 ADD A,$14      ;
 $8D4A EX AF,AF'      ;
 $8D4B RET            ; }

; Slider attacks the enemy king
;
; As #R$8D2A, then the ray carries on beyond the king (#R$8DAA), counting
; mobility.
@label=EvSliderChecksKing
c$8D4C BIT 4,B        ; {First pass: abort
 $8D4E JP Z,$8C28     ; }
 $8D51 SET 7,(IX+$03) ; Flag check
 $8D55 BIT 6,B        ; {Already a check?
 $8D57 SET 6,B        ;
 $8D59 EXX            ;
 $8D5A JR NZ,$8D6A    ; }
 $8D5C LD A,L         ; {First check: mark the checking piece (+5 bit 1)
 $8D5D LD L,B         ;
 $8D5E LD L,(HL)      ;
 $8D5F INC L          ;
 $8D60 INC H          ;
 $8D61 SET 1,(HL)     ;
 $8D63 DEC H          ;
 $8D64 LD L,A         ; }
 $8D65 INC E          ; {E=E+2; continue the ray
 $8D66 INC E          ;
 $8D67 JP $8DAA       ; }
*$8D6A LD ($BD4E),A   ; {Double check: $BD4E=0, A'=A'+$14; continue the ray
 $8D6D EX AF,AF'      ;
 $8D6E ADD A,$14      ;
 $8D70 EX AF,AF'      ;
 $8D71 JP $8DAA       ; }

; White bishop
;
; Used by #R$8400. A bishop on its back rank costs 3.
;
; A Square
@label=EvWhiteBishop
c$8D74 LD B,A        ; {On rank 1?
 $8D75 AND $70       ;
 $8D77 JP NZ,$8D86   ; }
; This entry point is used by the routine at #R$8D80.
@label=EvBishopBackRank
*$8D7A DEC E         ; {E=E-3
 $8D7B DEC E         ;
 $8D7C DEC E         ;
 $8D7D JP $8D86      ; }

; Black bishop
;
; Used by #R$8400.
;
; A Square
@label=EvBlackBishop
c$8D80 LD B,A        ; {On rank 8: penalty
 $8D81 OR $70        ;
 $8D83 CP B          ;
 $8D84 JR Z,$8D7A    ; }
; This entry point is used by the routines at #R$8A96 and #R$8D74.
@label=EvBishop
*$8D86 EXX           ; {C'=$04
 $8D87 LD C,$04      ; }
; This entry point is used by the routine at #R$8C43.
@label=EvDiagonals
*$8D89 LD E,$C4      ; {E'=$C4 (pieces that move diagonally, and pawns)
 $8D8B EXX           ; }
 $8D8C LD C,$0F      ; {Up-left (+15)
 $8D8E LD A,B        ;
 $8D8F ADD A,C       ;
 $8D90 LD L,A        ;
 $8D91 AND D         ;
 $8D92 CALL Z,$8DAF  ; }
 $8D95 LD C,$11      ; {Up-right (+17)
 $8D97 LD A,B        ;
 $8D98 ADD A,C       ;
 $8D99 LD L,A        ;
 $8D9A AND D         ;
 $8D9B CALL Z,$8DAF  ; }
 $8D9E LD C,$EF      ; {Down-right (-17)
 $8DA0 LD A,B        ;
 $8DA1 ADD A,C       ;
 $8DA2 LD L,A        ;
 $8DA3 AND D         ;
 $8DA4 CALL Z,$8DAF  ; }
 $8DA7 LD C,$F1      ; {Down-left (-15)
 $8DA9 LD L,B        ; }
; This entry point is used by the routines at #R$8D4C and #R$8DAF.
@label=EvRayStep
*$8DAA LD A,L        ; {Next square; stop off the board
 $8DAB ADD A,C       ;
 $8DAC LD L,A        ;
 $8DAD AND D         ;
 $8DAE RET NZ        ; }

; Diagonal ray: next square and hits
;
; Part of #R$8D89 (also used after a king is passed). Every square up to and
; including the first piece adds 1 to E.
@label=EvRaySquare
c$8DAF INC E         ; {Count mobility; empty: continue
 $8DB0 OR (HL)       ;
 $8DB1 JR Z,$8DAA    ; }
 $8DB3 EXX           ; {L'=record+4; friendly (#R$8DEC)?
 $8DB4 LD L,A        ;
 $8DB5 XOR B         ;
 $8DB6 JP P,$8DEC    ; }
; This entry point is used by the routines at #R$8C80 and #R$8C98.
@label=EvEnemyHit
*$8DB9 LD A,$78      ; {Enemy king (#R$8D4C)?
 $8DBB AND L         ;
 $8DBC JR Z,$8D4C    ; }
 $8DBE DEC L         ; {Attacker count +weight (record +2)
 $8DBF DEC L         ;
 $8DC0 LD A,C        ;
 $8DC1 ADD A,(HL)    ;
 $8DC2 LD (HL),A     ; }
 $8DC3 SET 2,L       ; {Enemy also moves along this line (record +6 AND E', not
 $8DC5 LD A,(HL)     ; a pawn)?
 $8DC6 AND E         ;
 $8DC7 JR Z,$8E19    ; }
 $8DC9 JP M,$8E19    ; No: look for what it shields (#R$8E19)
 $8DCC EXX           ; {Yes: look beyond it
*$8DCD LD A,L        ;
 $8DCE ADD A,C       ;
 $8DCF LD L,A        ;
 $8DD0 AND D         ;
 $8DD1 RET NZ        ;
 $8DD2 OR (HL)       ;
 $8DD3 JR Z,$8DCD    ; }
 $8DD5 EXX           ; {D'=record+6 of the first piece; friendly beyond?
 $8DD6 LD D,L        ;
 $8DD7 LD L,A        ;
 $8DD8 XOR B         ;
 $8DD9 JP P,$8E15    ; }
 $8DDC DEC L         ; {Enemy beyond: x-ray attacker (+3)
 $8DDD LD A,C        ;
 $8DDE ADD A,(HL)    ;
 $8DDF LD (HL),A     ;
 $8DE0 INC L         ; }
@label=EvPinTest
*$8DE1 INC L         ; {Piece beyond is a king (+6 bit 0): pin
 $8DE2 INC L         ;
 $8DE3 LD A,(HL)     ;
 $8DE4 RRA           ;
 $8DE5 JR C,$8E2F    ; }
 $8DE7 RRA           ; {A queen (+6 bit 1): pin unless the scanning piece is a
 $8DE8 JR C,$8E2B    ; queen}
 $8DEA EXX           ; {Neither
 $8DEB RET           ; }
@label=EvFriendlyHit
*$8DEC LD A,C        ; {Friendly: defender count +weight
 $8DED ADD A,(HL)    ;
 $8DEE LD (HL),A     ; }
@label=EvFriendlyHit2
*$8DEF SET 1,L       ; {Does it move along this line?
 $8DF1 LD A,(HL)     ;
 $8DF2 AND E         ; }
 $8DF3 EXX           ; {No: done
 $8DF4 RET Z         ; }
 $8DF5 JP M,$8E5C    ; A pawn: one-square x-ray (#R$8E5C)
; This entry point is used by the routine at #R$8C80.
@label=EvXrayChain
*$8DF8 LD A,L        ; {Continue the ray, counting mobility
 $8DF9 ADD A,C       ;
 $8DFA LD L,A        ;
 $8DFB AND D         ;
 $8DFC RET NZ        ;
 $8DFD INC E         ;
 $8DFE OR (HL)       ;
 $8DFF JR Z,$8DF8    ; }
 $8E01 EXX           ; {Enemy: x-ray attacker (+3)
 $8E02 LD L,A        ;
 $8E03 XOR B         ;
 $8E04 JP P,$8E0D    ; }
; This entry point is used by the routine at #R$8C98.
@label=EvXrayAttacker
*$8E07 DEC L         ; L'=record+3 (from +4)
*$8E08 LD A,C        ; {Add the weight
 $8E09 ADD A,(HL)    ;
 $8E0A LD (HL),A     ;
 $8E0B EXX           ;
 $8E0C RET           ; }
*$8E0D INC L         ; {Friendly: x-ray defender (+5); and onwards if it also
 $8E0E LD A,C        ; moves this way
 $8E0F ADD A,(HL)    ;
 $8E10 LD (HL),A     ;
 $8E11 DEC L         ;
 $8E12 JP $8DEF      ; }
@label=EvXrayDefender
*$8E15 INC L         ; {L'=record+5
 $8E16 JP $8E08      ; }
@label=EvShieldTest
*$8E19 EXX           ; {Look beyond the enemy piece
*$8E1A LD A,L        ;
 $8E1B ADD A,C       ;
 $8E1C LD L,A        ;
 $8E1D AND D         ;
 $8E1E RET NZ        ;
 $8E1F OR (HL)       ;
 $8E20 JR Z,$8E1A    ; }
 $8E22 EXX           ; {D'=record+6 of the first piece; an enemy piece beyond?
 $8E23 LD D,L        ;
 $8E24 LD L,A        ;
 $8E25 XOR B         ;
 $8E26 JP M,$8DE1    ; }
 $8E29 EXX           ; {Friendly or nothing: done
 $8E2A RET           ; }

; Record a pin
;
; Part of #R$8DAF. The pin list at $BD79 holds up to six (record, direction)
; pairs terminated by 0. A piece pinned twice gets direction 0. Adds 2 to E for
; a new pin (1 for a repeated one; 2 if the list is full).
@label=EvPinQueen
c$8E2B BIT 6,C       ; {Pinned against a queen by a queen: E=E+2 only (#R$8E58)
 $8E2D JR NZ,$8E58   ; }
; This entry point is used by the routine at #R$8DAF.
@label=EvRecordPin
*$8E2F RES 1,D       ; {D' = record base of the pinned piece
 $8E31 RES 2,D       ; }
 $8E33 LD HL,$BD79   ; {Search the pin list
*$8E36 LD A,(HL)     ;
 $8E37 OR A          ;
 $8E38 JR Z,$8E47    ; }
 $8E3A INC L         ; {Next entry
 $8E3B INC L         ;
 $8E3C CP D          ;
 $8E3D JP NZ,$8E36   ; }
 $8E40 DEC L         ; {Already pinned: direction 0, E=E+1
 $8E41 LD (HL),$00   ;
 $8E43 INC H         ;
 $8E44 EXX           ;
 $8E45 INC E         ;
 $8E46 RET           ; }
*$8E47 LD A,L        ; {List full (6 entries)?
 $8E48 CP $84        ;
 $8E4A JR NC,$8E57   ; }
 $8E4C LD (HL),D     ; {Append (record, direction) and a terminator
 $8E4D INC L         ;
 $8E4E EXX           ;
 $8E4F LD A,C        ;
 $8E50 EXX           ;
 $8E51 LD (HL),A     ;
 $8E52 INC L         ;
 $8E53 LD (HL),$00   ; }
 $8E55 SET 5,B       ; Flag the pin list (B' bit 5)
*$8E57 INC H         ; H'=$BE
*$8E58 EXX           ; {E=E+2
 $8E59 INC E         ;
 $8E5A INC E         ;
 $8E5B RET           ; }

; Bishop or queen behind a friendly pawn
;
; Part of #R$8DAF. If the ray runs in the pawn's capturing direction, the piece
; on the square beyond the pawn (if any) gets an x-ray defence (+5) or x-ray
; attack (+3).
;
; A Pawn's record +6 AND $C4
; C Direction
@label=EvPawnXray
c$8E5C RLA           ; {Ray runs in the pawn's direction?
 $8E5D XOR C         ;
 $8E5E RET P         ; }
 $8E5F LD A,L        ; {Next square (on the board, occupied)
 $8E60 ADD A,C       ;
 $8E61 LD L,A        ;
 $8E62 AND D         ;
 $8E63 RET NZ        ;
 $8E64 OR (HL)       ;
 $8E65 RET Z         ; }
 $8E66 EXX           ; {Friendly: +5, enemy: +3
 $8E67 LD L,A        ;
 $8E68 INC L         ;
 $8E69 XOR B         ;
 $8E6A JP P,$8E6F    ;
 $8E6D DEC L         ;
 $8E6E DEC L         ;
*$8E6F LD A,C        ;
 $8E70 ADD A,(HL)    ;
 $8E71 LD (HL),A     ;
 $8E72 EXX           ;
 $8E73 RET           ; }

; Remove the attacks of pinned pieces
;
; Used by #R$8400 when bit 5 of B' is set. For each (record, direction) in
; $BD79, subtracts the pinned piece's direct attacks in every direction except
; the pin line. E and D are preserved; B' is overwritten with the pinned
; piece's colour. Finally empties the list.
@label=EvUndoPins
c$8E74 LD IY,$BD79   ; {IY=pin list
 $8E78 PUSH DE       ;
 $8E79 LD H,$BD      ; }
 $8E7B EXX           ; {L'=pinned piece's record
 $8E7C LD L,(IY+$00) ; }
; This entry point is used by the routine at #R$8F1B.
@label=EvUndoPin
*$8E7F LD BC,$8F1B   ; {Return to #R$8F1B afterwards
 $8E82 PUSH BC       ; }
 $8E83 LD A,L        ; {B'=colour; E'=square
 $8E84 AND $80       ;
 $8E86 LD B,A        ;
 $8E87 LD E,(HL)     ; }
 $8E88 INC L         ; {Type AND $8E: 0 = pawn
 $8E89 LD A,(HL)     ;
 $8E8A AND $8E       ;
 $8E8C JR Z,$8E9F    ; }
 $8E8E JP M,$8EE4    ; Bishop (#R$8EE4)
 $8E91 CP $04        ; {Knight (#R$8EC9)
 $8E93 JR C,$8EC9    ; }
 $8E95 JR Z,$8ED5    ; Rook (#R$8ED5)
 $8E97 LD C,$C0      ; {Queen: weight -$40 on rook lines and diagonals
 $8E99 CALL $8ED7    ;
 $8E9C JP $8EED      ; }
; This entry point is used by the routine at #R$8ED7.
@label=EvUndoPawnPin
*$8E9F BIT 7,B       ; {Pawn: B=square, C=+15 or -17 (left capture)
 $8EA1 LD A,E        ;
 $8EA2 EXX           ;
 $8EA3 LD B,A        ;
 $8EA4 LD C,$0F      ;
 $8EA6 JR Z,$8EAA    ;
 $8EA8 LD C,$EF      ; }
*$8EAA CALL $8EAF    ; {Left capture, then right capture
 $8EAD INC C         ;
 $8EAE INC C         ; }

; Undo one pawn capture direction
;
; Part of #R$8E74. Skipped if the direction is along the pin line.
;
; B Square
; C Direction
@label=EvUndoPawnCapture
c$8EAF LD A,(IY+$01) ; {Along the pin line: keep
 $8EB2 CP C          ;
 $8EB3 RET Z         ;
 $8EB4 NEG           ;
 $8EB6 CP C          ;
 $8EB7 RET Z         ; }
 $8EB8 LD A,C        ; {Piece on the target square?
 $8EB9 ADD A,B       ;
 $8EBA LD L,A        ;
 $8EBB XOR A         ;
 $8EBC OR (HL)       ;
 $8EBD RET Z         ; }
 $8EBE EXX           ; {Friendly: defender count -1; enemy: attacker count -1
 $8EBF LD L,A        ;
 $8EC0 XOR B         ;
 $8EC1 JP P,$8EC6    ;
 $8EC4 DEC L         ;
 $8EC5 DEC L         ;
*$8EC6 DEC (HL)      ;
 $8EC7 EXX           ;
 $8EC8 RET           ; }

; Undo a pinned knight
;
; Part of #R$8E74. Re-walks the knight with weight -4 (a pinned knight attacks
; nothing). B' bit 4 is set so a knight 'check' is flagged rather than
; aborting.
@label=EvUndoKnightPin
c$8EC9 LD C,$FC      ; {C'=-4; B' bit 4 set
 $8ECB SET 4,B       ; }
 $8ECD LD A,E        ; {Re-walk the knight (#R$8CD2)
 $8ECE EXX           ;
 $8ECF LD D,$88      ;
 $8ED1 LD B,A        ;
 $8ED2 JP $8CD2      ; }
; This entry point is used by the routine at #R$8E74.
@label=EvUndoRookPin
*$8ED5 LD C,$F0      ; Rook: C'=-$10

; Undo rook-line attacks
;
; Part of #R$8E74.
@label=EvUndoOrthogonals
c$8ED7 LD A,E        ; {B=square
 $8ED8 EXX           ; }
 $8ED9 LD C,$01      ; {Horizontal
 $8EDB LD B,A        ;
 $8EDC CALL $8EF4    ; }
 $8EDF LD C,$10      ; {Vertical
 $8EE1 JP $8EF4      ; }
; This entry point is used by the routine at #R$8E74.
@label=EvUndoBishopPin
*$8EE4 AND $02       ; {Bishop type? (otherwise treat as a pawn)
 $8EE6 JR Z,$8E9F    ; }
 $8EE8 LD C,$FC      ; {C'=-4
 $8EEA LD A,E        ;
 $8EEB EXX           ;
 $8EEC LD B,A        ; }
; This entry point is used by the routine at #R$8E74.
@label=EvUndoDiagonals
*$8EED LD C,$0F      ; {Diagonal +15/-15
 $8EEF CALL $8EF4    ; }
 $8EF2 LD C,$11      ; Diagonal +17/-17

; Undo the attacks along one line
;
; Part of #R$8E74. Skipped if the line is the pin line; otherwise both
; directions.
;
; C Direction
@label=EvUndoLine
c$8EF4 LD A,(IY+$01) ; {Along the pin line: keep
 $8EF7 CP C          ;
 $8EF8 RET Z         ;
 $8EF9 NEG           ;
 $8EFB CP C          ;
 $8EFC RET Z         ; }
 $8EFD LD D,$88      ; {Forward
 $8EFF CALL $8F05    ; }
 $8F02 XOR A         ; {Backward
 $8F03 SUB C         ;
 $8F04 LD C,A        ; }

; Undo the first attack along a ray
;
; Part of #R$8E74.
@label=EvUndoRay
c$8F05 LD L,B        ; {Find the first piece
*$8F06 LD A,L        ;
 $8F07 ADD A,C       ;
 $8F08 LD L,A        ;
 $8F09 AND D         ;
 $8F0A RET NZ        ;
 $8F0B OR (HL)       ;
 $8F0C JR Z,$8F06    ; }
 $8F0E EXX           ; {Friendly: +4 += C'; enemy: +2 += C'
 $8F0F LD L,A        ;
 $8F10 XOR B         ;
 $8F11 JP P,$8F16    ;
 $8F14 DEC L         ;
 $8F15 DEC L         ;
*$8F16 LD A,C        ;
 $8F17 ADD A,(HL)    ;
 $8F18 LD (HL),A     ;
 $8F19 EXX           ;
 $8F1A RET           ; }

; Next pin-list entry
;
; Return point for #R$8E7F.
@label=EvNextPin
c$8F1B LD A,(IY+$02) ; {Another entry?
 $8F1E OR A          ;
 $8F1F JR Z,$8F2A    ; }
 $8F21 INC IY        ; {Yes: process it
 $8F23 INC IY        ;
 $8F25 EXX           ;
 $8F26 LD L,A        ;
 $8F27 JP $8E7F      ; }
*$8F2A POP DE        ; {Done: restore DE, empty the list
 $8F2B LD ($BD79),A  ;
 $8F2E RET           ; }

; Unused
;
; Zero padding up to the start of the opening book at $9000.
s$8F2F DEFS $D1

; Opening book
;
; A pre-order tree of 2685 9-bit entries (24165 bits, $9000-$9BCC), read by
; #R$7B64 and walked by #R$7AC7. Entry n occupies bit-stream bits 9n to 9n+8
; (most significant bit first); each DEFB line below holds 9 bytes, i.e.
; entries 8k to 8k+7, where k is the line number counting from 0.
; .
; Entry layout, from the most significant bit: bit 8 'M' (on the first entry of
; a sibling list it raises that move's chance of being chosen from 1/2 to 3/4;
; on any later entry it stops the random choice before that entry, so it and
; all later siblings are never chosen, only followed when the opponent plays
; them); bit 7 = leaf (no stored continuation); bit 6 = more siblings follow;
; bits 0-5 = index of the move in the list produced by the move generator
; #R$78CE for that position (move = $B404+4*index). A non-leaf entry is
; followed immediately by the sibling list of its replies. The root list (entry
; 0) holds White's first moves: 1.e4, 1.d4, 1.c4, 1.Nf3, 1.b3 (M), 1.f4 (M).
; .
; The decoded tree is in docs/arch/book-tree.txt (generated by
; tools/scripts/book_dump.py): 396 leaves, 123 entries with M set, maximum
; depth 31 plies.
@label=BOOK_DATA
b$9000 DEFB $26,$92,$69,$C4,$CA,$B0,$4C,$2E,$0D ; {Entries 0-2684
 $9009 DEFB $0A,$16,$49,$E0,$90,$00,$34,$0E,$97 ;
 $9012 DEFB $13,$03,$01,$80,$A0,$22,$70,$B6,$4B ;
 $901B DEFB $05,$94,$80,$00,$00,$80,$64,$12,$29 ;
 $9024 DEFB $4A,$8A,$00,$00,$60,$80,$51,$10,$4F ;
 $902D DEFB $05,$82,$42,$40,$00,$00,$64,$12,$29 ;
 $9036 DEFB $4A,$C9,$81,$62,$20,$A0,$40,$10,$28 ;
 $903F DEFB $0D,$08,$42,$02,$30,$30,$71,$00,$14 ;
 $9048 DEFB $26,$86,$05,$60,$A0,$20,$0C,$00,$92 ;
 $9051 DEFB $27,$86,$43,$28,$E2,$58,$64,$38,$0A ;
 $905A DEFB $04,$24,$CC,$C1,$90,$C0,$08,$1C,$1E ;
 $9063 DEFB $00,$25,$C2,$21,$80,$90,$54,$00,$8B ;
 $906C DEFB $03,$12,$90,$04,$C4,$C0,$14,$1A,$05 ;
 $9075 DEFB $40,$11,$2A,$C0,$F0,$B9,$24,$28,$53 ;
 $907E DEFB $26,$87,$01,$05,$70,$00,$28,$48,$9B ;
 $9087 DEFB $05,$00,$00,$02,$40,$60,$19,$06,$51 ;
 $9090 DEFB $0E,$53,$81,$40,$40,$02,$04,$A4,$0A ;
 $9099 DEFB $07,$00,$00,$81,$40,$0A,$04,$00,$0A ;
 $90A2 DEFB $05,$80,$02,$40,$81,$2A,$3C,$1E,$1D ;
 $90AB DEFB $2D,$08,$40,$00,$F0,$42,$00,$32,$0E ;
 $90B4 DEFB $00,$20,$0A,$A5,$D2,$50,$7C,$16,$18 ;
 $90BD DEFB $0D,$08,$03,$E1,$30,$00,$01,$42,$5A ;
 $90C6 DEFB $07,$86,$C2,$A1,$A0,$FA,$3E,$12,$1C ;
