 $6DB1 DEFM "oggle-colour Unoccupied        Pawn       kNight     Bishop    Ro" ;
 $6DF2 DEFM "ok       Queen      King      5-left 6-down 7-up 8-righ"           ;
 $6E29 DEFB $F4                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $6E2A CALL $6FEF                                                               ;
 $6E2D CALL $740E                                                               ;
 $6E30 DEFM "CHANGE POSITIO"                                                    ;
 $6E3E DEFB $CE                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $6E3F LD A,($BCA2)                                                             ;
 $6E42 CP $03                                                                   ;
 $6E44 JR Z,$6E50                                                               ;
 $6E46 CALL $73FE                                                               ;
 $6E49 DEFM "WHIT"                                                              ;
 $6E4D DEFB $C5                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $6E4E JR $6E58                                                                 ;
*$6E50 CALL $73FE                                                               ;
 $6E53 DEFM "BLAC"                                                              ;
 $6E57 DEFB $CB                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
@label=SetupKey
*$6E58 CALL $677E                                                               ; {Read a
 $6E5B CALL $703F                                                               ; key
 $6E5E LD A,($BCC0)                                                             ; (cursor
 $6E61 CP $45                                                                   ; keys, S
 $6E63 JP Z,$6ECC                                                               ; and O are
                                                                                ; handled by
                                                                                ; #R$677E)}
 $6E66 CP $47                                                                   ; {G: new
 $6E68 JR NZ,$6E73                                                              ; game
 $6E6A CALL $7046                                                               ; prompt,
 $6E6D CALL $6985                                                               ; then back
 $6E70 JP $6D6A                                                                 ; to set-up}
*$6E73 CP $54                                                                   ; {T: toggle
 $6E75 JR NZ,$6E82                                                              ; the colour
 $6E77 LD A,($BCA2)                                                             ; (and the
 $6E7A XOR $80                                                                  ; side to
 $6E7C LD ($BCA2),A                                                             ; move on
 $6E7F JP $6D6A                                                                 ; exit)}
*$6E82 CP $41                                                                   ; {A: all
 $6E84 JR NZ,$6E8B                                                              ; clear
 $6E86 CALL $658E                                                               ; (every
 $6E89 JR $6EC4                                                                 ; piece-list
                                                                                ; entry
                                                                                ; absent)}
*$6E8B CP $55                                                                   ; {U: empty
 $6E8D JR NZ,$6E98                                                              ; the cursor
 $6E8F LD A,($BCCA)                                                             ; square
 $6E92 LD L,A                                                                   ;
 $6E93 LD H,$BD                                                                 ;
 $6E95 XOR A                                                                    ;
 $6E96 JR $6EB4                                                                 ; }
*$6E98 LD HL,$6F2F                                                              ; {K, Q, R,
 $6E9B CALL $6F23                                                               ; B, N, P:
 $6E9E JP C,$6D6A                                                               ; look up
 $6EA1 INC HL                                                                   ; the slot
 $6EA2 LD A,(HL)                                                                ; offset for
 $6EA3 LD ($BCA3),A                                                             ; the key;
                                                                                ; any other
                                                                                ; key just
                                                                                ; redraws}
 $6EA6 LD A,($BCCA)                                                             ; {Put the
 $6EA9 LD L,A                                                                   ; set-up
 $6EAA LD H,$BD                                                                 ; code
 $6EAC LD A,($BCA3)                                                             ; (offset +
 $6EAF LD B,A                                                                   ; colour) on
 $6EB0 LD A,($BCA2)                                                             ; the cursor
 $6EB3 ADD A,B                                                                  ; square}
*$6EB4 LD C,(HL)                                                                ; {If a real
 $6EB5 LD (HL),A                                                                ; piece was
 $6EB6 BIT 0,C                                                                  ; there (bit
 $6EB8 JR NZ,$6EC4                                                              ; 0 clear,
 $6EBA BIT 2,C                                                                  ; bit 2
 $6EBC JR Z,$6EC4                                                               ; set), mark
 $6EBE RES 2,C                                                                  ; its
 $6EC0 LD L,C                                                                   ; piece-list
 $6EC1 INC H                                                                    ; entry
 $6EC2 SET 7,(HL)                                                               ; absent}
*$6EC4 LD A,$02                                                                 ; {Position
 $6EC6 LD ($BD4D),A                                                             ; changed
 $6EC9 JP $6D6A                                                                 ; }
@label=SetupExit
*$6ECC LD A,($BCA2)                                                             ; {E: side
 $6ECF LD HL,$BD2D                                                              ; to move =
 $6ED2 LD B,(HL)                                                                ; colour
 $6ED3 RES 0,B                                                                  ; shown.
 $6ED5 SUB $03                                                                  ; White:
 $6ED7 LD ($BCBE),A                                                             ; Cyrus
 $6EDA LD A,$02                                                                 ; plays
 $6EDC JR Z,$6EE2                                                               ; Black
 $6EDE SET 0,B                                                                  ; ($BCBE =
 $6EE0 LD A,$01                                                                 ; $80),
*$6EE2 LD ($BCC2),A                                                             ; HUMAN v
                                                                                ; CYRUS;
                                                                                ; Black:
                                                                                ; Cyrus
                                                                                ; plays
                                                                                ; White
                                                                                ; ($BCBE =
                                                                                ; 0), CYRUS
                                                                                ; v HUMAN}
 $6EE5 LD A,B                                                                   ; {Store the
 $6EE6 CP (HL)                                                                  ; side to
 $6EE7 JR Z,$6EEF                                                               ; move; a
 $6EE9 LD (HL),B                                                                ; change
 $6EEA LD A,$02                                                                 ; counts as
 $6EEC LD ($BD4D),A                                                             ; a change
                                                                                ; of
                                                                                ; position}
*$6EEF LD A,($BD4D)                                                             ; {Nothing
 $6EF2 OR A                                                                     ; changed:
 $6EF3 JP Z,$60B7                                                               ; back to
                                                                                ; the game
                                                                                ; (history
                                                                                ; kept)}
 $6EF6 CALL $65DA                                                               ; Give the
                                                                                ; set-up
                                                                                ; pieces
                                                                                ; slots
                                                                                ; (checks
                                                                                ; pawns on
                                                                                ; rank 1/8,
                                                                                ; piece
                                                                                ; counts and
                                                                                ; both
                                                                                ; kings)
 $6EF9 CALL $6F99                                                               ; Reset the
                                                                                ; 50-move
                                                                                ; counter,
                                                                                ; $BD0D and
                                                                                ; the
                                                                                ; last-move/repetition
                                                                                ; data (so
                                                                                ; no en
                                                                                ; passant is
                                                                                ; possible)
 $6EFC LD A,$0A                                                                 ; {Move
 $6EFE LD ($BD49),A                                                             ; number 10;
 $6F01 LD A,$80                                                                 ; score
 $6F03 LD ($BCA0),A                                                             ; $BCA0 =
                                                                                ; $80}
 $6F06 CALL $7810                                                               ; {Pre-search
 $6F09 JP Z,$6588                                                               ; set-up
                                                                                ; (#R$7810):
                                                                                ; returns Z
                                                                                ; if the
                                                                                ; side not
                                                                                ; to move is
                                                                                ; in check -
                                                                                ; ILLEGAL}
 $6F0C CALL $6F77                                                               ; {Save this
 $6F0F LD A,$FF                                                                 ; as the
 $6F11 LD ($C058),A                                                             ; start
                                                                                ; position;
                                                                                ; empty the
                                                                                ; game
                                                                                ; record}
 $6F14 LD A,($BCD4)                                                             ; {Listing
 $6F17 OR A                                                                     ; on: print
 $6F18 JR NZ,$6F20                                                              ; a rule and
 $6F1A CALL $7065                                                               ; the board
 $6F1D CALL $729D                                                               ; }
*$6F20 JP $60A7                                                                 ; Start the
                                                                                ; game from
                                                                                ; here

; Search the piece table
;
; Compares A with every third byte from HL (6 entries). Returns with HL at the
; match, or carry set if none.
@label=FindPieceRow
c$6F23 LD B,$06      ;
*$6F25 CP (HL)       ;
 $6F26 RET Z         ;
 $6F27 INC HL        ;
 $6F28 INC HL        ;
 $6F29 INC HL        ;
 $6F2A DJNZ $6F25    ;
 $6F2C SCF           ;
 $6F2D RET           ;

; Piece table and hidden copyright
;
; Six rows of (value byte, key, slot offset): K, Q, R, B, N, P. Searched by
; value from $6F2E and by key from $6F2F.
@label=PieceTable
b$6F2E DEFB $00,$4B,$00
 $6F31 DEFB $09,$51,$08
 $6F34 DEFB $05,$52,$10
 $6F37 DEFB $83,$42,$20
 $6F3A DEFB $03,$4E,$30
 $6F3D DEFB $01,$50,$40
 $6F40 DEFM "(C) 1982 Intelligent Software Ltd.Author : Richard Lang" ; Copyright
                                                                      ; notice
                                                                      ; (never
                                                                      ; printed)

; Save the start position
;
; $C005 = side to move ($BD2D), $C006 = move number, $C007-$C046 = (square,
; value) of the 32 piece-list entries.
@label=SaveStartPosition
c$6F77 LD A,($BD2D)  ;
 $6F7A LD ($C005),A  ;
 $6F7D LD A,($BD49)  ;
 $6F80 LD ($C006),A  ;
 $6F83 LD HL,$BE00   ;
 $6F86 LD DE,$C007   ;
 $6F89 LD B,$20      ;
*$6F8B LD A,(HL)     ;
 $6F8C LD (DE),A     ;
 $6F8D INC HL        ;
 $6F8E INC DE        ;
 $6F8F LD A,(HL)     ;
 $6F90 LD (DE),A     ;
 $6F91 INC DE        ;
 $6F92 LD A,L        ;
 $6F93 ADD A,$07     ;
 $6F95 LD L,A        ;
 $6F96 DJNZ $6F8B    ;
 $6F98 RET           ;

; Reset per-game counters
;
; Zeroes the 50-move counter $BD0A, $BD0D, and $BD59-$BD5E (last two moves and
; the repetition counter). As a result no en passant capture is possible after
; set-up, and a side that is checkmated in the set-up position is reported as
; stalemated.
@label=ResetGameCounters
c$6F99 XOR A         ;
 $6F9A LD ($BD0A),A  ;
 $6F9D LD ($BD0D),A  ;
 $6FA0 LD HL,$BD59   ;
 $6FA3 LD B,$06      ;
*$6FA5 LD (HL),A     ;
 $6FA6 INC L         ;
 $6FA7 DJNZ $6FA5    ;
 $6FA9 RET           ;

; Clear the root exclusion list
;
; Writes the $FF terminator at $BF00.
@label=ClearExclusionList
c$6FAA LD A,$FF      ;
 $6FAC LD ($BF00),A  ;
 $6FAF RET           ;

; Beep
;
; Two inline bytes follow the CALL: duration (outer count) and pitch
; (half-period). Silent if $BCD3 is set (sound off), but takes the same time.
@label=Beep
c$6FB0 POP HL        ;
 $6FB1 LD A,(HL)     ;
 $6FB2 INC HL        ;
 $6FB3 LD ($BCD1),A  ;
 $6FB6 LD A,(HL)     ;
 $6FB7 INC HL        ;
 $6FB8 LD ($BCD2),A  ;
 $6FBB PUSH HL       ;
 $6FBC LD A,$07      ;
 $6FBE LD HL,$BCD1   ;
 $6FC1 LD D,(HL)     ;
 $6FC2 LD E,$00      ;
 $6FC4 LD HL,$BCD2   ;
*$6FC7 LD B,(HL)     ;
 $6FC8 XOR $10       ;
 $6FCA LD C,A        ;
 $6FCB LD A,($BCD3)  ;
 $6FCE OR A          ;
 $6FCF LD A,C        ;
 $6FD0 JR NZ,$6FD4   ;
 $6FD2 OUT ($FE),A   ;
*$6FD4 DEC E         ;
 $6FD5 JR NZ,$6FD9   ;
 $6FD7 DEC D         ;
 $6FD8 RET Z         ;
*$6FD9 DJNZ $6FD4    ;
 $6FDB JR $6FC7      ;

; Set the print position from two inline bytes
;
; Used by the routines at #R$6000, #R$61C8, #R$7004, #R$703F, #R$7046, #R$704D,
; #R$73F7, #R$73FE, #R$7405, #R$740E, #R$746E, #R$751B and #R$756E.
@label=SetPrintPosInline
c$6FDD POP HL        ;
 $6FDE PUSH AF       ;
 $6FDF CALL $6FE4    ;
 $6FE2 POP AF        ;
 $6FE3 JP (HL)       ;

; Read the print position (row, column) at HL
;
; Used by the routines at #R$6FDD and #R$7415.
@label=ReadPrintPos
c$6FE4 LD A,(HL)     ;
 $6FE5 LD ($BCC5),A  ;
 $6FE8 INC HL        ;
 $6FE9 LD A,(HL)     ;
 $6FEA LD ($BCC6),A  ;
 $6FED INC HL        ;
 $6FEE RET           ;

; Clear from the print position to the bottom of the screen (attribute $28)
;
; Used by the routines at #R$6000, #R$61C8, #R$63B1, #R$641A, #R$6985, #R$69C9,
; #R$6A8D, #R$6BCF, #R$6D4D, #R$73AE and #R$73D4.
@label=ClearCommandArea
c$6FEF LD A,$18      ;
 $6FF1 LD HL,$BCC5   ;
 $6FF4 SUB (HL)      ;
 $6FF5 LD C,A        ;
 $6FF6 LD A,$20      ;
 $6FF8 LD HL,$BCC6   ;
 $6FFB SUB (HL)      ;
 $6FFC LD B,A        ;
 $6FFD LD A,$28      ;
 $6FFF LD ($BCC4),A  ;
 $7002 JR $7012      ;

; Clear the top 18 rows (attribute $38)
;
; Used by the routines at #R$6000 and #R$607F.
@label=ClearScreen
c$7004 CALL $6FDD    ;
 $7007 DEFB $00,$00  ; Inline arguments: row, column
 $7009 LD A,$38      ;
 $700B LD ($BCC4),A  ;
 $700E LD C,$12      ;
*$7010 LD B,$20      ;
; This entry point is used by the routine at #R$6FEF.
*$7012 LD A,$20      ;
 $7014 CALL $7226    ;
 $7017 DJNZ $7012    ;
 $7019 DEC C         ;
 $701A JR NZ,$7010   ;
 $701C RET           ;

; Clear the move display lines (5 and 6)
;
; Used by the routines at #R$607F and #R$6D4D.
@label=ClearMoveLines
c$701D CALL $7415         ;
 $7020 DEFB $05,$00       ; Inline arguments: row, column
 $7022 DEFM "           " ;
 $702D DEFB $A0           ; Last character (bit 7 set)
 $702E CALL $7415         ;
 $7031 DEFB $06,$04       ; Inline arguments: row, column
 $7033 DEFM "          "  ;
 $703D DEFB $A0           ; Last character (bit 7 set)
 $703E RET                ;

; Clear message line 12
;
; Used by the routines at #R$60B7, #R$6147, #R$61C8, #R$641A, #R$6734, #R$69C9,
; #R$6CF4, #R$6D25 and #R$6D4D.
@label=ClearLine12
c$703F CALL $6FDD    ;
 $7042 DEFB $0C,$00  ; Inline arguments: row, column
 $7044 JR $7052      ;

; Clear message line 11
;
; Used by the routines at #R$60B7, #R$6869 and #R$6D4D.
@label=ClearLine11
c$7046 CALL $6FDD    ;
 $7049 DEFB $0B,$00  ; Inline arguments: row, column
 $704B JR $7052      ;

; Clear message line 10
;
; Used by the routines at #R$60B7, #R$641A, #R$6869, #R$6985, #R$69C9, #R$6A8D,
; #R$6BCF and #R$7BF1.
@label=ClearLine10
c$704D CALL $6FDD            ;
 $7050 DEFB $0A,$00          ; Inline arguments: row, column
; This entry point is used by the routines at #R$703F and #R$7046.
*$7052 CALL $741A            ;
 $7055 DEFM "              " ;
 $7063 DEFB $A0              ; Last character (bit 7 set)
 $7064 RET                   ;

; Print a rule of '=' on the ZX Printer
;
; Used by the routines at #R$607F, #R$69C9 and #R$6D4D.
@label=PrinterRule
c$7065 CALL $7071    ;
 $7068 LD A,$3D      ;
 $706A LD B,$20      ;
*$706C CALL $734D    ;
 $706F DJNZ $706C    ;

; Send the printer buffer ($5B00) to the ZX Printer and clear it
;
; Used by the routines at #R$7065, #R$729D, #R$743B and #R$7452.
@label=PrinterFlushLine
c$7071 PUSH AF       ;
 $7072 PUSH BC       ;
 $7073 PUSH HL       ;
 $7074 LD HL,$5B00   ;
 $7077 XOR A         ;
 $7078 OUT ($FB),A   ;
 $707A LD B,$08      ;
*$707C IN A,($FB)    ;
 $707E AND $80       ;
 $7080 JR Z,$707C    ;
 $7082 LD C,$20      ;
*$7084 CALL $70A9    ;
 $7087 LD A,L        ;
 $7088 ADD A,$08     ;
 $708A LD L,A        ;
 $708B DEC C         ;
 $708C JR NZ,$7084   ;
 $708E INC HL        ;
 $708F DJNZ $707C    ;
 $7091 LD A,$04      ;
 $7093 OUT ($FB),A   ;
 $7095 CALL $709C    ;
 $7098 POP HL        ;
 $7099 POP BC        ;
 $709A POP AF        ;
 $709B RET           ;

; Clear the printer buffer
;
; Used by the routines at #R$605B and #R$7071.
@label=PrinterClearBuffer
c$709C XOR A         ;
 $709D LD ($BCDC),A  ;
 $70A0 LD B,A        ;
 $70A1 LD HL,$5B00   ;
*$70A4 LD (HL),A     ;
 $70A5 INC HL        ;
 $70A6 DJNZ $70A4    ;
 $70A8 RET           ;

; Send one byte of pixels to the ZX Printer
;
; Used by the routine at #R$7071.
@label=PrinterSendByte
c$70A9 PUSH BC       ;
 $70AA LD B,$08      ;
*$70AC IN A,($FB)    ;
 $70AE AND $01       ;
 $70B0 JR Z,$70AC    ;
 $70B2 XOR A         ;
 $70B3 RL (HL)       ;
 $70B5 JR NC,$70B9   ;
 $70B7 SET 7,A       ;
*$70B9 OUT ($FB),A   ;
 $70BB DJNZ $70AC    ;
 $70BD POP BC        ;
 $70BE RET           ;

; Highlight the move's from-square and beep
;
; Used by the routines at #R$6323 and #R$6690.
@label=ShowFromSquare
c$70BF LD A,(IX+$01) ;
 $70C2 CALL $70E1    ;
 $70C5 JR $70CD      ;

; Highlight the move's to-square and beep
;
; Used by the routines at #R$6323 and #R$6690.
@label=ShowToSquare
c$70C7 LD A,(IX+$02) ;
 $70CA CALL $70E1    ;
; This entry point is used by the routine at #R$70BF.
*$70CD CALL $6FB0    ;
 $70D0 DEFB $96,$28  ; Inline arguments: duration, pitch
 $70D2 RET           ;

; Put the cursor on the a-file square in front of the side to move's pieces
;
; $60 (a2) for White, $10 (a7) for Black.
@label=CursorToStartRank
c$70D3 LD A,($BD2D)  ;
 $70D6 RRA           ;
 $70D7 LD A,$10      ;
 $70D9 JR NC,$70E1   ;
 $70DB LD A,$60      ;
 $70DD JR $70E1      ;

; Draw the board without the cursor
;
; Used by the routines at #R$60B7, #R$6147, #R$641A, #R$68A0 and #R$6B97.
@label=DrawBoardNoCursor
c$70DF LD A,$FF      ;

; Draw the board with the cursor at A
;
; Used by the routines at #R$677E, #R$70BF, #R$70C7 and #R$70D3.
@label=DrawBoardCursor
c$70E1 LD ($BCCA),A  ;

; Draw the board
;
; Draws each square as a 2x2 block (#R$7200) chosen from the piece's value
; byte, flashing the cursor square, then the rank and file labels.
@label=DrawBoard
c$70E4 EXX                  ;
 $70E5 LD H,$BE             ;
 $70E7 EXX                  ;
 $70E8 LD HL,$BD00          ;
 $70EB LD B,$00             ;
*$70ED LD C,$10             ;
*$70EF LD A,L               ;
 $70F0 AND $11              ;
 $70F2 OR A                 ;
 $70F3 JR Z,$70F7           ;
 $70F5 CP $11               ;
*$70F7 LD A,($BCDA)         ;
 $70FA JR Z,$70FF           ;
 $70FC LD A,($BCD9)         ;
*$70FF SLA A                ;
 $7101 SLA A                ;
 $7103 SLA A                ;
 $7105 LD D,A               ;
 $7106 LD A,($BCD7)         ;
 $7109 ADD A,D              ;
 $710A OR $40               ;
 $710C LD ($BCC4),A         ;
 $710F PUSH HL              ;
 $7110 LD A,($BCC7)         ;
 $7113 OR A                 ;
 $7114 JR Z,$711A           ;
 $7116 LD A,$77             ;
 $7118 SUB L                ;
 $7119 LD L,A               ;
*$711A LD A,($BCCA)         ;
 $711D CP L                 ;
 $711E JR NZ,$7128          ;
 $7120 LD A,($BCC4)         ;
 $7123 OR $80               ;
 $7125 LD ($BCC4),A         ;
*$7128 LD A,(HL)            ;
 $7129 POP HL               ;
 $712A EXX                  ;
 $712B OR A                 ;
 $712C JR NZ,$7137          ;
 $712E CALL $7200           ;
 $7131 DEFB $20,$20,$20,$20 ; Inline: empty square
 $7135 JR $719B             ;
*$7137 LD D,A               ;
 $7138 AND $F8              ;
 $713A INC A                ;
 $713B LD L,A               ;
 $713C BIT 7,L              ;
 $713E JR Z,$714D           ;
 $7140 LD A,($BCC4)         ;
 $7143 AND $F8              ;
 $7145 LD E,A               ;
 $7146 LD A,($BCD8)         ;
 $7149 OR E                 ;
 $714A LD ($BCC4),A         ;
*$714D LD A,D               ;
 $714E AND $7F              ;
 $7150 CP $43               ;
 $7152 JR Z,$7166           ;
 $7154 LD A,$0F             ;
 $7156 AND (HL)             ;
 $7157 JR NZ,$7162          ;
 $7159 CALL $7200           ;
 $715C DEFB $A4,$A5,$A2,$A3 ; Inline: king
 $7160 JR $719B             ;
*$7162 CP $01               ;
 $7164 JR NZ,$716F          ;
*$7166 CALL $7200           ;
 $7169 DEFB $90,$91,$92,$93 ; Inline: pawn
 $716D JR $719B             ;
*$716F CP $05               ;
 $7171 JR NZ,$717C          ;
 $7173 CALL $7200           ;
 $7176 DEFB $9C,$9D,$9E,$9F ; Inline: rook
 $717A JR $719B             ;
*$717C JR C,$7187           ;
 $717E CALL $7200           ;
 $7181 DEFB $A0,$A1,$A2,$A3 ; Inline: queen
 $7185 JR $719B             ;
*$7187 BIT 7,(HL)           ;
 $7189 JR NZ,$7194          ;
 $718B CALL $7200           ;
 $718E DEFB $94,$95,$96,$97 ; Inline: knight
 $7192 JR $719B             ;
*$7194 CALL $7200           ;
 $7197 DEFB $98,$99,$9A,$9B ; Inline: bishop
*$719B EXX                  ; {Next square
 $719C INC C                ;
 $719D INC C                ;
 $719E INC HL               ;
 $719F BIT 3,L              ;
 $71A1 JP Z,$70EF           ;
 $71A4 INC B                ;
 $71A5 INC B                ;
 $71A6 LD DE,$0008          ;
 $71A9 ADD HL,DE            ;
 $71AA BIT 7,L              ;
 $71AC JP Z,$70ED           ;
 $71AF LD A,$01             ;
 $71B1 LD ($BCC5),A         ;
 $71B4 LD A,$0F             ;
 $71B6 LD ($BCC6),A         ;
 $71B9 LD A,$38             ;
 $71BB LD ($BCC4),A         ;
 $71BE LD B,$08             ;
 $71C0 LD C,$00             ;
*$71C2 LD A,($BCC7)         ;
 $71C5 OR A                 ;
 $71C6 LD A,C               ;
 $71C7 JR NZ,$71CC          ;
 $71C9 LD A,$07             ;
 $71CB SUB C                ;
*$71CC ADD A,$31            ;
 $71CE CALL $7226           ;
 $71D1 LD HL,$BCC6          ;
 $71D4 DEC (HL)             ;
 $71D5 LD HL,$BCC5          ;
 $71D8 INC (HL)             ;
 $71D9 INC (HL)             ;
 $71DA INC C                ;
 $71DB DJNZ $71C2           ;
 $71DD LD A,$10             ;
 $71DF LD ($BCC5),A         ;
 $71E2 LD ($BCC6),A         ;
 $71E5 LD B,$08             ;
 $71E7 LD C,$00             ;
*$71E9 LD A,($BCC7)         ;
 $71EC OR A                 ;
 $71ED LD A,C               ;
 $71EE JR Z,$71F3           ;
 $71F0 LD A,$07             ;
 $71F2 SUB C                ;
*$71F3 ADD A,$41            ;
 $71F5 CALL $7226           ;
 $71F8 LD HL,$BCC6          ;
 $71FB INC (HL)             ;
 $71FC INC C                ;
 $71FD DJNZ $71E9           ;
 $71FF RET                  ; }

; Draw a 2x2 character block
;
; Four inline character codes follow the CALL (top-left, top-right,
; bottom-left, bottom-right).
@label=DrawGlyph2x2
c$7200 EXX           ;
 $7201 LD A,B        ;
 $7202 LD ($BCC5),A  ;
 $7205 LD A,C        ;
 $7206 LD ($BCC6),A  ;
 $7209 EXX           ;
 $720A EX (SP),HL    ;
 $720B CALL $7224    ;
 $720E CALL $7224    ;
 $7211 EXX           ;
 $7212 LD A,B        ;
 $7213 INC A         ;
 $7214 LD ($BCC5),A  ;
 $7217 LD A,C        ;
 $7218 LD ($BCC6),A  ;
 $721B EXX           ;
 $721C CALL $7224    ;
 $721F CALL $7224    ;
 $7222 EX (SP),HL    ;
 $7223 RET           ;

; Print the character at HL and advance HL
;
; Used by the routine at #R$7200.
@label=PrintCharHL
