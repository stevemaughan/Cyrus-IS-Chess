 $6CE0 CALL $743B                                                        ;
 $6CE3 LD HL,($C001)                                                     ;
 $6CE6 JP $68B2                                                          ;

; Printer text: Tape loaded
@label=TextTapeLoaded
t$6CE9 DEFM "Tape loade",$E4

; Report a tape error
;
; Used by the routine at #R$6BCF.
@label=TapeError
c$6CF4 CALL $703F         ;
 $6CF7 CALL $73F7         ;
 $6CFA DEFM "*TAPE ERROR" ;
 $6D05 DEFB $AA           ; Last character (bit 7 set)
 $6D06 CALL $73A8         ;
 $6D09 CALL $703F         ;
; This entry point is used by the routine at #R$6BCF.
*$6D0C JP $60B7           ;

; Save via the ROM
;
; Jumps into SA-BYTES ($04C6) with #R$6D25 as the return address.
@label=TapeSave
c$6D0F LD HL,$6D25   ;
 $6D12 PUSH HL       ;
 $6D13 JP $04C6      ;

; Load via the ROM
;
; Jumps into LD-BYTES ($0562) with #R$6D25 as the return address.
@label=TapeLoad
c$6D16 INC D         ;
 $6D17 EX AF,AF'     ;
 $6D18 DEC D         ;
 $6D19 DI            ;
 $6D1A LD A,$0F      ;
 $6D1C OUT ($FE),A   ;
 $6D1E LD HL,$6D25   ;
 $6D21 PUSH HL       ;
 $6D22 JP $0562      ;

; Return from the ROM tape routines
;
; Reached by RET from the ROM save/load routines (address pushed at
; #R$6D0F/#R$6D16). Restores the border, tests BREAK (shows *ABORTED* if
; pressed, returning with carry clear) and clears the ROM's new-key flag.
@label=TapeReturn
c$6D25 LD A,$07        ;
 $6D27 OUT ($FE),A     ;
 $6D29 LD A,$7F        ;
 $6D2B IN A,($FE)      ;
 $6D2D RRA             ;
 $6D2E EI              ;
 $6D2F JR C,$6D4C      ;
 $6D31 CALL $703F      ;
 $6D34 CALL $73F7      ; *ABORTED*
 $6D37 DEFM "*ABORTED" ;
 $6D3F DEFB $AA        ; Last character (bit 7 set)
 $6D40 CALL $73A8      ; {Buzz
 $6D43 CALL $703F      ;
 $6D46 LD HL,$5C3B     ;
 $6D49 RES 5,(HL)      ;
 $6D4B OR A            ;
*$6D4C RET             ; }

; C: change position (set-up mode)
;
; Pieces are entered as set-up codes (slot offset + $83 for White or + $03 for
; Black; bit 0 set marks a set-up code, bit 1 set marks a piece entered by the
; user). Removing or overwriting a real piece marks its piece-list entry
; absent. On exit (E) nothing happens if neither the position nor the side to
; move changed; otherwise #R$6ECC validates and installs the position.
@label=ChangePosition
c$6D4D CALL $7046                                                               ; {Clear the
 $6D50 CALL $703F                                                               ; message
 $6D53 CALL $701D                                                               ; lines;
 $6D56 CALL $70D3                                                               ; cursor to
 $6D59 XOR A                                                                    ; the start
 $6D5A LD ($BD4D),A                                                             ; rank;
                                                                                ; nothing
                                                                                ; changed
                                                                                ; yet ($BD4D
                                                                                ; = 0)}
 $6D5D LD A,($BD2D)                                                             ; {Colour
 $6D60 RRA                                                                      ; for new
 $6D61 LD A,$83                                                                 ; pieces
 $6D63 JR C,$6D67                                                               ; $BCA2: $83
 $6D65 LD A,$03                                                                 ; (WHITE) if
*$6D67 LD ($BCA2),A                                                             ; White is
                                                                                ; to move,
                                                                                ; else $03
                                                                                ; (BLACK)}
; This entry point is used by the routine at #R$6587.
@label=SetupMenu
