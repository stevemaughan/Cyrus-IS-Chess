 $862C LD A,($BEF9)   ;
 $862F CALL $8AD4     ;
 $8632 LD ($BEFA),HL  ;
*$8635 LD ($BEFC),HL  ; }
 $8638 XOR A          ; {E = -E (White's view)
 $8639 SUB E          ;
 $863A LD E,A         ; }
 $863B LD HL,($BD39)  ; {Keep Black's best/second gains on the stack; reset
 $863E PUSH HL        ; $BD39/$BD3A
 $863F LD HL,$0000    ;
 $8642 LD ($BD39),HL  ; }
 $8645 LD HL,($BE0A)  ; {White queen: SEE with value 9
 $8648 LD A,H         ;
 $8649 OR L           ;
