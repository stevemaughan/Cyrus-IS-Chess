@start
@org
; Program entry and title
;
; Entered by JP $6000 from the CLoad48 loader. Disables NEW (RAMTOP/P-RAMT set
; to $1111), saves IY and the CHARS system variable, clears the screen and
; beeps. If a key is held down at this point the copyright message is shown
; (with beeps) until a key is pressed again; otherwise the program falls
; straight through to the cold start at #R$605B.
@label=Start
c$6000 LD HL,$1111                               ; {Set RAMTOP and P-RAMT to
 $6003 LD ($5CB2),HL                             ; $1111 (makes BASIC NEW
 $6006 LD ($5CB4),HL                             ; unusable)}
 $6009 DI                                        ; Interrupts stay disabled
                                                 ; except while waiting for a
                                                 ; key (#R$675A)
 $600A LD ($BCC8),IY                             ; Save IY for ROM calls
                                                 ; (restored in #R$675A)
 $600E LD HL,($5C36)                             ; {Save CHARS; #R$7226 uses
 $6011 LD ($BCD5),HL                             ; this copy for the font}
 $6014 CALL $7004                                ; Clear the screen
 $6017 CALL $6FDD                                ; Print position (18,0)
 $601A DEFB $12,$00                              ; Inline arguments: row,
                                                 ; column
 $601C CALL $6FEF                                ; Clear the command area
 $601F CALL $6FB0                                ; Beep
 $6022 DEFB $50,$0C                              ; Inline arguments: duration,
                                                 ; pitch
 $6024 LD ($5C36),HL                             ; Corrupt CHARS (HL=$BCD2 left
                                                 ; over from the beep routine);
                                                 ; the program's own text
                                                 ; output uses the copy at
                                                 ; $BCD5
 $6027 CALL $6734                                ; {No key pressed: go to the
 $602A JR Z,$605B                                ; cold start}
@label=TitleLoop
*$602C CALL $7415                                ; Print the copyright message
                                                 ; at (0,0)
 $602F DEFB $00,$00                              ; Inline arguments: row,
                                                 ; column
 $6031 DEFM $7F," 1982 Intelligent Software Ltd" ;
 $6050 DEFB $AE                                  ; Last character (bit 7 set)
 $6051 CALL $6FB0                                ; Beep
 $6054 DEFB $FF,$10                              ; Inline arguments: duration,
                                                 ; pitch
 $6056 CALL $6734                                ; {Loop until a key is pressed
 $6059 JR Z,$602C                                ; }

; Cold start: default options
;
; Sets the default options (Level 2, sound on, listing off, normal orientation,
; default colours) and starts a new game.
@label=ColdStart
c$605B LD A,$01      ; {Level index $BCCD = 1 (Level 2) and search level $BCBD
 $605D LD ($BCBD),A  ; = 1; listing flag $BCD4 = 1 (listing OFF)
 $6060 LD ($BCCD),A  ;
 $6063 LD ($BCD4),A  ; }
 $6066 XOR A         ; {Orientation normal, next-best off, start move number 0
 $6067 LD ($BCC7),A  ; (forces a cleared record below), print-record off,
 $606A LD ($BCDD),A  ; replay off, sound on
 $606D LD ($C006),A  ;
 $6070 LD ($BCDB),A  ;
 $6073 LD ($BCC3),A  ;
 $6076 LD ($BCD3),A  ; }
 $6079 CALL $6BBA    ; Default colour scheme
 $607C CALL $709C    ; Clear the printer buffer

; New game
;
; Entered after G and Y (#R$6985). If the last game did not start from the
; standard position its record is discarded ($C058=$FF); otherwise the record
; is kept so that F (take-forward) can replay it. Cyrus plays Black.
@label=NewGameConfirmed
c$607F LD A,($C006)  ; {$C006 = start move number: 1 means the game started
 $6082 DEC A         ; from the standard initial position
 $6083 JR Z,$608A    ; }
 $6085 LD A,$FF      ; {Not a standard game: empty the game record
 $6087 LD ($C058),A  ; }
*$608A LD A,$01      ; {$BCC2 = 1: HUMAN v CYRUS
 $608C LD ($BCC2),A  ; }
; This entry point is used by the routine at #R$641A.
@label=NewGameNoConfirm
*$608F LD HL,$0000   ; {No replay target
 $6092 LD ($C003),HL ; }
 $6095 CALL $7004    ; {Clear the screen and beep
 $6098 CALL $6FB0    ; }
 $609B DEFB $32,$10  ; Inline arguments: duration, pitch
 $609D LD A,($BCD4)  ; {Listing on: print a rule on the ZX Printer
 $60A0 OR A          ;
 $60A1 CALL Z,$7065  ; }
; This entry point is used by the routine at #R$68A0.
@label=NewGameBoard
*$60A4 CALL $6505    ; Set up the initial position (#R$6505)
; Common entry for a new game, a take-back replay (#R$68B2) and the exit from
; set-up mode (#R$6ECC).
@label=GameStartCommon
*$60A7 LD HL,$0000   ; {Game record ply count $C001 = 0
 $60AA LD ($C001),HL ; }
 $60AD XOR A         ; {Promotion counter $C047 = 0; opening book enabled
 $60AE LD ($C047),A  ; ($BCDF = 0)
 $60B1 LD ($BCDF),A  ; }
 $60B4 CALL $701D    ; Clear the move display lines

; Main loop
;
; One iteration per ply. Handles automatic replay (R), the replay-to-target
; used by take-back/forward/next-best, the draw tests, the status display, and
; then hands control to the computer (#R$6147) or the human (#R$61C8).
; .
; Note that the draw tests are skipped while a replay target is set ($C003
; non-zero).
@label=MainLoop
c$60B7 LD SP,$BDF4   ; Reset the stack (discards the undo information pushed by
                     ; game moves)
 $60BA LD A,($BCC3)  ; {Replay mode (R key) off: skip
 $60BD OR A          ;
 $60BE JR Z,$60E3    ; }
 $60C0 LD BC,$C058   ; {Next record byte; $FF = end of record: stop replaying
 $60C3 LD HL,($C001) ;
 $60C6 ADD HL,BC     ;
 $60C7 LD A,(HL)     ;
 $60C8 INC A         ;
 $60C9 JP Z,$671F    ; }
 $60CC CALL $70DF    ; Redraw the board
 $60CF LD HL,$C000   ; {Pause about 2.5 s between replayed moves, polling the
*$60D2 CALL $6734    ; keyboard; a key stops the replay. No pause while
 $60D5 JP NZ,$671F   ; printing the record ($BCDB)
 $60D8 LD A,($BCDB)  ;
 $60DB OR A          ;
 $60DC JR NZ,$60E3   ;
 $60DE DEC HL        ;
 $60DF LD A,L        ;
 $60E0 OR H          ;
 $60E1 JR NZ,$60D2   ; }
@label=MainLoopReplayCheck
*$60E3 LD HL,($C003) ; {Replay target set ($C003): replay one more ply
 $60E6 LD A,L        ; (#R$6690)
 $60E7 OR H          ;
 $60E8 JP NZ,$6690   ; }
 $60EB LD A,R        ; {Stir the random accumulator $BCCE with R
 $60ED LD B,A        ;
 $60EE RRA           ;
 $60EF RRA           ;
 $60F0 ADD A,B       ;
 $60F1 LD HL,$BCCE   ;
 $60F4 ADD A,(HL)    ;
 $60F5 LD (HL),A     ; }
 $60F6 LD A,($BD5E)  ; {Repetition counter $BD5E = 6: draw by repetition
 $60F9 CP $06        ;
 $60FB JP Z,$6448    ; }
 $60FE LD A,($BD0A)  ; {50-move counter $BD0A >= 100 plies: draw
 $6101 CP $64        ;
 $6103 JP NC,$6448   ; }
 $6106 XOR A         ; {Game not over
 $6107 LD ($BCBF),A  ; }
 $610A CALL $7046    ; {Clear the message lines and show the level, players,
 $610D CALL $703F    ; listing and sound status
 $6110 CALL $704D    ;
 $6113 CALL $737C    ;
 $6116 CALL $756E    ;
 $6119 CALL $759A    ;
 $611C CALL $75B4    ; }
 $611F LD A,($BCDD)  ; {Next-best in progress ($BCDD): Cyrus plays the side to
 $6122 OR A          ; move ($BCBE = side to move XOR 1) and moves now
 $6123 JR Z,$6134    ;
 $6125 LD A,($BD2D)  ;
 $6128 AND $01       ;
 $612A XOR $01       ;
 $612C LD ($BCBE),A  ;
 $612F CALL $7562    ;
 $6132 JR $6147      ; }
*$6134 LD A,($BD2D)  ; {White to move: Cyrus moves if $BCBE = 0, otherwise the
 $6137 RRA           ; human moves
 $6138 LD A,($BCBE)  ;
 $613B JR NC,$6143   ;
 $613D OR A          ;
 $613E JR Z,$6147    ;
 $6140 JP $61C8      ; }
*$6143 OR A          ; {Black to move: the human moves if $BCBE = 0, otherwise
 $6144 JP Z,$61C8    ; Cyrus moves}

; Computer move
;
; Generates and scores the legal moves (to detect mate/stalemate), runs the
; search (#R$7BE1) and plays the move it leaves at ($BD29).
; .
; In problem mode (level index $BCCD >= 8) the move is only played if the
; search found a mate ($BCA0 >= $FE); otherwise NO MATE FOUND is shown and
; set-up mode is entered.
@label=ComputerMove
c$6147 LD A,($BCC2)          ; {HUMAN v HUMAN ($BCC2 = 0): just swap sides
 $614A OR A                  ;
 $614B JP Z,$696A            ; }
 $614E LD A,$40              ; {$BD4C = $40: bit 6 = computer's move
 $6150 LD ($BD4C),A          ; (promotions are to a queen without asking); bit
                             ; 7 (abort) clear}
 $6153 LD IX,$BD58           ; {Generate the root moves (IX=$BD58 = last game
 $6157 CALL $78CE            ; move) and score each one with
 $615A CALL $7B96            ; make/evaluate/unmake (#R$7B96)}
 $615D LD A,($BD19)          ; {Best score 0: no legal move - checkmate or
 $6160 OR A                  ; stalemate
 $6161 JP Z,$641A            ; }
 $6164 XOR A                 ; {Print-record mode off
 $6165 LD ($BCDB),A          ; }
 $6168 LD A,($BCDD)          ; {Unless a next-best search is in progress, clear
 $616B OR A                  ; the root exclusion list at $BF00
 $616C CALL Z,$6FAA          ; }
 $616F CALL $70DF            ; Redraw the board without the cursor
 $6172 CALL $6FB0            ; Beep
 $6175 DEFB $14,$10          ; Inline arguments: duration, pitch
 $6177 CALL $73AE            ; Show "-Hit any key to restore control-" in the
                             ; command area
 $617A CALL $73F7            ; Show LET ME THINK...
 $617D DEFM "LET ME THINK.." ;
 $618B DEFB $AE              ; Last character (bit 7 set)
 $618C CALL $7BE1            ; Search (#R$7BE1); the chosen move is left at
                             ; ($BD29)
 $618F CALL $6FB0            ; Beep
 $6192 DEFB $14,$20          ; Inline arguments: duration, pitch
 $6194 XOR A                 ; {Next-best request completed
 $6195 LD ($BCDD),A          ; }
 $6198 LD A,($BCCD)          ; {Problem levels P1-P3 (level index >= 8): play
 $619B CP $08                ; the move only if a mate was found ($BCA0 >= $FE)
 $619D JR C,$61C1            ;
 $619F LD A,($BCA0)          ;
 $61A2 CP $FE                ;
 $61A4 JR NC,$61C1           ; }
 $61A6 CALL $703F            ; {NO MATE FOUND: buzz and go to set-up mode
 $61A9 CALL $73F7            ; }
 $61AC DEFM "*NO MATE FOUND" ;
 $61BA DEFB $AA              ; Last character (bit 7 set)
 $61BB CALL $73A8            ; {Buzz, then enter set-up mode
 $61BE JP $6D4D              ; }
@label=ComputerMovePlay
*$61C1 LD IX,($BD29)         ; {IX = the move chosen by the search; play it
 $61C5 JP $6323              ; }

; Human move
;
; Generates and scores the legal moves (so that illegal moves have score 0),
; shows the command list and reads the user's from- and to-squares with the
; cursor. The move is accepted only if it is in the generated list with a
; non-zero score.
@label=HumanMove
c$61C8 XOR A                                                                    ; {$BD4C =
 $61C9 LD ($BD4C),A                                                             ; 0: human's
                                                                                ; move}
 $61CC LD IX,$BD58                                                              ; {Generate
 $61D0 CALL $78CE                                                               ; and score
 $61D3 CALL $7B96                                                               ; the root
                                                                                ; moves}
 $61D6 LD A,($BD19)                                                             ; {No legal
 $61D9 OR A                                                                     ; move:
 $61DA JP Z,$641A                                                               ; checkmate
                                                                                ; or
                                                                                ; stalemate}
 $61DD XOR A                                                                    ; {Print-record
 $61DE LD ($BCDB),A                                                             ; mode off}
 $61E1 LD A,($BCC2)                                                             ; {CYRUS v
 $61E4 CP $03                                                                   ; CYRUS:
 $61E6 JP Z,$696A                                                               ; just swap
                                                                                ; sides so
                                                                                ; that Cyrus
                                                                                ; plays this
                                                                                ; side too}
 $61E9 OR A                                                                     ; {Not HUMAN
 $61EA JR Z,$61EF                                                               ; v HUMAN:
 $61EC CALL $7562                                                               ; refresh
                                                                                ; $BCC2 and
                                                                                ; the
                                                                                ; players
                                                                                ; display
                                                                                ; from $BCBE
                                                                                ; }
*$61EF CALL $70D3                                                               ; Put the
                                                                                ; cursor on
                                                                                ; the a-file
                                                                                ; of the
                                                                                ; side to
                                                                                ; move's
                                                                                ; back
                                                                                ; rank+1
                                                                                ; (#R$70D3)
 $61F2 CALL $7405                                                               ; Command
                                                                                ; list
 $61F5 DEFM "Alter     take-Back Change-pos'nDemo      Enter     take-Forwardn" ;
 $6236 DEFM "ew-Game  Level     Move        Next-best Orient'n  Printer     Re" ;
 $6277 DEFM "play    Sound     Tape        5-left 6-down 7-up 8-right <cr"      ;
 $62B3 DEFB $BE                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $62B4 CALL $6FEF                                                               ; Clear the
                                                                                ; rest of
                                                                                ; the
                                                                                ; command
                                                                                ; area
@label=HumanMoveInput
*$62B7 CALL $740E                                                               ; YOUR MOVE?
 $62BA DEFM "YOUR MOVE?   "                                                     ;
 $62C7 DEFB $A0                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $62C8 LD A,$FF                                                                 ; {No
 $62CA LD ($BCCB),A                                                             ; from-square
                                                                                ; chosen yet
                                                                                ; }
*$62CD CALL $6800                                                               ; {Read keys
 $62D0 CP $0D                                                                   ; (commands
 $62D2 JR NZ,$62CD                                                              ; are
                                                                                ; handled
                                                                                ; inside
                                                                                ; #R$6800)
                                                                                ; until
                                                                                ; ENTER}
 $62D4 CALL $6FB0                                                               ; Beep
 $62D7 DEFB $32,$20                                                             ; Inline
                                                                                ; arguments:
                                                                                ; duration,
                                                                                ; pitch
 $62D9 CALL $703F                                                               ; {Clear
 $62DC LD A,$38                                                                 ; message
 $62DE LD ($BCC4),A                                                             ; line 12}
 $62E1 LD A,($BCCB)                                                             ; {First
 $62E4 INC A                                                                    ; ENTER: the
 $62E5 LD A,($BCCA)                                                             ; cursor
 $62E8 JR NZ,$62F7                                                              ; square
 $62EA LD ($BCCB),A                                                             ; becomes
 $62ED CALL $6FDD                                                               ; the
                                                                                ; from-square;
                                                                                ; print it
                                                                                ; at (10,10)
                                                                                ; }
 $62F0 DEFB $0A,$0A                                                             ; Inline
                                                                                ; arguments:
                                                                                ; row,
                                                                                ; column
 $62F2 CALL $74F7                                                               ; {Print the
 $62F5 JR $62CD                                                                 ; square and
                                                                                ; read the
                                                                                ; to-square}
*$62F7 LD ($BCCC),A                                                             ; {Second
 $62FA CALL $6FDD                                                               ; ENTER: the
                                                                                ; cursor
                                                                                ; square is
                                                                                ; the
                                                                                ; to-square;
                                                                                ; print it
                                                                                ; at (10,12)
                                                                                ; }
 $62FD DEFB $0A,$0C                                                             ; Inline
                                                                                ; arguments:
                                                                                ; row,
                                                                                ; column
 $62FF CALL $74F7                                                               ;
 $6302 LD A,($BCCB)                                                             ; {Look for
 $6305 EX AF,AF'                                                                ; the move
 $6306 LD A,($BCCC)                                                             ; (from, to)
 $6309 LD HL,$B401                                                              ; in the
 $630C LD B,(HL)                                                                ; root list:
 $630D INC L                                                                    ; B = number
 $630E CALL $7BCD                                                               ; of moves
                                                                                ; (byte 1 of
                                                                                ; the list
                                                                                ; header at
                                                                                ; $B400)}
 $6311 JR C,$6318                                                               ; {Not
 $6313 DEC L                                                                    ; found, or
 $6314 XOR A                                                                    ; found with
 $6315 OR (HL)                                                                  ; score 0
 $6316 JR NZ,$631D                                                              ; (illegal):
                                                                                ; ILLEGAL
                                                                                ; and start
                                                                                ; again}
*$6318 CALL $739E                                                               ; {ILLEGAL
 $631B JR $62B7                                                                 ; }
*$631D CALL $6FAA                                                               ; {Start a
 $6320 PUSH HL                                                                  ; new root
 $6321 POP IX                                                                   ; exclusion
                                                                                ; list; IX =
                                                                                ; the move}

; Play a game move
;
; Plays the move at IX for whichever side is to move: makes it on the board,
; handles promotion, re-evaluates (which sets the check flag, bit 7 of IX+3),
; displays and prints it, appends it to the game record, updates the 50-move
; and repetition counters, changes the side to move, and appends it to the root
; exclusion list.
;
; IX Move (score, from, to, flags)
@label=PlayMove
c$6323 CALL $70BF     ; Highlight the from-square and beep
 $6326 CALL $810F     ; Make the move (#R$810F). It leaves its undo information
                      ; on the stack; the top entry, popped as AF, has A = the
                      ; moving piece's old value/flags byte and F = a move-type
                      ; code: S set = not a capture, P/V set = promotion, C set
                      ; = en passant
 $6329 XOR A          ; {No promotion piece to display yet
 $632A LD ($BCDE),A   ; }
 $632D POP AF         ; {Promotion (P/V set): choose the piece (#R$63B1)
 $632E PUSH AF        ;
 $632F CALL PE,$63B1  ; }
 $6332 RES 7,(IX+$03) ; {Clear the check flag, then re-evaluate (#R$8400),
 $6336 CALL $8400     ; which sets it again if the move gives check}
 $6339 CALL $746E     ; {Show the move in the message area and highlight the
 $633C CALL $70C7     ; to-square}
 $633F LD A,($BCD4)   ; {Listing on ($BCD4 = 0): print the move on the ZX
 $6342 OR A           ; Printer
 $6343 CALL Z,$7452   ; }
 $6346 PUSH IX        ; {E = index of the move in the root list (0 = first move
 $6348 POP HL         ; at $B404)
 $6349 LD BC,$B400    ;
 $634C XOR A          ;
 $634D LD E,A         ;
 $634E SBC HL,BC      ;
 $6350 LD BC,$0004    ;
*$6353 INC E          ;
 $6354 SBC HL,BC      ;
 $6356 JR NZ,$6353    ;
 $6358 DEC E          ; }
 $6359 LD HL,($C001)  ; {Append (check flag | index) to the game record at
 $635C INC HL         ; $C058 and terminate it with $FF; $C001 = ply count
 $635D LD ($C001),HL  ;
 $6360 LD A,(IX+$03)  ;
 $6363 AND $80        ;
 $6365 OR E           ;
 $6366 LD BC,$C057    ;
 $6369 ADD HL,BC      ;
 $636A LD (HL),A      ;
 $636B INC HL         ;
 $636C LD (HL),$FF    ; }
; This entry point is used by the routine at #R$6690.
@label=AfterGameMove
*$636E LD HL,$BD0A    ; {50-move counter: count this ply, and reset it to 0
 $6371 INC (HL)       ; after a capture (S clear) or a pawn move (old value 1)
 $6372 POP AF         ;
 $6373 PUSH AF        ;
 $6374 JP P,$637C     ;
 $6377 AND $0F        ;
 $6379 DEC A          ;
 $637A JR NZ,$6380    ;
*$637C XOR A          ;
 $637D LD ($BD0A),A   ; }
*$6380 CALL $6560     ; Update the repetition detector (#R$6560)
 $6383 LD A,($BD2D)   ; {Change the side to move; increment the move number
 $6386 XOR $01        ; $BD49 when it is White's turn again
 $6388 LD ($BD2D),A   ;
 $638B RRA            ;
 $638C JR NC,$6392    ;
 $638E LD HL,$BD49    ;
 $6391 INC (HL)       ; }
*$6392 LD A,($BCDD)   ; {Unless next-best is in progress, append (from, to) to
 $6395 OR A           ; the root exclusion list at $BF00
 $6396 JR NZ,$63AE    ;
 $6398 LD HL,$BF00    ;
*$639B LD A,(HL)      ;
 $639C INC A          ;
 $639D JR Z,$63A2     ;
 $639F INC HL         ;
 $63A0 JR $639B       ;
*$63A2 LD A,(IX+$01)  ;
 $63A5 LD (HL),A      ;
 $63A6 INC HL         ;
 $63A7 LD A,(IX+$02)  ;
 $63AA LD (HL),A      ;
 $63AB INC HL         ;
 $63AC LD (HL),$FF    ; }
*$63AE JP $60B7       ; Next ply

; Choose the promotion piece
;
; Called after a pawn has been promoted by #R$810F (which makes it a queen,
; value byte $19). For the computer's move ($BD4C bit 6 set) the queen is kept
; without asking. Otherwise the user is asked PROMOTE TO? and R, N or B
; under-promote by overwriting the piece's value byte (+1) with 5, 3 or $83;
; any other key keeps the queen. The chosen value (9 for a queen) is appended
; to the promotion list at $C048 (count in $C047) so that replays can repeat
; it, and stored in $BCDE for the move display.
;
; IX Promotion move
@label=ChoosePromotion
c$63B1 LD A,($BD4C)                        ; {Computer's move: queen
 $63B4 BIT 6,A                             ;
 $63B6 JR NZ,$63FE                         ;
 $63B8 CALL $73F7                          ; }
 $63BB DEFM "PROMOTE TO"                   ;
 $63C5 DEFB $BF                            ; Last character (bit 7 set)
 $63C6 CALL $7405                          ; Piece choices
 $63C9 DEFM "kNight  Bishop  Rook    Quee" ;
 $63E5 DEFB $EE                            ; Last character (bit 7 set)
 $63E6 CALL $6FEF                          ; {Wait for a key
 $63E9 CALL $675A                          ; }
 $63EC LD B,$05                            ; {R = rook (5), N = knight (3), B =
 $63EE CP $52                              ; bishop ($83); anything else =
 $63F0 JR Z,$6402                          ; queen (9)
 $63F2 LD B,$03                            ;
 $63F4 CP $4E                              ;
 $63F6 JR Z,$6402                          ;
 $63F8 LD B,$83                            ;
 $63FA CP $42                              ;
 $63FC JR Z,$6402                          ;
*$63FE LD B,$09                            ;
 $6400 JR $640D                            ; }
*$6402 LD L,(IX+$02)                       ; {Overwrite the promoted piece's
 $6405 LD H,$BD                            ; value byte: piece list entry of
 $6407 LD L,(HL)                           ; the piece now on the to-square,
 $6408 RES 2,L                             ; offset +1
 $640A INC L                               ;
 $640B INC H                               ;
 $640C LD (HL),B                           ; }
@label=RecordPromotion
*$640D LD HL,$C047                         ; {Append the piece value to the
 $6410 INC (HL)                            ; promotion list ($C047 = count,
 $6411 LD A,(HL)                           ; entries from $C048). Only 16
 $6412 ADD A,L                             ; entries fit before the game record
 $6413 LD L,A                              ; at $C058
 $6414 LD (HL),B                           ;
 $6415 LD A,B                              ;
 $6416 LD ($BCDE),A                        ;
 $6419 RET                                 ; }

; Game over
;
; No legal moves: CHECKMATE if the last move gave check (bit 7 of $BD5B), else
; STALEMATE. Entry #R$6448 is the draw (repetition or 50 moves). The result is
; printed if listing is on; afterwards only the reduced command set is
; available ($BCBF = 1). In demonstration mode a new game starts after about 20
; s unless a key is pressed.
@label=GameOverNoMoves
c$641A LD A,($BD5B)                                                             ; {Last move
 $641D RLA                                                                      ; gave
 $641E JR C,$6434                                                               ; check?}
 $6420 CALL $73FE                                                               ; STALEMATE
 $6423 DEFM "STALEMAT"                                                          ;
 $642B DEFB $C5                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $642C LD HL,$6423                                                              ; {Print it
 $642F CALL $742C                                                               ; if listing
 $6432 JR $6456                                                                 ; is on}
*$6434 CALL $73FE                                                               ; CHECKMATE
 $6437 DEFM "CHECKMAT"                                                          ;
 $643F DEFB $C5                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $6440 LD HL,$6437                                                              ;
 $6443 CALL $742C                                                               ;
 $6446 JR $6456                                                                 ;
; This entry point is used by the routine at #R$60B7.
@label=GameOverDraw
*$6448 CALL $73FE                                                               ; DRAWN
 $644B DEFM "DRAW"                                                              ;
 $644F DEFB $CE                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $6450 LD HL,$644B                                                              ;
 $6453 CALL $742C                                                               ;
@label=GameOverCommon
*$6456 LD A,$01                                                                 ; {Game
 $6458 LD ($BCBF),A                                                             ; over: D, E
 $645B XOR A                                                                    ; and M are
 $645C LD ($BCDB),A                                                             ; no longer
                                                                                ; accepted
                                                                                ; (#R$6800)}
 $645F CALL $703F                                                               ; {Clear the
 $6462 CALL $704D                                                               ; message
 $6465 CALL $70DF                                                               ; lines and
 $6468 CALL $6FB0                                                               ; redraw the
                                                                                ; board;
                                                                                ; beep}
 $646B DEFB $C8,$18                                                             ; Inline
                                                                                ; arguments:
                                                                                ; duration,
                                                                                ; pitch
 $646D LD A,($BCC2)                                                             ; {CYRUS v
 $6470 CP $03                                                                   ; CYRUS:
 $6472 JR NZ,$648B                                                              ; wait about
 $6474 LD B,$09                                                                 ; 20 s (9 x
 $6476 LD HL,$0000                                                              ; 65536
*$6479 CALL $6734                                                               ; keyboard
 $647C JR NZ,$6488                                                              ; polls); no
 $647E DEC HL                                                                   ; key: next
 $647F LD A,L                                                                   ; demonstration
 $6480 OR H                                                                     ; game
 $6481 JR NZ,$6479                                                              ;
 $6483 DJNZ $6479                                                               ;
 $6485 JP $608F                                                                 ; }
*$6488 CALL $7562                                                               ; Key
                                                                                ; pressed:
                                                                                ; hand
                                                                                ; control
                                                                                ; back to
                                                                                ; the human
@label=GameOverMenu
*$648B CALL $7405                                                               ; Reduced
                                                                                ; command
                                                                                ; list
 $648E DEFM "Alter     take-Back Change-pos'nnew-Game  Level     Next-best   O" ;
 $64CF DEFM "rient'n  Printer   Replay      Sound     Tap"                      ;
 $64FB DEFB $E5                                                                 ; Last
                                                                                ; character
                                                                                ; (bit 7
                                                                                ; set)
 $64FC CALL $6FEF                                                               ; {Read and
 $64FF CALL $6800                                                               ; execute
 $6502 JP $648B                                                                 ; commands
                                                                                ; until one
                                                                                ; of them
                                                                                ; leaves via
                                                                                ; the main
                                                                                ; loop}

; Set up the standard initial position
;
; Clears $BD00-$BEFF (board, its off-board variables and both piece lists - the
; return address is held in DE because the stack lives in this area), writes
; set-up codes for the initial position and assigns them to piece-list slots
; via #R$65E5, exactly as if the position had been entered in set-up mode with
; untouched (castling-capable) kings and rooks. Also sets White to move, move
; number 1, ply 1, start move number $C006 = 1 and the first ply's move-list
; pointer.
@label=InitBoard
c$6505 POP DE        ; {Clear 512 bytes below $BF00
 $6506 XOR A         ;
 $6507 LD B,A        ;
 $6508 LD HL,$BF00   ;
*$650B DEC HL        ;
 $650C LD (HL),A     ;
 $650D DEC HL        ;
 $650E LD (HL),A     ;
 $650F DJNZ $650B    ;
 $6511 PUSH DE       ; }
 $6512 LD C,A        ; {Rank 8: black pieces (set-up codes from #R$6558 with
 $6513 CALL $6547    ; colour 0)}
 $6516 LD DE,$BE00   ; {Rank 7: black pawns ($41); the zeroed piece list serves
 $6519 LD C,$41      ; as an 8-byte zero source
 $651B CALL $654A    ; }
 $651E LD L,$60      ; {Rank 2: white pawns ($C1)
 $6520 LD C,$C1      ;
 $6522 CALL $654A    ; }
 $6525 LD C,$81      ; {Rank 1: white pieces (codes from #R$6558 | $80)
 $6527 CALL $6547    ; }
 $652A LD A,$01      ; {Cyrus plays Black ($BCBE = 1); White to move ($BD2D =
 $652C LD ($BCBE),A  ; 1); move number 1; search ply 1; standard start ($C006 =
 $652F LD ($BD2D),A  ; 1)
 $6532 LD ($BD49),A  ;
 $6535 LD ($BCA9),A  ;
 $6538 LD ($C006),A  ; }
 $653B LD HL,$B400   ; {First ply's move list starts at $B400
 $653E LD ($BCAB),HL ; }
 $6541 CALL $659C    ; {Mark all piece-list entries absent, then assign the
 $6544 JP $65E5      ; pieces to slots}

; Write a back rank
;
; Writes the eight back-rank set-up codes from #R$6558 OR'ed with C.
@label=InitBackRank
c$6547 LD DE,$6558   ;

; Write a rank of set-up codes
;
; Writes eight bytes from (DE) OR'ed with C to the board at HL, then moves HL
; to the start of the next row.
@label=InitRank
c$654A LD B,$08      ;
*$654C LD A,(DE)     ;
 $654D OR C          ;
 $654E LD (HL),A     ;
 $654F INC L         ;
 $6550 INC DE        ;
 $6551 DJNZ $654C    ;
 $6553 LD A,$08      ;
 $6555 ADD A,L       ;
 $6556 LD L,A        ;
 $6557 RET           ;

; Initial back-rank set-up codes
;
; a-h: R N B Q K B N R as set-up codes (slot offset | 1). Bit 1 is clear, so
; the kings and rooks are not marked as moved when they are assigned slots.
@label=BackRankCodes
b$6558 DEFB $11,$31,$21,$09,$01,$21,$31,$11

; Update the repetition detector
;
; Called for every game move. If the move just played (from B, to C) is the
; exact reverse of the move played two plies earlier, the counter $BD5E is
; incremented, otherwise it is reset to 0. Six consecutive reversals (e.g. Nf3
; Nf6 Ng1 Ng8 Nf3 Nf6 Ng1 Ng8) give $BD5E = 6, which the main loop scores as a
; draw. $BD59-$BD5B = (from, to, flags) of the last move and $BD5C-$BD5D =
; (from, to) of the move before; the root search also reads them (#R$7D04).
;
; IX Move just played
@label=TrackRepetition
c$6560 LD HL,($BD5C) ; {Compare the move two plies back (stored as from, to)
 $6563 LD B,(IX+$01) ; with (to, from) of this move
 $6566 LD C,(IX+$02) ;
 $6569 XOR A         ;
 $656A SBC HL,BC     ; }
 $656C LD HL,$BD5E   ; {Reversal: count it; otherwise reset the counter
 $656F JR NZ,$6574   ;
 $6571 INC (HL)      ;
 $6572 JR $6575      ;
*$6574 LD (HL),A     ; }
*$6575 LD HL,($BD59) ; {Shift the last move into $BD5C-$BD5D, store this move's
 $6578 LD ($BD5C),HL ; from, to and flags at $BD59-$BD5B
 $657B LD A,B        ;
 $657C LD ($BD59),A  ;
 $657F LD H,(IX+$03) ;
 $6582 LD L,C        ;
 $6583 LD ($BD5A),HL ;
 $6586 RET           ; }

; Reject a set-up position
;
; Entry #R$6587 discards one return address first. Shows ILLEGAL and returns to
; the set-up menu.
@label=SetupIllegalPop
c$6587 POP HL        ;
; This entry point is used by the routine at #R$6D4D.
@label=SetupIllegal
*$6588 CALL $739E    ;
 $658B JP $6D6A      ;

; Clear the board
;
; Empties all 64 squares, then falls into #R$659C.
@label=ClearBoard
c$658E XOR A         ;
 $658F LD HL,$BD00   ;
*$6592 LD (HL),A     ;
*$6593 INC L         ;
 $6594 BIT 3,L       ;
 $6596 JR Z,$6592    ;
 $6598 BIT 7,L       ;
 $659A JR Z,$6593    ;

; Mark all piece-list entries absent
;
; Sets bit 7 of the square byte of all 32 piece-list entries. Value bytes and
; the other bytes are left as they are.
@label=MarkAllAbsent
c$659C XOR A         ;
 $659D LD HL,$BE00   ;
*$65A0 SET 7,(HL)    ;
 $65A2 ADD A,$08     ;
 $65A4 LD L,A        ;
 $65A5 JR NC,$65A0   ;
 $65A7 RET           ;

; Turn promoted pieces back into set-up codes
;
; For each occupied pawn slot from HL (stepping 8 until bit 6 of L clears)
; whose value is not 1 (a promoted piece), frees the slot and replaces the
; piece on the board by the set-up code for its type (from the value byte via
; #R$6F2E), with bit 1 set ("entered"), so that it is reassigned a slot by
; #R$65E5.
@label=LiftPromotedPieces
c$65A8 LD D,(HL)     ;
 $65A9 BIT 7,D       ;
 $65AB JR NZ,$65D1   ;
 $65AD INC L         ;
 $65AE LD B,(HL)     ;
 $65AF DEC L         ;
 $65B0 LD A,B        ;
 $65B1 AND $0F       ;
 $65B3 DEC A         ;
 $65B4 JR Z,$65D1    ;
 $65B6 SET 7,(HL)    ;
 $65B8 LD A,L        ;
 $65B9 AND $80       ;
 $65BB OR $03        ;
 $65BD LD E,A        ;
 $65BE LD A,B        ;
 $65BF AND $8F       ;
 $65C1 PUSH HL       ;
 $65C2 LD HL,$6F2E   ;
 $65C5 CALL $6F23    ;
 $65C8 INC HL        ;
 $65C9 INC HL        ;
 $65CA LD A,(HL)     ;
 $65CB OR E          ;
 $65CC LD H,$BD      ;
 $65CE LD L,D        ;
 $65CF LD (HL),A     ;
 $65D0 POP HL        ;
*$65D1 LD A,L        ;
 $65D2 ADD A,$08     ;
 $65D4 LD L,A        ;
 $65D5 BIT 6,A       ;
 $65D7 JR NZ,$65A8   ;
 $65D9 RET           ;

; Assign set-up pieces to piece-list slots (set-up exit)
;
; First lifts promoted pieces out of the pawn slots of both sides (#R$65A8).
; Then (entry #R$65E5) scans the board file by file (a-file first; within a
; file from row 0 = rank 8 down to rank 1) and gives each square holding a
; set-up code (bit 0 set) a slot via #R$6610. Finally both kings must exist;
; the king records' bits 6-7 get the king's distance from the edge (#R$8203).
; .
; Pieces left untouched in set-up mode keep their slots and flags. Because move
; generation walks the piece lists in slot order, the slot assignment order is
; significant.
@label=AssignSetupPieces
c$65DA LD HL,$BE40   ;
 $65DD CALL $65A8    ;
 $65E0 LD L,$C0      ;
 $65E2 CALL $65A8    ;
; This entry point is used by the routine at #R$6505.
@label=AssignScan
*$65E5 LD DE,$BD00   ; {Scan rows (E += $10) then files
 $65E8 LD H,$BE      ;
*$65EA LD A,(DE)     ;
 $65EB BIT 0,A       ;
 $65ED CALL NZ,$6610 ;
 $65F0 LD A,$10      ;
 $65F2 ADD A,E       ;
 $65F3 LD E,A        ;
 $65F4 JP P,$65EA    ;
 $65F7 RES 7,E       ;
 $65F9 INC E         ;
 $65FA BIT 3,A       ;
 $65FC JR Z,$65EA    ; }
 $65FE LD L,$00      ; {Black king: set its edge-distance bits; then both kings
 $6600 CALL $660A    ; must be present
 $6603 LD L,$80      ;
 $6605 LD A,B        ;
 $6606 OR (HL)       ;
 $6607 JP M,$6587    ; }

; Set a king's edge-distance bits
;
; B = king square, A = its value byte; continues in #R$8203, which stores in
; bits 6-7 the number of rings (0-3) between the king and the edge of the
; board.
@label=KingEdgeDistance
c$660A LD B,(HL)     ;
 $660B INC L         ;
 $660C LD A,(HL)     ;
 $660D JP $8203      ;

; Assign one set-up piece to a slot
;
; A = set-up code (slot offset | 3 | $80 for White, or slot offset | 1 for an
; untouched initial-position piece), E = square. Rules (B = value byte, C =
; byte +6):
; .
; Pawn: illegal on rank 1 or 8; B=1, C=$80 (White) / $C0 (Black); first free
; pawn slot. King: B=0, or $30 (moved) if entered; C=1; king slot only (a
; second king is illegal). Queen: B=9, C=$0E; queen slot, then pawn slots.
; Rook: B=5, or $15 (moved) if entered; C=8; two rook slots, then pawn slots.
; Bishop: B=$83, C=4; two bishop slots, then pawn slots. Knight: B=3, C=0; two
; knight slots, then pawn slots. No free slot: illegal.
@label=AssignSlot
c$6610 LD L,A        ; {L = set-up code - 1 (bit 1 set = entered by the user)
 $6611 DEC L         ;
 $6612 BIT 6,L       ;
 $6614 JR Z,$662B    ; }
 $6616 LD A,$70      ; {Pawn: rank 8 or rank 1 is illegal
 $6618 AND E         ;
 $6619 JR Z,$6674    ;
 $661B CP $70        ;
 $661D JR Z,$6674    ; }
 $661F LD B,$01      ; {B = 1, C = $80 for White, $C0 for Black; try the pawn
 $6621 LD A,$80      ; slots
 $6623 AND L         ;
 $6624 XOR $80       ;
 $6626 SCF           ;
 $6627 RRA           ;
 $6628 LD C,A        ;
 $6629 JR $666D      ; }
*$662B LD A,$78      ; {King: B = 0 (untouched) or $30 (entered), C = 1; only
 $662D AND L         ; the king slot
 $662E JR NZ,$663F   ;
 $6630 LD C,$01      ;
 $6632 LD B,$00      ;
 $6634 BIT 1,L       ;
 $6636 JR Z,$663A    ;
 $6638 LD B,$30      ;
*$663A CALL $6678    ;
 $663D JR $6674      ; }
*$663F CP $10        ; {Queen: B = 9, C = $0E; queen slot then pawn slots
 $6641 LD C,$0E      ;
 $6643 LD B,$09      ;
 $6645 JR C,$6664    ;
 $6647 JR NZ,$6655   ; }
 $6649 LD C,$08      ; {Rook: B = 5 (untouched) or $15 (entered), C = 8
 $664B LD B,$05      ;
 $664D BIT 1,L       ;
 $664F JR Z,$6661    ;
 $6651 LD B,$15      ;
 $6653 JR $6661      ; }
*$6655 LD B,$03      ; {Knight: B = 3, C = 0; bishop: B = $83, C = 4
 $6657 LD C,$00      ;
 $6659 CP $20        ;
 $665B JR NZ,$6661   ;
 $665D LD B,$83      ;
 $665F LD C,$04      ; }
*$6661 CALL $6678    ; Two slots of the piece's own type
*$6664 CALL $6678    ; The piece's own (first or only) slot
 $6667 LD A,$82      ; {Then the pawn slots
 $6669 AND L         ;
 $666A SET 6,A       ;
 $666C LD L,A        ;
*$666D CALL $6678    ;
 $6670 BIT 6,L       ;
 $6672 JR NZ,$666D   ; }
@label=AssignSlotFail
*$6674 POP HL        ; {No slot: ILLEGAL
 $6675 JP $6587      ; }

; Try one piece-list slot
;
; If the slot at L (bit 1 cleared) is free (square bit 7 set), stores the
; square E, the board code (slot | 4) at (DE), the value byte B at +1 and C at
; +6, then returns directly to the caller's caller. Otherwise moves L to the
; next slot and returns.
@label=TryPieceSlot
c$6678 RES 1,L       ;
 $667A LD A,(HL)     ;
 $667B RLA           ;
 $667C JR C,$6683    ;
 $667E LD A,$08      ;
 $6680 ADD A,L       ;
 $6681 LD L,A        ;
 $6682 RET           ;
*$6683 LD (HL),E     ;
 $6684 LD A,L        ;
 $6685 SET 2,A       ;
 $6687 LD (DE),A     ;
 $6688 INC L         ;
 $6689 LD (HL),B     ;
 $668A SET 2,L       ;
 $668C INC L         ;
 $668D LD (HL),C     ;
 $668E POP BC        ;
 $668F RET           ;

; Replay one ply from the game record
;
; Used by take-back, take-forward, next-best and R (replay). Stops when the ply
; count $C001 reaches the target in HL. Otherwise regenerates the moves, picks
; the recorded index, makes the move (with the recorded promotion piece and
; check flag) and continues through the common after-move code (#R$636E). The
; evaluation (#R$8400) is not called for replayed moves.
@label=ReplayStep
c$6690 LD BC,($C001)  ; {Reached the target ply: stop
 $6694 XOR A          ;
 $6695 SBC HL,BC      ;
 $6697 JP Z,$671F     ; }
 $669A LD ($BCCF),HL  ; $BCCF = plies still to replay
 $669D LD HL,($C001)  ; {Next record byte: bit 7 = check, bits 0-6 = move index
 $66A0 INC HL         ;
 $66A1 LD ($C001),HL  ;
 $66A4 LD BC,$C057    ;
 $66A7 ADD HL,BC      ;
 $66A8 LD C,(HL)      ;
 $66A9 LD A,C         ;
 $66AA RES 7,C        ;
 $66AC LD B,$00       ;
 $66AE LD HL,$B404    ;
 $66B1 ADD HL,BC      ;
 $66B2 ADD HL,BC      ;
 $66B3 ADD HL,BC      ;
 $66B4 ADD HL,BC      ; }
 $66B5 PUSH AF        ; {Regenerate the moves for this position
 $66B6 PUSH HL        ;
 $66B7 LD IX,$BD58    ;
 $66BB CALL $78CE     ;
 $66BE POP IX         ;
 $66C0 POP AF         ; }
 $66C1 INC (IX+$00)   ; {Score byte $FF -> 0; restore the check flag from the
 $66C4 RLA            ; record
 $66C5 JR NC,$66CB    ;
 $66C7 SET 7,(IX+$03) ; }
*$66CB LD A,($BCC3)   ; {Replay mode: highlight the from-square
 $66CE OR A           ;
 $66CF CALL NZ,$70BF  ; }
 $66D2 CALL $810F     ; {Make the move
 $66D5 XOR A          ;
 $66D6 LD ($BCDE),A   ; }
 $66D9 POP AF         ; {Promotion: take the next piece from the promotion list
 $66DA PUSH AF        ; and store it as the piece's value byte
 $66DB JP PO,$66F4    ;
 $66DE LD HL,$C047    ;
 $66E1 INC (HL)       ;
 $66E2 LD A,(HL)      ;
 $66E3 ADD A,L        ;
 $66E4 LD L,A         ;
 $66E5 LD A,(HL)      ;
 $66E6 LD L,(IX+$02)  ;
 $66E9 LD H,$BD       ;
 $66EB LD L,(HL)      ;
 $66EC RES 2,L        ;
 $66EE INC L          ;
 $66EF INC H          ;
 $66F0 LD (HL),A      ;
 $66F1 LD ($BCDE),A   ; }
*$66F4 LD A,($BCC3)   ; {Replay mode: show (and, when printing the record,
 $66F7 OR A           ; print) every move
 $66F8 JR Z,$6709     ;
 $66FA CALL $746E     ;
 $66FD CALL $70C7     ;
 $6700 LD A,($BCDB)   ;
 $6703 OR A           ;
 $6704 CALL NZ,$7452  ;
 $6707 JR $6715       ; }
*$6709 LD HL,($BCCF)  ; {Otherwise show only the last two replayed moves
 $670C XOR A          ;
 $670D LD BC,$0003    ;
 $6710 SBC HL,BC      ;
 $6712 CALL C,$746E   ; }
*$6715 LD A,($BCDD)   ; {Unless next-best is in progress, clear the root
 $6718 OR A           ; exclusion list; then the common after-move code appends
 $6719 CALL Z,$6FAA   ; this move to it
 $671C JP $636E       ; }
; This entry point is used by the routine at #R$60B7.
@label=ReplayEnd
*$671F LD HL,$0000    ; {Clear the replay target and replay mode; the human
 $6722 LD ($C003),HL  ; plays the side to move ($BCBE = side to move bit)
 $6725 XOR A          ;
 $6726 LD ($BCC3),A   ;
 $6729 LD A,($BD2D)   ;
 $672C AND $01        ;
 $672E LD ($BCBE),A   ;
 $6731 JP $60B7       ; }

; Poll the keyboard
;
; Reads all eight half-rows at once. Returns Z if no key is pressed. If any key
; is pressed shows *INTERRUPTED*, buzzes and returns NZ (A=1). This is the only
; keyboard test made while thinking: the search calls it at every node via
; #R$78BA until the abort flag (bit 7 of $BD4C) is set, and once more after the
; opening book probe (#R$7C23).
@label=PollKeyboard
c$6734 XOR A                 ;
 $6735 IN A,($FE)            ;
 $6737 AND $1F               ;
 $6739 CP $1F                ;
 $673B RET Z                 ;
 $673C CALL $73F7            ;
 $673F DEFM "**INTERRUPTED*" ;
 $674D DEFB $AA              ; Last character (bit 7 set)
 $674E CALL $6FB0            ;
 $6751 DEFB $C8,$50          ; Inline arguments: duration, pitch
 $6753 CALL $703F            ;
 $6756 LD A,$01              ;
 $6758 OR A                  ;
 $6759 RET                   ;

; Wait for a key
;
; Enables interrupts so that the ROM keyboard scan runs, incrementing the
; random accumulator $BCCE in the waiting loop, and returns the key code (bit 5
; cleared, i.e. upper case) in A and $BCC0, with a click. Interrupts are
; disabled again on return; they are enabled nowhere else, so there is no
; real-time clock while thinking.
@label=WaitKey
c$675A LD IY,($BCC8) ; {Restore IY for the ROM interrupt routine
 $675E EI            ; }
*$675F LD HL,$BCCE   ; {Spin, counting in $BCCE, until FLAGS bit 5 (new key)
 $6762 INC (HL)      ;
 $6763 LD HL,$5C3B   ;
 $6766 BIT 5,(HL)    ;
 $6768 JR Z,$675F    ; }
 $676A DI            ; {Take LAST_K, force upper case
 $676B LD A,($5C08)  ;
 $676E RES 5,(HL)    ;
 $6770 AND $DF       ;
 $6772 LD ($BCC0),A  ;
 $6775 CALL $6FB0    ; }
 $6778 DEFB $02,$04  ; Inline arguments: duration, pitch
 $677A LD A,($BCC0)  ;
 $677D RET           ;

; Read a command key
;
; Waits for a key. S toggles the sound and O the board orientation (both
; handled here, then waits again). While the cursor is shown ($BCCA <> $FF) the
; keys 5-8 move it (wrapping within the rank or file; directions follow the
; orientation) and are also handled here. Any other key is returned in A.
@label=GetCommandKey
c$677E CALL $675A    ;
 $6781 CP $53        ;
 $6783 JR NZ,$6797   ;
 $6785 LD A,($BCD3)  ;
 $6788 XOR $01       ;
 $678A LD ($BCD3),A  ;
 $678D CALL $75B4    ;
 $6790 CALL $6FB0    ;
 $6793 DEFB $08,$14  ; Inline arguments: duration, pitch
 $6795 JR $677E      ;
*$6797 CP $4F        ;
 $6799 JR NZ,$67A8   ;
 $679B LD A,($BCC7)  ;
 $679E XOR $01       ;
 $67A0 LD ($BCC7),A  ;
 $67A3 CALL $70E4    ;
 $67A6 JR $677E      ;
*$67A8 CP $19        ;
 $67AA RET NC        ;
 $67AB CP $15        ;
 $67AD RET C         ;
 $67AE LD B,A        ;
 $67AF LD A,($BCCA)  ;
 $67B2 INC A         ;
 $67B3 LD A,B        ;
 $67B4 RET Z         ;
 $67B5 LD A,($BCC7)  ;
 $67B8 OR A          ;
 $67B9 LD A,B        ;
 $67BA JR Z,$67BE    ;
 $67BC XOR $01       ;
*$67BE CP $16        ;
 $67C0 JR Z,$67E2    ;
 $67C2 CP $17        ;
 $67C4 JR Z,$67EF    ;
 $67C6 AND $03       ;
 $67C8 JR Z,$67D6    ;
 $67CA LD A,($BCCA)  ;
 $67CD DEC A         ;
 $67CE BIT 3,A       ;
 $67D0 JR Z,$67FA    ;
 $67D2 ADD A,$08     ;
 $67D4 JR $67FA      ;
*$67D6 LD A,($BCCA)  ;
 $67D9 INC A         ;
 $67DA BIT 3,A       ;
 $67DC JR Z,$67FA    ;
 $67DE SUB $08       ;
 $67E0 JR $67FA      ;
*$67E2 LD A,($BCCA)  ;
 $67E5 ADD A,$10     ;
 $67E7 BIT 7,A       ;
 $67E9 JR Z,$67FA    ;
 $67EB SUB $80       ;
 $67ED JR $67FA      ;
*$67EF LD A,($BCCA)  ;
 $67F2 SUB $10       ;
 $67F4 BIT 7,A       ;
 $67F6 JR Z,$67FA    ;
 $67F8 ADD A,$80     ;
*$67FA CALL $70E1    ;
 $67FD JP $677E      ;

; Read a key and execute a command
;
; Commands D (demo), E (enter both sides) and M (move) are only accepted while
; the game is not over ($BCBF = 0). A, B, C, F, G, L, N, P, R and T jump to
; their handlers; any other key (including ENTER) is returned in A.
@label=CommandDispatch
c$6800 CALL $677E    ;
 $6803 LD A,($BCBF)  ;
 $6806 OR A          ;
 $6807 LD A,($BCC0)  ;
 $680A JP NZ,$681A   ;
 $680D CP $44        ;
 $680F JR Z,$684D    ;
 $6811 CP $45        ;
 $6813 JR Z,$6858    ;
 $6815 CP $4D        ;
